<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane fx:id="pageScrollPane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="easv.gui.controller.Admin.ProfilesController"
            fitToWidth="true"
            fitToHeight="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            minWidth="0"
            minHeight="0"
            maxWidth="Infinity"
            maxHeight="Infinity"
            styleClass="admin-page-scroll">

    <content>
        <VBox fx:id="pageRoot"
              spacing="18"
              fillWidth="true"
              minWidth="0"
              minHeight="0"
              maxWidth="Infinity"
              maxHeight="Infinity"
              styleClass="admin-page main-content">

            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <HBox alignment="CENTER_LEFT"
                  maxWidth="Infinity"
                  styleClass="page-header">

                <VBox spacing="3" styleClass="page-heading-copy">
                    <Label text="Profiles" styleClass="page-title"/>
                    <Label text="Create and manage scanning workflow profiles"
                           styleClass="page-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="+ Create Profile"
                        styleClass="create-user-button"
                        focusTraversable="false"/>
            </HBox>

            <HBox spacing="12"
                  alignment="CENTER_LEFT"
                  maxWidth="Infinity"
                  styleClass="profiles-toolbar">

                <HBox styleClass="search-field-shell"
                      maxWidth="Infinity"
                      HBox.hgrow="ALWAYS">

                    <StackPane styleClass="field-icon-shell">
                        <SVGPath content="M15.78 14.36h-.75l-.26-.25a6.64 6.64 0 1 0-.66.66l.25.26v.75l4.72 4.71 1.41-1.41-4.71-4.72zM9.5 14A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14z"
                                 styleClass="field-icon-path"/>
                    </StackPane>

                    <TextField fx:id="searchField"
                               promptText="Search profiles..."
                               styleClass="search-field-input"
                               maxWidth="Infinity"
                               HBox.hgrow="ALWAYS"/>
                </HBox>

                <ComboBox fx:id="statusFilterComboBox"
                          styleClass="role-filter"/>

                <ComboBox fx:id="metadataFilterComboBox"
                          styleClass="role-filter"/>
            </HBox>

            <HBox alignment="CENTER_LEFT"
                  maxWidth="Infinity"
                  visible="false"
                  managed="false">
                <Label fx:id="profilesCountLabel" styleClass="page-subtitle"/>
            </HBox>

            <GridPane fx:id="profilesCardsGrid"
                      hgap="18"
                      vgap="18"
                      minWidth="0"
                      maxWidth="Infinity"
                      styleClass="profiles-cards-container"/>

            <VBox fx:id="emptyStateBox"
                  spacing="6"
                  visible="false"
                  managed="false"
                  maxWidth="Infinity"
                  styleClass="empty-state-box">

                <Label text="No profiles found" styleClass="empty-state-title"/>
                <Label text="Try a different search, status, or metadata template filter."
                       styleClass="empty-state-copy"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>