<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="easv.gui.controller.admin.ManageUsersController"
      spacing="18"
      fillWidth="true"
      maxWidth="Infinity"
      maxHeight="Infinity"
      styleClass="main-content">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <VBox fx:id="overviewPane"
          spacing="18"
          fillWidth="true"
          maxWidth="Infinity"
          maxHeight="Infinity"
          VBox.vgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT"
              maxWidth="Infinity"
              styleClass="page-header">

            <VBox spacing="3" styleClass="page-heading-copy">
                <Label text="Users" styleClass="page-title"/>
                <Label fx:id="usersCountLabel" styleClass="page-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="+ Create User"
                    onAction="#showCreateUserEditor"
                    styleClass="create-user-button"
                    focusTraversable="false"/>
        </HBox>

        <Label fx:id="userActionMessageLabel"
               text=""
               visible="false"
               managed="false"
               styleClass="create-user-generated-note"/>

        <BorderPane fx:id="usersPanel"
                    styleClass="users-panel"
                    maxWidth="Infinity"
                    maxHeight="Infinity"
                    VBox.vgrow="ALWAYS">

        <top>
            <VBox fx:id="usersPanelTop"
                  fillWidth="true"
                  maxWidth="Infinity">

                <HBox spacing="12"
                      alignment="CENTER_LEFT"
                      maxWidth="Infinity"
                      styleClass="users-toolbar">

                    <HBox styleClass="search-field-shell"
                          maxWidth="Infinity"
                          HBox.hgrow="ALWAYS">

                        <StackPane styleClass="field-icon-shell">
                            <SVGPath content="M15.78 14.36h-.75l-.26-.25a6.64 6.64 0 1 0-.66.66l.25.26v.75l4.72 4.71 1.41-1.41-4.71-4.72zM9.5 14A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14z"
                                     styleClass="field-icon-path"/>
                        </StackPane>

                        <TextField fx:id="searchField"
                                   promptText="Search name, username, email, role, or assigned profiles..."
                                   styleClass="search-field-input"
                                   maxWidth="Infinity"
                                   HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <ComboBox fx:id="roleFilterComboBox"
                              styleClass="role-filter"/>
                </HBox>

                <GridPane styleClass="users-list-header"
                          maxWidth="Infinity">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="20"/>
                        <ColumnConstraints percentWidth="15"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="10"/>
                        <ColumnConstraints percentWidth="15"/>
                        <ColumnConstraints percentWidth="15"/>
                    </columnConstraints>

                    <Label text="Name"
                           styleClass="list-header-label"
                           GridPane.columnIndex="0"
                           GridPane.halignment="LEFT"/>

                    <Label text="Username"
                           styleClass="list-header-label"
                           GridPane.columnIndex="1"
                           GridPane.halignment="CENTER"/>

                    <Label text="Email"
                           styleClass="list-header-label"
                           GridPane.columnIndex="2"
                           GridPane.halignment="CENTER"/>

                    <Label text="Role"
                           styleClass="list-header-label"
                           GridPane.columnIndex="3"
                           GridPane.halignment="CENTER"/>

                    <Label text="Profiles"
                           styleClass="list-header-label"
                           GridPane.columnIndex="4"
                           GridPane.halignment="CENTER"/>

                    <Label text="Actions"
                           styleClass="list-header-label"
                           GridPane.columnIndex="5"
                           GridPane.halignment="CENTER"/>
                </GridPane>
            </VBox>
        </top>

        <center>
            <ScrollPane fitToWidth="true"
                        fitToHeight="false"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        maxWidth="Infinity"
                        maxHeight="Infinity"
                        styleClass="users-body-scroll-pane">

                <content>
                    <VBox fx:id="usersPanelBody"
                          fillWidth="true"
                          maxWidth="Infinity"
                          styleClass="users-panel-body">

                        <VBox fx:id="userListContainer"
                              fillWidth="true"
                              maxWidth="Infinity"
                              styleClass="users-list"/>

                        <VBox fx:id="emptyStateBox"
                              spacing="6"
                              visible="false"
                              managed="false"
                              maxWidth="Infinity"
                              styleClass="empty-state-box">

                            <Label text="No users found" styleClass="empty-state-title"/>
                            <Label text="Try a different search or role filter." styleClass="empty-state-copy"/>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
        </center>

        <bottom>
            <HBox fx:id="paginationBar"
                  alignment="CENTER"
                  spacing="12"
                  visible="false"
                  managed="false"
                  maxWidth="Infinity"
                  styleClass="pagination-bar">

                <Label fx:id="paginationSummaryLabel"
                       text="Showing 0 users"
                       styleClass="pagination-summary-label"/>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox fx:id="paginationButtonsBox"
                      alignment="CENTER"
                      spacing="6"
                      styleClass="pagination-buttons-box"/>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER_RIGHT"
                      spacing="9"
                      styleClass="rows-per-page-box">

                    <Label text="Rows per page"
                           styleClass="rows-per-page-label"/>

                    <ComboBox fx:id="rowsPerPageComboBox"
                              styleClass="rows-per-page-filter"/>
                </HBox>
            </HBox>
        </bottom>
        </BorderPane>
    </VBox>

    <ScrollPane fx:id="userEditorPane"
                fitToWidth="true"
                fitToHeight="false"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                visible="false"
                managed="false"
                maxWidth="Infinity"
                maxHeight="Infinity"
                styleClass="admin-page-scroll"
                VBox.vgrow="ALWAYS">

        <content>
            <VBox spacing="18"
                  fillWidth="true"
                  maxWidth="Infinity"
                  styleClass="profile-editor-page">

                <HBox alignment="CENTER_LEFT"
                      maxWidth="Infinity"
                      styleClass="profile-editor-header">

                    <VBox spacing="6">
                        <Button text="&lt; Back to Users"
                                onAction="#showOverview"
                                styleClass="profile-editor-back-button"
                                focusTraversable="false"/>

                        <Label fx:id="userEditorTitleLabel"
                               text="Create User"
                               styleClass="page-title"/>

                        <Label fx:id="userEditorSubtitleLabel"
                               text="Add a new user and choose what they can access."
                               styleClass="page-subtitle"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox alignment="CENTER_RIGHT"
                          spacing="12"
                          styleClass="profile-editor-header-actions">

                        <Button text="Cancel"
                                onAction="#showOverview"
                                styleClass="profile-editor-secondary-button"
                                focusTraversable="false"/>

                        <Button fx:id="saveUserButton"
                                text="Create User"
                                onAction="#saveUser"
                                styleClass="profile-editor-primary-button"
                                focusTraversable="false"/>
                    </HBox>
                </HBox>

                <VBox spacing="18"
                      maxWidth="Infinity"
                      styleClass="profile-editor-content">

                    <VBox spacing="18"
                          maxWidth="Infinity"
                          styleClass="profile-editor-card create-user-editor">

                        <VBox spacing="12" styleClass="create-user-section">
                            <Label text="User Details" styleClass="create-user-section-title"/>

                            <GridPane hgap="12"
                                      vgap="12"
                                      maxWidth="Infinity"
                                      styleClass="create-user-details-grid">

                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                                </columnConstraints>

                                <VBox spacing="6" styleClass="create-user-field" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Full Name *" styleClass="create-user-field-label"/>
                                    <TextField fx:id="fullNameField"
                                               promptText="Sarah Smith"
                                               maxWidth="Infinity"
                                               styleClass="create-user-input"/>
                                </VBox>

                                <VBox spacing="6" styleClass="create-user-field" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Username *" styleClass="create-user-field-label"/>
                                    <TextField fx:id="usernameField"
                                               promptText="sarah"
                                               maxWidth="Infinity"
                                               styleClass="create-user-input"/>
                                </VBox>

                                <VBox spacing="6" styleClass="create-user-field" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label text="Email" styleClass="create-user-field-label"/>
                                    <TextField fx:id="emailField"
                                               promptText="sarah@example.com"
                                               maxWidth="Infinity"
                                               styleClass="create-user-input"/>
                                </VBox>

                                <VBox spacing="6" styleClass="create-user-field" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label text="Role *" styleClass="create-user-field-label"/>
                                    <ComboBox fx:id="userRoleComboBox"
                                              maxWidth="Infinity"
                                              styleClass="create-user-input"/>
                                </VBox>

                                <VBox spacing="6" styleClass="create-user-field" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label fx:id="temporaryPasswordLabel"
                                           text="Temporary Password *"
                                           styleClass="create-user-field-label"/>

                                    <HBox spacing="9" alignment="CENTER_LEFT">
                                        <TextField fx:id="temporaryPasswordField"
                                                   promptText="Temporary password"
                                                   maxWidth="Infinity"
                                                   HBox.hgrow="ALWAYS"
                                                   styleClass="create-user-input"/>

                                        <Button text="Generate"
                                                onAction="#generateTemporaryPassword"
                                                styleClass="metadata-secondary-header-button"
                                                focusTraversable="false"/>
                                    </HBox>
                                </VBox>

                                <VBox spacing="6" styleClass="create-user-field" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <Label text="Status" styleClass="create-user-field-label"/>
                                    <ComboBox fx:id="userStatusComboBox"
                                              maxWidth="Infinity"
                                              styleClass="create-user-input"/>
                                </VBox>
                            </GridPane>

                            <Label fx:id="generatedPasswordNoticeLabel"
                                   text="Temporary password generated. Copy it before leaving this page."
                                   visible="false"
                                   managed="false"
                                   wrapText="true"
                                   styleClass="create-user-generated-note"/>
                        </VBox>

                        <VBox spacing="12" styleClass="create-user-section">
                            <Label text="Profile Access" styleClass="create-user-section-title"/>

                            <Label fx:id="profileHelpLabel"
                                   text="Choose which scan profiles this user can access."
                                   wrapText="true"
                                   styleClass="create-user-section-copy"/>

                            <Button fx:id="showProfileAccessButton"
                                    text="Show profile access"
                                    onAction="#showProfileAccessForAdmin"
                                    visible="false"
                                    managed="false"
                                    styleClass="metadata-action-button"
                                    focusTraversable="false"/>

                            <VBox fx:id="profileAccessContent"
                                  spacing="12"
                                  maxWidth="Infinity"
                                  styleClass="create-user-profile-content">

                                <TextField fx:id="profileSearchField"
                                           promptText="Search profiles..."
                                           maxWidth="Infinity"
                                           styleClass="create-user-input"/>

                                <VBox fx:id="profileListBox"
                                      maxWidth="Infinity"
                                      styleClass="create-user-profile-list"/>
                            </VBox>

                            <Label fx:id="noProfilesWarningLabel"
                                   text="This user has no assigned profiles and will not be able to start scans."
                                   visible="false"
                                   managed="false"
                                   wrapText="true"
                                   styleClass="create-user-warning-message"/>
                        </VBox>

                        <Label fx:id="validationLabel"
                               text=""
                               visible="false"
                               managed="false"
                               wrapText="true"
                               styleClass="create-user-validation-message"/>
                    </VBox>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
