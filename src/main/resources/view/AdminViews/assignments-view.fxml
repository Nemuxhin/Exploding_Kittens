<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="easv.gui.controller.admin.AssignmentsController"
            fitToWidth="true"
            fitToHeight="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            minWidth="0"
            minHeight="0"
            maxWidth="Infinity"
            maxHeight="Infinity"
            styleClass="admin-page-scroll">

    <content>
        <VBox spacing="30"
              fillWidth="true"
              minWidth="0"
              minHeight="0"
              maxWidth="Infinity"
              maxHeight="Infinity"
              styleClass="admin-page main-content assignments-page">

            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <VBox spacing="18" maxWidth="Infinity">
                <VBox spacing="3" styleClass="page-heading-copy">
                    <Label text="Profile Access Control" styleClass="page-title"/>
                    <Label text="Assign scanning profiles to users" styleClass="page-subtitle"/>
                </VBox>

                <HBox alignment="CENTER_LEFT">
                    <HBox alignment="CENTER_LEFT" styleClass="assignment-mode-switch">
                        <Button fx:id="byProfileButton"
                                text="By Profile"
                                onAction="#selectByProfileMode"
                                styleClass="assignment-mode-button"
                                focusTraversable="false"/>

                        <Button fx:id="byUserButton"
                                text="By User"
                                onAction="#selectByUserMode"
                                styleClass="assignment-mode-button"
                                focusTraversable="false"/>
                    </HBox>
                </HBox>
            </VBox>

            <HBox spacing="18"
                  alignment="TOP_LEFT"
                  maxWidth="Infinity"
                  VBox.vgrow="ALWAYS"
                  styleClass="assignment-panels">

                <VBox spacing="0"
                      minWidth="390"
                      prefWidth="540"
                      maxWidth="Infinity"
                      maxHeight="Infinity"
                      HBox.hgrow="ALWAYS"
                      styleClass="assignment-panel assignment-list-panel">

                    <VBox spacing="15" styleClass="assignment-panel-header">
                        <Label fx:id="leftPanelTitleLabel"
                               text="Profiles"
                               styleClass="assignment-panel-title"/>

                        <HBox spacing="12"
                              alignment="CENTER_LEFT"
                              maxWidth="Infinity">

                            <HBox styleClass="search-field-shell"
                                  maxWidth="Infinity"
                                  HBox.hgrow="ALWAYS">

                                <StackPane styleClass="field-icon-shell">
                                    <Label text="&#xe908;" styleClass="prime-icon field-icon-path"/>
                                </StackPane>

                                <TextField fx:id="leftSearchField"
                                           promptText="Search profiles..."
                                           styleClass="search-field-input"
                                           maxWidth="Infinity"
                                           HBox.hgrow="ALWAYS"/>
                            </HBox>

                            <ComboBox fx:id="leftFilterComboBox"
                                      styleClass="role-filter"/>
                        </HBox>
                    </VBox>

                    <ScrollPane fx:id="leftListScrollPane"
                                fitToWidth="true"
                                hbarPolicy="NEVER"
                                vbarPolicy="AS_NEEDED"
                                maxWidth="Infinity"
                                maxHeight="Infinity"
                                VBox.vgrow="ALWAYS"
                                styleClass="assignment-list-scroll">

                        <content>
                            <VBox fx:id="leftListContainer"
                                  spacing="0"
                                  fillWidth="true"
                                  maxWidth="Infinity"
                                  styleClass="assignment-list"/>
                        </content>
                    </ScrollPane>
                </VBox>

                <BorderPane minWidth="480"
                            prefWidth="540"
                            maxWidth="Infinity"
                            maxHeight="Infinity"
                            HBox.hgrow="ALWAYS"
                            styleClass="assignment-panel assignment-editor-panel">

                    <top>
                        <VBox spacing="15" styleClass="assignment-editor-top">

                            <HBox alignment="CENTER_LEFT" spacing="9">
                                <Label fx:id="selectedTitleLabel"
                                       text="Building Archive"
                                       styleClass="assignment-selected-title"/>

                                <Label fx:id="selectedStatusBadge"
                                       text="Active"
                                       styleClass="metadata-status-badge metadata-status-active"/>
                            </HBox>

                            <Label fx:id="selectedSubtitleLabel"
                                   text="Used for municipal building archive scans."
                                   wrapText="true"
                                   styleClass="assignment-selected-subtitle"/>

                            <Label fx:id="selectedCodeLabel"
                                   text="BuildingArchive_{boxId}"
                                   styleClass="assignment-code-label"/>

                            <Region styleClass="assignment-divider"/>
                        </VBox>
                    </top>

                    <center>
                        <VBox spacing="15"
                              maxWidth="Infinity"
                              maxHeight="Infinity"
                              styleClass="assignment-editor-body">

                            <Label fx:id="rightPanelTitleLabel"
                                   text="Assigned Users"
                                   styleClass="assignment-panel-title"/>

                            <HBox spacing="12"
                                  alignment="CENTER_LEFT"
                                  maxWidth="Infinity">

                                <HBox styleClass="search-field-shell"
                                      maxWidth="Infinity"
                                      HBox.hgrow="ALWAYS">

                                    <StackPane styleClass="field-icon-shell">
                                        <Label text="&#xe908;" styleClass="prime-icon field-icon-path"/>
                                    </StackPane>

                                    <TextField fx:id="rightSearchField"
                                               promptText="Search users..."
                                               styleClass="search-field-input"
                                               maxWidth="Infinity"
                                               HBox.hgrow="ALWAYS"/>
                                </HBox>

                                <ComboBox fx:id="rightFilterComboBox"
                                          styleClass="role-filter"/>
                            </HBox>

                            <ScrollPane fx:id="assignmentRowsScrollPane"
                                        fitToWidth="true"
                                        hbarPolicy="NEVER"
                                        vbarPolicy="AS_NEEDED"
                                        maxWidth="Infinity"
                                        maxHeight="Infinity"
                                        VBox.vgrow="ALWAYS"
                                        styleClass="assignment-list-scroll">

                                <content>
                                    <VBox fx:id="assignmentRowsContainer"
                                          spacing="0"
                                          fillWidth="true"
                                          maxWidth="Infinity"
                                          styleClass="assignment-checkbox-list"/>
                                </content>
                            </ScrollPane>
                        </VBox>
                    </center>

                    <bottom>
                        <HBox alignment="CENTER_RIGHT"
                              spacing="12"
                              styleClass="assignment-save-bar">

                            <Label fx:id="changesLabel"
                                   text="No unsaved changes"
                                   styleClass="assignment-save-status"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button text="Cancel"
                                    onAction="#cancelChanges"
                                    styleClass="profile-secondary-button"
                                    focusTraversable="false"/>

                            <Button text="Save Changes"
                                    onAction="#saveChanges"
                                    styleClass="create-user-button"
                                    focusTraversable="false"/>
                        </HBox>
                    </bottom>
                </BorderPane>
            </HBox>
        </VBox>
    </content>
</ScrollPane>