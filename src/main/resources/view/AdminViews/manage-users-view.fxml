<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="easv.gui.controller.admin.ManageUsersController"
      spacing="18"
      fillWidth="true"
      maxWidth="Infinity"
      maxHeight="Infinity"
      styleClass="main-content">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <HBox alignment="CENTER_LEFT"
          maxWidth="Infinity"
          styleClass="page-header">

        <VBox spacing="3" styleClass="page-heading-copy">
            <Label text="Users" styleClass="page-title"/>
            <Label fx:id="usersCountLabel" styleClass="page-subtitle"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="+ Create User"
                onAction="#openCreateUserDialog"
                styleClass="create-user-button"
                focusTraversable="false"/>
    </HBox>

    <BorderPane fx:id="usersPanel"
                styleClass="users-panel"
                maxWidth="Infinity"
                maxHeight="Infinity"
                VBox.vgrow="ALWAYS">

        <top>
            <VBox fx:id="usersPanelTop"
                  fillWidth="true"
                  maxWidth="Infinity">

                <HBox spacing="12"
                      alignment="CENTER_LEFT"
                      maxWidth="Infinity"
                      styleClass="users-toolbar">

                    <HBox styleClass="search-field-shell"
                          maxWidth="Infinity"
                          HBox.hgrow="ALWAYS">

                        <StackPane styleClass="field-icon-shell">
                            <SVGPath content="M15.78 14.36h-.75l-.26-.25a6.64 6.64 0 1 0-.66.66l.25.26v.75l4.72 4.71 1.41-1.41-4.71-4.72zM9.5 14A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14z"
                                     styleClass="field-icon-path"/>
                        </StackPane>

                        <TextField fx:id="searchField"
                                   promptText="Search name, username, email, role, or assigned profiles..."
                                   styleClass="search-field-input"
                                   maxWidth="Infinity"
                                   HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <ComboBox fx:id="roleFilterComboBox"
                              styleClass="role-filter"/>
                </HBox>

                <GridPane styleClass="users-list-header"
                          maxWidth="Infinity">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="20"/>
                        <ColumnConstraints percentWidth="15"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="10"/>
                        <ColumnConstraints percentWidth="15"/>
                        <ColumnConstraints percentWidth="15"/>
                    </columnConstraints>

                    <Label text="Name"
                           styleClass="list-header-label"
                           GridPane.columnIndex="0"
                           GridPane.halignment="LEFT"/>

                    <Label text="Username"
                           styleClass="list-header-label"
                           GridPane.columnIndex="1"
                           GridPane.halignment="CENTER"/>

                    <Label text="Email"
                           styleClass="list-header-label"
                           GridPane.columnIndex="2"
                           GridPane.halignment="CENTER"/>

                    <Label text="Role"
                           styleClass="list-header-label"
                           GridPane.columnIndex="3"
                           GridPane.halignment="CENTER"/>

                    <Label text="Profiles"
                           styleClass="list-header-label"
                           GridPane.columnIndex="4"
                           GridPane.halignment="CENTER"/>

                    <Label text="Actions"
                           styleClass="list-header-label"
                           GridPane.columnIndex="5"
                           GridPane.halignment="CENTER"/>
                </GridPane>
            </VBox>
        </top>

        <center>
            <ScrollPane fitToWidth="true"
                        fitToHeight="false"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        maxWidth="Infinity"
                        maxHeight="Infinity"
                        styleClass="users-body-scroll-pane">

                <content>
                    <VBox fx:id="usersPanelBody"
                          fillWidth="true"
                          maxWidth="Infinity"
                          styleClass="users-panel-body">

                        <VBox fx:id="userListContainer"
                              fillWidth="true"
                              maxWidth="Infinity"
                              styleClass="users-list"/>

                        <VBox fx:id="emptyStateBox"
                              spacing="6"
                              visible="false"
                              managed="false"
                              maxWidth="Infinity"
                              styleClass="empty-state-box">

                            <Label text="No users found" styleClass="empty-state-title"/>
                            <Label text="Try a different search or role filter." styleClass="empty-state-copy"/>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
        </center>

        <bottom>
            <HBox fx:id="paginationBar"
                  alignment="CENTER"
                  spacing="12"
                  visible="false"
                  managed="false"
                  maxWidth="Infinity"
                  styleClass="pagination-bar">

                <Label fx:id="paginationSummaryLabel"
                       text="Showing 0 users"
                       styleClass="pagination-summary-label"/>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox fx:id="paginationButtonsBox"
                      alignment="CENTER"
                      spacing="6"
                      styleClass="pagination-buttons-box"/>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER_RIGHT"
                      spacing="9"
                      styleClass="rows-per-page-box">

                    <Label text="Rows per page"
                           styleClass="rows-per-page-label"/>

                    <ComboBox fx:id="rowsPerPageComboBox"
                              styleClass="rows-per-page-filter"/>
                </HBox>
            </HBox>
        </bottom>
    </BorderPane>
</VBox>