<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane fx:id="appShell"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="easv.gui.controller.admin.AdminController"
           styleClass="app-shell"
           maxWidth="Infinity"
           maxHeight="Infinity">

    <BorderPane maxWidth="Infinity"
                maxHeight="Infinity">

        <top>
            <VBox styleClass="admin-shell-head">

                <HBox alignment="CENTER_LEFT"
                      spacing="18"
                      styleClass="admin-top-bar">

                    <HBox alignment="CENTER_LEFT"
                          spacing="12"
                          styleClass="admin-brand">
                        <StackPane fx:id="brandMark" styleClass="admin-brand-mark">
                            <SVGPath content="M4 4h8.8L20 11.2V20H4V4zm2 2v12h12v-5.8L11.8 6H6zm3 3h3v2H9V9zm0 4h6v2H9v-2z"
                                     styleClass="admin-brand-icon"/>
                        </StackPane>

                        <VBox spacing="2">
                            <StackPane alignment="CENTER_LEFT">
                                <Label fx:id="brandLogoFallbackLabel"
                                       text="WebLager"
                                       styleClass="admin-brand-title"/>

                                <ImageView fx:id="brandLogoImageView"
                                           fitWidth="150"
                                           fitHeight="30"
                                           preserveRatio="true"
                                           smooth="true"
                                           visible="false"
                                           managed="false"/>
                            </StackPane>
                        </VBox>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox alignment="CENTER"
                          spacing="8"
                          styleClass="admin-nav-bar">
                        <ToggleButton fx:id="dashboardNavItem"
                                      focusTraversable="false"
                                      contentDisplay="GRAPHIC_ONLY">
                            <styleClass>
                                <String fx:value="admin-top-nav-button"/>
                            </styleClass>
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="&#xe925;" styleClass="prime-icon admin-top-nav-icon"/>
                                    <Label text="Dashboard" styleClass="admin-top-nav-label"/>
                                </HBox>
                            </graphic>
                        </ToggleButton>

                        <ToggleButton fx:id="usersNavItem"
                                      focusTraversable="false"
                                      contentDisplay="GRAPHIC_ONLY">
                            <styleClass>
                                <String fx:value="admin-top-nav-button"/>
                            </styleClass>
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="&#xe941;" styleClass="prime-icon admin-top-nav-icon"/>
                                    <Label text="Users" styleClass="admin-top-nav-label"/>
                                </HBox>
                            </graphic>
                        </ToggleButton>

                        <ToggleButton fx:id="profilesNavItem"
                                      focusTraversable="false"
                                      contentDisplay="GRAPHIC_ONLY">
                            <styleClass>
                                <String fx:value="admin-top-nav-button"/>
                            </styleClass>
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="&#xe992;" styleClass="prime-icon admin-top-nav-icon"/>
                                    <Label text="Profiles" styleClass="admin-top-nav-label"/>
                                </HBox>
                            </graphic>
                        </ToggleButton>

                        <ToggleButton fx:id="assignmentsNavItem"
                                      focusTraversable="false"
                                      contentDisplay="GRAPHIC_ONLY">
                            <styleClass>
                                <String fx:value="admin-top-nav-button"/>
                            </styleClass>
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="&#xe93f;" styleClass="prime-icon admin-top-nav-icon"/>
                                    <Label text="Access" styleClass="admin-top-nav-label"/>
                                </HBox>
                            </graphic>
                        </ToggleButton>

                        <ToggleButton fx:id="reviewNavItem"
                                      focusTraversable="false"
                                      contentDisplay="GRAPHIC_ONLY">
                            <styleClass>
                                <String fx:value="admin-top-nav-button"/>
                            </styleClass>
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="&#xea1b;" styleClass="prime-icon admin-top-nav-icon"/>
                                    <Label text="Review" styleClass="admin-top-nav-label"/>
                                </HBox>
                            </graphic>
                        </ToggleButton>

                        <ToggleButton fx:id="exportsNavItem"
                                      focusTraversable="false"
                                      contentDisplay="GRAPHIC_ONLY">
                            <styleClass>
                                <String fx:value="admin-top-nav-button"/>
                            </styleClass>
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="&#xe956;" styleClass="prime-icon admin-top-nav-icon"/>
                                    <Label text="Exports" styleClass="admin-top-nav-label"/>
                                </HBox>
                            </graphic>
                        </ToggleButton>

                        <ToggleButton fx:id="activityNavItem"
                                      focusTraversable="false"
                                      contentDisplay="GRAPHIC_ONLY">
                            <styleClass>
                                <String fx:value="admin-top-nav-button"/>
                            </styleClass>
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="&#xea0c;" styleClass="prime-icon admin-top-nav-icon"/>
                                    <Label text="Activity" styleClass="admin-top-nav-label"/>
                                </HBox>
                            </graphic>
                        </ToggleButton>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox alignment="CENTER_RIGHT"
                          spacing="9"
                          styleClass="admin-account">

                        <Button fx:id="keyboardShortcutsButton"
                                focusTraversable="false"
                                contentDisplay="GRAPHIC_ONLY"
                                styleClass="admin-toolbar-button">
                            <graphic>
                                <StackPane styleClass="admin-toolbar-icon-shell">
                                    <Label text="&#xe981;" styleClass="prime-icon admin-toolbar-icon"/>
                                </StackPane>
                            </graphic>
                        </Button>

                        <Button focusTraversable="false"
                                contentDisplay="GRAPHIC_ONLY"
                                styleClass="admin-toolbar-button">
                            <graphic>
                                <StackPane styleClass="admin-toolbar-icon-shell">
                                    <Label text="&#xe97c;" styleClass="prime-icon admin-toolbar-icon"/>
                                    <Region styleClass="admin-notification-dot"
                                            StackPane.alignment="TOP_RIGHT"/>
                                </StackPane>
                            </graphic>
                        </Button>

                        <Button fx:id="accountMenuButton"
                                focusTraversable="false"
                                contentDisplay="GRAPHIC_ONLY"
                                styleClass="admin-account-menu-button">
                            <graphic>
                                <HBox alignment="CENTER_LEFT"
                                      spacing="9"
                                      styleClass="admin-account-menu-content">
                                    <StackPane styleClass="admin-avatar-shell">
                                        <Label fx:id="accountInitialsLabel"
                                               text="AD"
                                               styleClass="admin-avatar-label"/>
                                    </StackPane>

                                    <Label fx:id="accountNameLabel"
                                           text="Admin"
                                           styleClass="admin-account-name"/>

                                    <StackPane styleClass="admin-account-chevron-shell">
                                        <Label text="&#xe930;" styleClass="prime-icon admin-account-chevron"/>
                                    </StackPane>
                                </HBox>
                            </graphic>
                        </Button>
                    </HBox>
                </HBox>
            </VBox>
        </top>

        <center>
            <StackPane fx:id="contentHost"
                       minWidth="0"
                       minHeight="0"
                       maxWidth="Infinity"
                       maxHeight="Infinity"
                       styleClass="content-host"/>
        </center>
    </BorderPane>

    <VBox fx:id="accountDropdownPane"
          visible="false"
          maxWidth="270"
          styleClass="admin-account-dropdown"
          StackPane.alignment="TOP_RIGHT">
        <StackPane.margin>
            <Insets top="60" right="24"/>
        </StackPane.margin>

        <VBox spacing="3" styleClass="admin-account-dropdown-header">
            <Label fx:id="accountDropdownNameLabel"
                   text="System Admin"
                   styleClass="admin-account-menu-name"/>
            <Label fx:id="accountDropdownDetailLabel"
                   text="admin@example.com"
                   styleClass="admin-account-menu-detail"/>
        </VBox>

        <Region styleClass="admin-account-dropdown-divider"/>

        <Button fx:id="editProfileMenuButton"
                text="Edit Profile"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                styleClass="admin-account-dropdown-item"/>
        <Button fx:id="settingsPrivacyMenuButton"
                text="Settings and Privacy"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                styleClass="admin-account-dropdown-item"/>

        <Region styleClass="admin-account-dropdown-divider"/>

        <ToggleButton fx:id="darkModeToggleButton"
                      text="Light Mode"
                      maxWidth="Infinity"
                      contentDisplay="LEFT"
                      graphicTextGap="8"
                      focusTraversable="false"
                      styleClass="admin-account-theme-toggle">
            <graphic>
                <Label fx:id="darkModeToggleIcon"
                       text="&#xe9c8;"
                       styleClass="prime-icon admin-account-theme-icon"/>
            </graphic>
        </ToggleButton>

        <Region styleClass="admin-account-dropdown-divider"/>

        <Button fx:id="logoutMenuButton"
                text="Log Out"
                maxWidth="Infinity"
                styleClass="admin-account-logout-button"/>
    </VBox>
</StackPane>
