<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="easv.gui.controller.admin.ReviewController"
            fx:id="reviewRootScrollPane"
            fitToWidth="true"
            fitToHeight="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            minWidth="0"
            minHeight="0"
            maxWidth="Infinity"
            maxHeight="Infinity"
            styleClass="admin-page-scroll">

    <content>
        <StackPane minWidth="0"
                   maxWidth="Infinity"
                   styleClass="review-page-host">

            <!-- =====================================================
                 OVERVIEW / WORK QUEUE
                 ===================================================== -->

            <VBox fx:id="overviewPane"
                  spacing="18"
                  fillWidth="true"
                  minWidth="0"
                  maxWidth="Infinity">

                <styleClass>
                    <String fx:value="admin-page"/>
                    <String fx:value="main-content"/>
                    <String fx:value="review-page"/>
                </styleClass>

                <padding>
                    <Insets top="24" right="24" bottom="24" left="24"/>
                </padding>

                <HBox alignment="CENTER_LEFT"
                      maxWidth="Infinity"
                      styleClass="page-header">

                    <VBox spacing="3" styleClass="page-heading-copy">
                        <Label text="Review Center" styleClass="page-title"/>
                        <Label text="Track scanned boxes through metadata review, QA assignment, QA review, and export readiness"
                               styleClass="page-subtitle"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="Export Review Report"
                            onAction="#exportReport"
                            styleClass="secondary-outline-button review-report-export-button"
                            focusTraversable="false"/>
                </HBox>

                <HBox styleClass="review-search-shell"
                      maxWidth="Infinity">

                    <StackPane styleClass="field-icon-shell">
                        <Label text="&#xe908;" styleClass="prime-icon field-icon-path"/>
                    </StackPane>

                    <TextField fx:id="searchField"
                               promptText="Search by box, case, client, profile, QA status, scanner, or assigned reviewer..."
                               styleClass="search-field-input"
                               maxWidth="Infinity"
                               HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox maxWidth="Infinity" styleClass="review-status-strip">

                    <Button fx:id="detailsNeededStripBtn"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            onAction="#showMissingRequiredQueue"
                            focusTraversable="false"
                            contentDisplay="GRAPHIC_ONLY"
                            styleClass="review-strip-btn review-strip-warn">
                        <graphic>
                            <VBox styleClass="review-strip-inner">
                                <HBox spacing="5" alignment="CENTER_LEFT" styleClass="review-strip-label-row review-strip-label-warn">
                                    <Label text="&#xe922;" styleClass="prime-icon review-strip-icon"/>
                                    <Label text="Details needed" styleClass="review-strip-label"/>
                                </HBox>
                                <Label fx:id="missingRequiredCountLabel" text="0" styleClass="review-strip-num review-strip-num-warn"/>
                            </VBox>
                        </graphic>
                    </Button>

                    <Button fx:id="exportBlockedStripBtn"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            onAction="#showExportBlockedQueue"
                            focusTraversable="false"
                            contentDisplay="GRAPHIC_ONLY"
                            styleClass="review-strip-btn review-strip-danger">
                        <graphic>
                            <VBox styleClass="review-strip-inner">
                                <HBox spacing="5" alignment="CENTER_LEFT" styleClass="review-strip-label-row review-strip-label-danger">
                                    <Label text="&#xe90b;" styleClass="prime-icon review-strip-icon"/>
                                    <Label text="Export blocked" styleClass="review-strip-label"/>
                                </HBox>
                                <Label fx:id="exportBlockedCountLabel" text="0" styleClass="review-strip-num review-strip-num-danger"/>
                            </VBox>
                        </graphic>
                    </Button>

                    <Button fx:id="failedValidationStripBtn"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            onAction="#showFailedValidationQueue"
                            focusTraversable="false"
                            contentDisplay="GRAPHIC_ONLY"
                            styleClass="review-strip-btn review-strip-danger">
                        <graphic>
                            <VBox styleClass="review-strip-inner">
                                <HBox spacing="5" alignment="CENTER_LEFT" styleClass="review-strip-label-row review-strip-label-danger">
                                    <Label text="&#xe90b;" styleClass="prime-icon review-strip-icon"/>
                                    <Label text="Validation failed" styleClass="review-strip-label"/>
                                </HBox>
                                <Label fx:id="failedValidationCountLabel" text="0" styleClass="review-strip-num review-strip-num-danger"/>
                            </VBox>
                        </graphic>
                    </Button>

                    <Button fx:id="readyForQaStripBtn"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            onAction="#showReadyForQaQueue"
                            focusTraversable="false"
                            contentDisplay="GRAPHIC_ONLY"
                            styleClass="review-strip-btn review-strip-info">
                        <graphic>
                            <VBox styleClass="review-strip-inner">
                                <HBox spacing="5" alignment="CENTER_LEFT" styleClass="review-strip-label-row review-strip-label-info">
                                    <Label text="&#xe90a;" styleClass="prime-icon review-strip-icon"/>
                                    <Label text="Ready for QA" styleClass="review-strip-label"/>
                                </HBox>
                                <Label fx:id="readyForQaCountLabel" text="0" styleClass="review-strip-num review-strip-num-info"/>
                            </VBox>
                        </graphic>
                    </Button>

                    <Button fx:id="qaRejectedStripBtn"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            onAction="#showQaRejectedQueue"
                            focusTraversable="false"
                            contentDisplay="GRAPHIC_ONLY"
                            styleClass="review-strip-btn review-strip-warn">
                        <graphic>
                            <VBox styleClass="review-strip-inner">
                                <HBox spacing="5" alignment="CENTER_LEFT" styleClass="review-strip-label-row review-strip-label-warn">
                                    <Label text="&#xe922;" styleClass="prime-icon review-strip-icon"/>
                                    <Label text="QA rejected" styleClass="review-strip-label"/>
                                </HBox>
                                <Label fx:id="qaRejectedCountLabel" text="0" styleClass="review-strip-num review-strip-num-warn"/>
                            </VBox>
                        </graphic>
                    </Button>

                    <Button fx:id="recentlyCompletedStripBtn"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            onAction="#showRecentlyScannedQueue"
                            focusTraversable="false"
                            contentDisplay="GRAPHIC_ONLY"
                            styleClass="review-strip-btn review-strip-neutral">
                        <graphic>
                            <VBox styleClass="review-strip-inner">
                                <HBox spacing="5" alignment="CENTER_LEFT" styleClass="review-strip-label-row">
                                    <Label text="&#xe940;" styleClass="prime-icon review-strip-icon"/>
                                    <Label text="Recently scanned" styleClass="review-strip-label"/>
                                </HBox>
                                <Label fx:id="recentlyScannedCountLabel" text="0" styleClass="review-strip-num"/>
                            </VBox>
                        </graphic>
                    </Button>

                </HBox>

                <HBox spacing="0"
                      alignment="CENTER_LEFT"
                      maxWidth="Infinity"
                      styleClass="review-filter-card">

                    <HBox spacing="6" alignment="CENTER_LEFT" styleClass="review-filter-group">
                        <Label text="STATUS" styleClass="review-filter-label"/>
                        <ComboBox fx:id="qaStatusFilterComboBox" styleClass="review-filter"/>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Region styleClass="review-filter-divider"/>

                    <HBox spacing="6" alignment="CENTER_LEFT" styleClass="review-filter-group">
                        <Label text="USER" styleClass="review-filter-label"/>
                        <ComboBox fx:id="scannedByFilterComboBox" styleClass="review-filter"/>
                    </HBox>

                    <HBox spacing="6" alignment="CENTER_LEFT" styleClass="review-filter-group">
                        <Label text="PERIOD" styleClass="review-filter-label"/>
                        <ComboBox fx:id="dateRangeFilterComboBox" styleClass="review-filter"/>
                    </HBox>

                    <DatePicker fx:id="dateRangePicker" editable="false">
                        <styleClass>
                            <String fx:value="review-filter"/>
                            <String fx:value="activity-log-date-picker"/>
                        </styleClass>
                    </DatePicker>

                </HBox>

                <HBox fx:id="batchActionBar"
                      spacing="12"
                      alignment="CENTER_LEFT"
                      visible="false"
                      managed="false"
                      maxWidth="Infinity"
                      styleClass="review-batch-bar">

                    <Label fx:id="batchSelectionLabel"
                           text="0 selected"
                           styleClass="review-batch-label"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="Assign to QA" onAction="#assignSelectedToQa" styleClass="profile-secondary-button" focusTraversable="false"/>
                    <Button text="Mark Ready for QA" onAction="#markSelectedReadyForQa" styleClass="profile-secondary-button" focusTraversable="false"/>
                    <Button text="Clear Selection" onAction="#clearSelection" styleClass="profile-secondary-button" focusTraversable="false"/>
                </HBox>

                <VBox spacing="0"
                      fillWidth="true"
                      maxWidth="Infinity"
                      styleClass="review-results-card">

                    <GridPane maxWidth="Infinity"
                              styleClass="review-table-header">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="17" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="13" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="13" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="12" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="5" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="11" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="13" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="8" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="8" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                        </columnConstraints>

                        <Label text="Box" wrapText="true" maxWidth="Infinity" styleClass="review-header-label" GridPane.columnIndex="0"/>
                        <Label text="Client" wrapText="true" maxWidth="Infinity" styleClass="review-header-label" GridPane.columnIndex="1"/>
                        <Label text="Profile" wrapText="true" maxWidth="Infinity" styleClass="review-header-label" GridPane.columnIndex="2"/>
                        <Label text="QA Status" wrapText="true" maxWidth="Infinity" styleClass="review-header-label" GridPane.columnIndex="3" GridPane.halignment="CENTER"/>
                        <Label text="Pages" wrapText="true" maxWidth="Infinity" styleClass="review-header-label" GridPane.columnIndex="4" GridPane.halignment="CENTER"/>
                        <Label text="Waiting" wrapText="true" maxWidth="Infinity" styleClass="review-header-label" GridPane.columnIndex="5"/>
                        <Label text="QA Assignee" wrapText="true" maxWidth="Infinity" styleClass="review-header-label" GridPane.columnIndex="6" GridPane.halignment="CENTER"/>
                        <Label text="Assign QA" wrapText="true" maxWidth="Infinity" styleClass="review-header-label" GridPane.columnIndex="7"/>
                        <Label text="Review" wrapText="true" maxWidth="Infinity" styleClass="review-header-label" GridPane.columnIndex="8"/>
                    </GridPane>

                    <VBox fx:id="resultsRowsContainer"
                          spacing="0"
                          fillWidth="true"
                          maxWidth="Infinity"
                          styleClass="review-table-body"/>

                    <VBox fx:id="emptyStateBox"
                          spacing="9"
                          visible="false"
                          managed="false"
                          maxWidth="Infinity"
                          styleClass="review-empty-state">

                        <Label text="No matching review items" styleClass="empty-state-title"/>

                        <Label text="Try changing filters or searching for a different box, case, client, profile, or assignee."
                               styleClass="empty-state-copy"/>

                        <Button text="Clear Filters"
                                onAction="#clearFilters"
                                styleClass="create-user-button"
                                focusTraversable="false"/>
                    </VBox>

                    <HBox fx:id="paginationBar"
                          alignment="CENTER"
                          spacing="12"
                          visible="false"
                          managed="false"
                          maxWidth="Infinity"
                          styleClass="pagination-bar">

                        <Label fx:id="paginationSummaryLabel"
                               text="Showing 0 records"
                               styleClass="pagination-summary-label"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <HBox fx:id="paginationButtonsBox"
                              alignment="CENTER"
                              spacing="6"
                              styleClass="pagination-buttons-box"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <HBox alignment="CENTER_RIGHT"
                              spacing="9"
                              styleClass="rows-per-page-box">

                            <Label text="Rows per page"
                                   styleClass="rows-per-page-label"/>

                            <ComboBox fx:id="rowsPerPageComboBox"
                                      styleClass="rows-per-page-filter"/>
                        </HBox>
                    </HBox>
                </VBox>
            </VBox>

            <!-- =====================================================
                 REVIEW WORKSPACE
                 ===================================================== -->

            <VBox fx:id="workspacePane"
                  spacing="18"
                  fillWidth="true"
                  minWidth="0"
                  maxWidth="Infinity"
                  visible="false"
                  managed="false">

                <styleClass>
                    <String fx:value="admin-page"/>
                    <String fx:value="main-content"/>
                    <String fx:value="review-workspace-page"/>
                    <String fx:value="scan-review-workspace"/>
                </styleClass>

                <BorderPane fx:id="reviewWorkspaceView"
                            minWidth="0"
                            minHeight="0"
                            maxWidth="Infinity"
                            maxHeight="Infinity"
                            VBox.vgrow="ALWAYS"
                            styleClass="qa-review-workspace">

                    <top>
                        <VBox spacing="3"
                              alignment="CENTER_LEFT"
                              minWidth="0"
                              minHeight="72"
                              prefHeight="72"
                              maxHeight="72"
                              maxWidth="Infinity"
                              styleClass="qa-review-header">
                            <padding>
                                <Insets top="6" right="18" bottom="6" left="18"/>
                            </padding>

                            <Label text="Review QA"
                                   translateY="10"
                                   mouseTransparent="true"
                                   styleClass="qa-review-title"/>

                            <Button text="Back"
                                    onAction="#onBackToScanningFromReview"
                                    translateY="10"
                                    styleClass="scan-back-button"/>

                            <HBox spacing="9"
                                  alignment="CENTER"
                                  translateY="-24"
                                  mouseTransparent="true"
                                  maxWidth="Infinity">
                                <Label fx:id="reviewReferenceInfoLabel"
                                       text="Ref: -"
                                       styleClass="scan-session-info-chip"/>

                                <Label fx:id="reviewFilesInfoLabel"
                                       text="Scanned Files: 0"
                                       styleClass="scan-session-info-chip"/>

                                <Label fx:id="reviewDocumentsInfoLabel"
                                       text="Documents: 0"
                                       styleClass="scan-session-info-chip"/>
                            </HBox>

                            <HBox spacing="18"
                                  alignment="CENTER_LEFT"
                                  visible="false"
                                  managed="false">
                                <Label text="Box" styleClass="review-summary-label"/>
                                <Label fx:id="reviewBoxValueLabel" text="-" styleClass="review-summary-value"/>
                                <Label text="Profile" styleClass="review-summary-label"/>
                                <Label fx:id="reviewProfileValueLabel" text="-" styleClass="review-summary-value"/>
                                <Label text="Documents" styleClass="review-summary-label"/>
                                <Label fx:id="reviewDocumentsValueLabel" text="-" styleClass="review-summary-value"/>
                            </HBox>
                        </VBox>
                    </top>

                    <left>
                        <VBox spacing="15"
                              minWidth="320"
                              prefWidth="320"
                              maxWidth="320"
                              minHeight="0"
                              maxHeight="Infinity"
                              styleClass="qa-review-left-panel">

                            <HBox alignment="CENTER_LEFT"
                                  spacing="9"
                                  maxWidth="Infinity">
                                <Label text="Box Structure"
                                       styleClass="qa-review-panel-title"/>

                                <Region HBox.hgrow="ALWAYS"/>
                            </HBox>

                            <Label fx:id="reviewSidebarSubtitleLabel"
                                   text="Profile - Box"
                                   styleClass="document-tree-subtitle"/>

                            <ScrollPane fitToWidth="true"
                                        fitToHeight="false"
                                        hbarPolicy="NEVER"
                                        vbarPolicy="AS_NEEDED"
                                        pannable="true"
                                        minHeight="0"
                                        maxHeight="Infinity"
                                        VBox.vgrow="ALWAYS"
                                        styleClass="document-tree-scroll">

                                <VBox fx:id="reviewDocumentListContainer"
                                      spacing="9"
                                      minWidth="0"
                                      maxWidth="Infinity"
                                      styleClass="document-tree-container"/>
                            </ScrollPane>
                        </VBox>
                    </left>

                    <center>
                        <BorderPane minWidth="0"
                                    minHeight="0"
                                    maxWidth="Infinity"
                                    maxHeight="Infinity"
                                    styleClass="review-center-panel">

                            <top>
                                <HBox spacing="12"
                                      alignment="CENTER_LEFT"
                                      minHeight="51"
                                      prefHeight="51"
                                      maxHeight="51"
                                      styleClass="scan-view-toolbar">
                                    <padding>
                                        <Insets top="0" right="18" bottom="0" left="18"/>
                                    </padding>

                                    <Label text="View" styleClass="view-toolbar-label"/>
                                    <Button fx:id="reviewZoomOutButton" text="&#8722;" onAction="#onReviewZoomOut" styleClass="view-tool-button"/>
                                    <Label fx:id="reviewZoomLabel" text="100%" minWidth="54" alignment="CENTER" styleClass="view-zoom-label"/>
                                    <Button fx:id="reviewZoomInButton" text="+" onAction="#onReviewZoomIn" styleClass="view-tool-button"/>
                                    <Region styleClass="view-toolbar-divider"/>
                                    <Button fx:id="reviewFitButton" text="↑" onAction="#onNudgeReviewPreviewUp" styleClass="view-tool-button"/>
                                    <Button fx:id="reviewPrevPageButton" text="←" onAction="#onNudgeReviewPreviewLeft" styleClass="view-tool-button"/>
                                    <Label text="Move" styleClass="view-toolbar-muted-label"/>
                                    <Button fx:id="reviewNextPageButton" text="→" onAction="#onNudgeReviewPreviewRight" styleClass="view-tool-button"/>
                                    <Button fx:id="reviewBarcodeButton" text="↓" onAction="#onNudgeReviewPreviewDown" styleClass="view-tool-button"/>
                                    <Label fx:id="reviewSelectedTitleLabel" text="No page selected" visible="false" managed="false" styleClass="review-selected-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="." styleClass="review-view-icon"/>
                                    <Label text="." styleClass="review-view-icon"/>
                                    <Label text="." styleClass="review-view-icon"/>
                                    <Button text="Reset View" onAction="#onResetReviewPreviewView" styleClass="view-reset-button"/>
                                </HBox>
                            </top>

                            <center>
                                <StackPane minWidth="0"
                                           minHeight="0"
                                           maxWidth="Infinity"
                                           maxHeight="Infinity"
                                           styleClass="review-preview-stage">

                                    <HBox spacing="18"
                                          alignment="CENTER"
                                          minWidth="0"
                                          minHeight="0"
                                          maxWidth="Infinity"
                                          maxHeight="Infinity">

                                        <Button text="&#8249;"
                                                onAction="#onPreviousReviewPage"
                                                styleClass="preview-arrow-button"/>

                                        <StackPane fx:id="reviewPreviewHost"
                                                   minWidth="0"
                                                   minHeight="0"
                                                   maxWidth="Infinity"
                                                   maxHeight="Infinity"
                                                   HBox.hgrow="ALWAYS"
                                                   styleClass="review-preview-host"/>

                                        <Button text="&#8250;"
                                                onAction="#onNextReviewPage"
                                                styleClass="preview-arrow-button"/>
                                    </HBox>
                                </StackPane>
                            </center>

                            <bottom>
                                <VBox spacing="0"
                                      visible="false"
                                      managed="false"
                                      minHeight="0"
                                      prefHeight="0"
                                      maxHeight="0"
                                      opacity="0"
                                      styleClass="review-page-tray-shell">
                                    <HBox visible="false"
                                          managed="false"
                                          alignment="CENTER_LEFT"
                                          minHeight="0"
                                          prefHeight="0"
                                          maxHeight="0">
                                        <Label text="Page Tray" styleClass="review-page-tray-title"/>
                                    </HBox>

                                    <ScrollPane fitToHeight="true"
                                                fitToWidth="false"
                                                hbarPolicy="AS_NEEDED"
                                                vbarPolicy="NEVER"
                                                minHeight="144"
                                                prefHeight="144"
                                                maxHeight="144"
                                                styleClass="review-page-tray-scroll">
                                        <HBox fx:id="reviewPageTrayContainer"
                                              spacing="9"
                                              minHeight="111"
                                              maxHeight="111"
                                              styleClass="review-page-tray-container"/>
                                    </ScrollPane>
                                </VBox>
                            </bottom>
                        </BorderPane>
                    </center>

                    <right>
                        <VBox spacing="12"
                              prefWidth="240"
                              minWidth="240"
                              maxWidth="240"
                              minHeight="0"
                              maxHeight="Infinity"
                              styleClass="qa-tools-panel">

                            <VBox spacing="9"
                                  VBox.vgrow="ALWAYS"
                                  minWidth="0"
                                  minHeight="0"
                                  maxWidth="Infinity"
                                  maxHeight="Infinity"
                                  fillWidth="true"
                                  styleClass="qa-tools-content">

                                <Label fx:id="reviewStatusBadge"
                                       text="QA Completed"
                                       styleClass="qa-review-status-badge qa-review-status-complete"/>

                                <VBox spacing="4"
                                      maxWidth="Infinity"
                                      styleClass="qa-tools-section-box">

                                    <Label text="Comment"
                                           styleClass="qa-tools-section-title"/>

                                    <TextArea fx:id="qaCommentTextArea"
                                              promptText="Add QA note for this page..."
                                              wrapText="true"
                                              prefRowCount="6"
                                              VBox.vgrow="ALWAYS"
                                              maxWidth="Infinity"
                                              styleClass="qa-comment-textarea"/>
                                </VBox>

                                <Region styleClass="scan-panel-divider"/>

                                <VBox spacing="9"
                                      maxWidth="Infinity">

                                    <VBox spacing="9"
                                          maxWidth="Infinity"
                                          styleClass="qa-tools-section-box">
                                        <Label text="Apply To"
                                               styleClass="qa-tools-section-title"/>

                                        <ComboBox fx:id="qaActionScopeComboBox"
                                                  maxWidth="Infinity"
                                                  styleClass="scan-tool-button"/>
                                    </VBox>

                                    <Button text="Approve Page"
                                            onAction="#onApprovePage"
                                            maxWidth="Infinity"
                                            focusTraversable="false"
                                            styleClass="qa-approve-button"/>

                                    <Button text="Mark Needs Fix"
                                            onAction="#onMarkNeedsFix"
                                            maxWidth="Infinity"
                                            focusTraversable="false"
                                            styleClass="qa-fix-button"/>

                                    <Button text="Clear Review Status"
                                            onAction="#onClearReviewStatus"
                                            maxWidth="Infinity"
                                            focusTraversable="false"
                                            styleClass="qa-neutral-button"/>
                                </VBox>

                                <Region styleClass="scan-panel-divider"/>

                                <Button text="Next Unreviewed"
                                        onAction="#onNextUnreviewed"
                                        maxWidth="Infinity"
                                        focusTraversable="false"
                                        styleClass="qa-neutral-button"/>

                                <Region styleClass="scan-panel-divider"/>

                                <Button text="Complete QA"
                                        onAction="#onCompleteQa"
                                        maxWidth="Infinity"
                                        focusTraversable="false"
                                        styleClass="qa-complete-button"/>

                                <Button text="Export Type"
                                        onAction="#onOpenExportTypeDialog"
                                        maxWidth="Infinity"
                                        focusTraversable="false"
                                        styleClass="qa-export-type-button"/>
                            </VBox>
                        </VBox>
                    </right>
                </BorderPane>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
