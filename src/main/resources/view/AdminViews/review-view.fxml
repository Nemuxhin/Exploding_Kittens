<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="easv.gui.controller.admin.ReviewController"
            fitToWidth="true"
            fitToHeight="false"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            minWidth="0"
            minHeight="0"
            maxWidth="Infinity"
            maxHeight="Infinity"
            styleClass="admin-page-scroll">

    <content>
        <StackPane minWidth="0"
                   maxWidth="Infinity"
                   styleClass="review-page-host">

            <!-- =====================================================
                 OVERVIEW / WORK QUEUE
                 ===================================================== -->

            <VBox fx:id="overviewPane"
                  spacing="18"
                  fillWidth="true"
                  minWidth="0"
                  maxWidth="Infinity">

                <styleClass>
                    <String fx:value="admin-page"/>
                    <String fx:value="main-content"/>
                    <String fx:value="review-page"/>
                </styleClass>

                <padding>
                    <Insets top="24" right="24" bottom="24" left="24"/>
                </padding>

                <HBox alignment="CENTER_LEFT"
                      maxWidth="Infinity"
                      styleClass="page-header">

                    <VBox spacing="3" styleClass="page-heading-copy">
                        <Label text="Review Center" styleClass="page-title"/>
                        <Label text="Track scanned boxes through document details, QA assignment, QA review, and export readiness"
                               styleClass="page-subtitle"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="Export Review Report"
                            onAction="#exportReport"
                            styleClass="secondary-outline-button"
                            focusTraversable="false"/>
                </HBox>

                <HBox styleClass="review-search-shell"
                      maxWidth="Infinity">

                    <StackPane styleClass="field-icon-shell">
                        <Label text="&#xe908;" styleClass="prime-icon field-icon-path"/>
                    </StackPane>

                    <TextField fx:id="searchField"
                               promptText="Search by box, case, client, profile, QA status, scanner, or assigned reviewer..."
                               styleClass="search-field-input"
                               maxWidth="Infinity"
                               HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox maxWidth="Infinity" styleClass="review-status-strip">

                    <Button fx:id="detailsNeededStripBtn"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            onAction="#showMissingRequiredQueue"
                            focusTraversable="false"
                            contentDisplay="GRAPHIC_ONLY"
                            styleClass="review-strip-btn review-strip-warn">
                        <graphic>
                            <VBox styleClass="review-strip-inner">
                                <HBox spacing="5" alignment="CENTER_LEFT" styleClass="review-strip-label-row review-strip-label-warn">
                                    <Label text="&#xe922;" styleClass="prime-icon review-strip-icon"/>
                                    <Label text="Details needed" styleClass="review-strip-label"/>
                                </HBox>
                                <Label fx:id="missingRequiredCountLabel" text="0" styleClass="review-strip-num review-strip-num-warn"/>
                            </VBox>
                        </graphic>
                    </Button>

                    <Button fx:id="exportBlockedStripBtn"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            onAction="#showExportBlockedQueue"
                            focusTraversable="false"
                            contentDisplay="GRAPHIC_ONLY"
                            styleClass="review-strip-btn review-strip-danger">
                        <graphic>
                            <VBox styleClass="review-strip-inner">
                                <HBox spacing="5" alignment="CENTER_LEFT" styleClass="review-strip-label-row review-strip-label-danger">
                                    <Label text="&#xe90b;" styleClass="prime-icon review-strip-icon"/>
                                    <Label text="Export blocked" styleClass="review-strip-label"/>
                                </HBox>
                                <Label fx:id="exportBlockedCountLabel" text="0" styleClass="review-strip-num review-strip-num-danger"/>
                            </VBox>
                        </graphic>
                    </Button>

                    <Button fx:id="failedValidationStripBtn"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            onAction="#showFailedValidationQueue"
                            focusTraversable="false"
                            contentDisplay="GRAPHIC_ONLY"
                            styleClass="review-strip-btn review-strip-danger">
                        <graphic>
                            <VBox styleClass="review-strip-inner">
                                <HBox spacing="5" alignment="CENTER_LEFT" styleClass="review-strip-label-row review-strip-label-danger">
                                    <Label text="&#xe90b;" styleClass="prime-icon review-strip-icon"/>
                                    <Label text="Validation failed" styleClass="review-strip-label"/>
                                </HBox>
                                <Label fx:id="failedValidationCountLabel" text="0" styleClass="review-strip-num review-strip-num-danger"/>
                            </VBox>
                        </graphic>
                    </Button>

                    <Button fx:id="readyForQaStripBtn"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            onAction="#showReadyForQaQueue"
                            focusTraversable="false"
                            contentDisplay="GRAPHIC_ONLY"
                            styleClass="review-strip-btn review-strip-info">
                        <graphic>
                            <VBox styleClass="review-strip-inner">
                                <HBox spacing="5" alignment="CENTER_LEFT" styleClass="review-strip-label-row review-strip-label-info">
                                    <Label text="&#xe90a;" styleClass="prime-icon review-strip-icon"/>
                                    <Label text="Ready for QA" styleClass="review-strip-label"/>
                                </HBox>
                                <Label fx:id="readyForQaCountLabel" text="0" styleClass="review-strip-num review-strip-num-info"/>
                            </VBox>
                        </graphic>
                    </Button>

                    <Button fx:id="qaRejectedStripBtn"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            onAction="#showQaRejectedQueue"
                            focusTraversable="false"
                            contentDisplay="GRAPHIC_ONLY"
                            styleClass="review-strip-btn review-strip-warn">
                        <graphic>
                            <VBox styleClass="review-strip-inner">
                                <HBox spacing="5" alignment="CENTER_LEFT" styleClass="review-strip-label-row review-strip-label-warn">
                                    <Label text="&#xe922;" styleClass="prime-icon review-strip-icon"/>
                                    <Label text="QA rejected" styleClass="review-strip-label"/>
                                </HBox>
                                <Label fx:id="qaRejectedCountLabel" text="0" styleClass="review-strip-num review-strip-num-warn"/>
                            </VBox>
                        </graphic>
                    </Button>

                    <Button fx:id="recentlyCompletedStripBtn"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            onAction="#showRecentlyCompletedQueue"
                            focusTraversable="false"
                            contentDisplay="GRAPHIC_ONLY"
                            styleClass="review-strip-btn review-strip-neutral">
                        <graphic>
                            <VBox styleClass="review-strip-inner">
                                <HBox spacing="5" alignment="CENTER_LEFT" styleClass="review-strip-label-row">
                                    <Label text="&#xe940;" styleClass="prime-icon review-strip-icon"/>
                                    <Label text="Recently completed" styleClass="review-strip-label"/>
                                </HBox>
                                <Label fx:id="recentlyCompletedCountLabel" text="0" styleClass="review-strip-num"/>
                            </VBox>
                        </graphic>
                    </Button>

                </HBox>

                <HBox spacing="0"
                      alignment="CENTER_LEFT"
                      maxWidth="Infinity"
                      styleClass="review-filter-card">

                    <HBox spacing="6" alignment="CENTER_LEFT" styleClass="review-filter-group">
                        <Label text="STATUS" styleClass="review-filter-label"/>
                        <ComboBox fx:id="qaStatusFilterComboBox" styleClass="review-filter"/>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Region styleClass="review-filter-divider"/>

                    <HBox spacing="6" alignment="CENTER_LEFT" styleClass="review-filter-group">
                        <Label text="USER" styleClass="review-filter-label"/>
                        <ComboBox fx:id="scannedByFilterComboBox" styleClass="review-filter"/>
                    </HBox>

                    <HBox spacing="6" alignment="CENTER_LEFT" styleClass="review-filter-group">
                        <Label text="PERIOD" styleClass="review-filter-label"/>
                        <ComboBox fx:id="dateRangeFilterComboBox" styleClass="review-filter"/>
                    </HBox>

                    <DatePicker fx:id="dateRangePicker" editable="false">
                        <styleClass>
                            <String fx:value="review-filter"/>
                            <String fx:value="activity-log-date-picker"/>
                        </styleClass>
                    </DatePicker>

                </HBox>

                <HBox fx:id="batchActionBar"
                      spacing="12"
                      alignment="CENTER_LEFT"
                      visible="false"
                      managed="false"
                      maxWidth="Infinity"
                      styleClass="review-batch-bar">

                    <Label fx:id="batchSelectionLabel"
                           text="0 selected"
                           styleClass="review-batch-label"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="Assign to QA" onAction="#assignSelectedToQa" styleClass="profile-secondary-button" focusTraversable="false"/>
                    <Button text="Mark Ready for QA" onAction="#markSelectedReadyForQa" styleClass="profile-secondary-button" focusTraversable="false"/>
                    <Button text="Clear Selection" onAction="#clearSelection" styleClass="profile-secondary-button" focusTraversable="false"/>
                </HBox>

                <VBox spacing="0"
                      fillWidth="true"
                      maxWidth="Infinity"
                      styleClass="review-results-card">

                    <GridPane maxWidth="Infinity"
                              styleClass="review-table-header">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="4" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="20" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="14" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="14" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="12" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="6" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="12" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="10" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="8" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                        </columnConstraints>

                        <Region GridPane.columnIndex="0"/>

                        <Label text="Box" wrapText="true" maxWidth="Infinity" styleClass="review-header-label" GridPane.columnIndex="1"/>
                        <Label text="Client" wrapText="true" maxWidth="Infinity" styleClass="review-header-label" GridPane.columnIndex="2"/>
                        <Label text="Profile" wrapText="true" maxWidth="Infinity" styleClass="review-header-label" GridPane.columnIndex="3"/>
                        <Label text="QA Status" wrapText="true" maxWidth="Infinity" styleClass="review-header-label" GridPane.columnIndex="4"/>
                        <Label text="Pages" wrapText="true" maxWidth="Infinity" styleClass="review-header-label" GridPane.columnIndex="5"/>
                        <Label text="Waiting" wrapText="true" maxWidth="Infinity" styleClass="review-header-label" GridPane.columnIndex="6"/>
                        <Label text="QA Assignee" wrapText="true" maxWidth="Infinity" styleClass="review-header-label" GridPane.columnIndex="7"/>
                        <Label text="Review" wrapText="true" maxWidth="Infinity" styleClass="review-header-label" GridPane.columnIndex="8"/>
                    </GridPane>

                    <VBox fx:id="resultsRowsContainer"
                          spacing="0"
                          fillWidth="true"
                          maxWidth="Infinity"
                          styleClass="review-table-body"/>

                    <VBox fx:id="emptyStateBox"
                          spacing="9"
                          visible="false"
                          managed="false"
                          maxWidth="Infinity"
                          styleClass="review-empty-state">

                        <Label text="No matching review items" styleClass="empty-state-title"/>

                        <Label text="Try changing filters or searching for a different box, case, client, profile, or assignee."
                               styleClass="empty-state-copy"/>

                        <Button text="Clear Filters"
                                onAction="#clearFilters"
                                styleClass="create-user-button"
                                focusTraversable="false"/>
                    </VBox>

                    <HBox fx:id="paginationBar"
                          alignment="CENTER"
                          spacing="12"
                          visible="false"
                          managed="false"
                          maxWidth="Infinity"
                          styleClass="pagination-bar">

                        <Label fx:id="paginationSummaryLabel"
                               text="Showing 0 records"
                               styleClass="pagination-summary-label"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <HBox fx:id="paginationButtonsBox"
                              alignment="CENTER"
                              spacing="6"
                              styleClass="pagination-buttons-box"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <HBox alignment="CENTER_RIGHT"
                              spacing="9"
                              styleClass="rows-per-page-box">

                            <Label text="Rows per page"
                                   styleClass="rows-per-page-label"/>

                            <ComboBox fx:id="rowsPerPageComboBox"
                                      styleClass="rows-per-page-filter"/>
                        </HBox>
                    </HBox>
                </VBox>
            </VBox>

            <!-- =====================================================
                 REVIEW WORKSPACE
                 ===================================================== -->

            <VBox fx:id="workspacePane"
                  spacing="18"
                  fillWidth="true"
                  minWidth="0"
                  maxWidth="Infinity"
                  visible="false"
                  managed="false">

                <styleClass>
                    <String fx:value="admin-page"/>
                    <String fx:value="main-content"/>
                    <String fx:value="review-workspace-page"/>
                </styleClass>

                <padding>
                    <Insets top="24" right="24" bottom="24" left="24"/>
                </padding>

                <VBox spacing="15" maxWidth="Infinity">
                    <HBox alignment="CENTER_LEFT" maxWidth="Infinity">
                        <Button text="Back"
                                onAction="#showOverview"
                                focusTraversable="false"
                                styleClass="back-button"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT"
                          maxWidth="Infinity"
                          styleClass="review-workspace-header">

                        <VBox spacing="3"
                              minWidth="0"
                              maxWidth="Infinity"
                              HBox.hgrow="ALWAYS">

                            <styleClass>
                                <String fx:value="page-heading-copy"/>
                                <String fx:value="review-workspace-title-area"/>
                            </styleClass>

                            <Label fx:id="workspaceTitleLabel"
                                   text="BOX-2026-004 / Case 2026-042 / Document 3"
                                   minWidth="0"
                                   maxWidth="Infinity"
                                   textOverrun="ELLIPSIS"
                                   styleClass="page-title"/>

                            <Label fx:id="workspaceSubtitleLabel"
                                   text="Building Archive - Aalborg Municipality - 12 pages - Missing Required Fields"
                                   minWidth="0"
                                   maxWidth="Infinity"
                                   textOverrun="ELLIPSIS"
                                   styleClass="page-subtitle"/>
                        </VBox>

                        <HBox alignment="CENTER_RIGHT"
                              spacing="12"
                              styleClass="header-actions">

                            <Button text="Save Review"
                                    onAction="#saveReviewDetails"
                                    focusTraversable="false">
                                <styleClass>
                                    <String fx:value="header-secondary-button"/>
                                    <String fx:value="admin-save-button"/>
                                </styleClass>
                            </Button>

                            <Button text="Mark Details Complete"
                                    onAction="#markComplete"
                                    focusTraversable="false">
                                <styleClass>
                                    <String fx:value="header-secondary-button"/>
                                    <String fx:value="admin-complete-button"/>
                                </styleClass>
                            </Button>

                            <Button text="Assign QA"
                                    onAction="#sendToQa"
                                    focusTraversable="false">
                                <styleClass>
                                    <String fx:value="header-primary-button"/>
                                    <String fx:value="admin-send-review-button"/>
                                </styleClass>
                            </Button>

                            <Button text="Approve QA"
                                    onAction="#approveReview"
                                    focusTraversable="false">
                                <styleClass>
                                    <String fx:value="header-primary-button"/>
                                    <String fx:value="admin-approve-button"/>
                                </styleClass>
                            </Button>

                            <Button text="Reject QA"
                                    onAction="#rejectReview"
                                    focusTraversable="false">
                                <styleClass>
                                    <String fx:value="header-destructive-button"/>
                                    <String fx:value="admin-reject-button"/>
                                </styleClass>
                            </Button>
                        </HBox>
                    </HBox>
                </VBox>

                <HBox spacing="12"
                      alignment="CENTER_LEFT"
                      maxWidth="Infinity"
                      styleClass="review-workspace-warning-banner">

                    <Label text="&#xe922;" styleClass="prime-icon review-workspace-warning-icon"/>

                    <Label fx:id="workspaceWarningLabel"
                           text="Export blocked: 2 required document fields are missing."
                           styleClass="review-workspace-warning-text"/>
                </HBox>

                <HBox spacing="0"
                      alignment="TOP_LEFT"
                      maxWidth="Infinity"
                      styleClass="review-workspace-shell">

                    <VBox spacing="15"
                          prefWidth="300"
                          minWidth="270"
                          maxWidth="330"
                          styleClass="review-workspace-left-panel">

                        <VBox spacing="3">
                            <Label text="Scan Structure" styleClass="review-workspace-panel-title"/>
                            <Label text="Box, case, and document hierarchy"
                                   styleClass="review-workspace-panel-subtitle"/>
                        </VBox>

                        <HBox styleClass="search-field-shell"
                              maxWidth="Infinity">

                            <StackPane styleClass="field-icon-shell">
                                <Label text="&#xe908;" styleClass="prime-icon field-icon-path"/>
                            </StackPane>

                            <TextField promptText="Search documents..."
                                       styleClass="search-field-input"
                                       maxWidth="Infinity"
                                       HBox.hgrow="ALWAYS"/>
                        </HBox>

                        <VBox spacing="12"
                              maxWidth="Infinity"
                              styleClass="review-workspace-tree">

                            <Label text="BOX-2026-004" styleClass="review-workspace-tree-root"/>

                            <VBox spacing="6">
                                <Label text="Case 2026-042" styleClass="review-workspace-tree-case"/>

                                <HBox alignment="CENTER_LEFT" styleClass="review-workspace-tree-row">
                                    <Label text="OK" styleClass="review-workspace-tree-status-complete"/>
                                    <Label text="Document 1" styleClass="review-workspace-tree-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="complete" styleClass="review-workspace-tree-status-text"/>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" styleClass="review-workspace-tree-row">
                                    <Label text="!" styleClass="review-workspace-tree-status-warning"/>
                                    <Label text="Document 2" styleClass="review-workspace-tree-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="missing" styleClass="review-workspace-tree-status-text"/>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" styleClass="review-workspace-tree-row-active">
                                    <Label text="!" styleClass="review-workspace-tree-status-warning"/>
                                    <Label text="Document 3" styleClass="review-workspace-tree-title-active"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="missing required" styleClass="review-workspace-tree-status-text"/>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" styleClass="review-workspace-tree-row">
                                    <Label text="-" styleClass="review-workspace-tree-status-neutral"/>
                                    <Label text="Document 4" styleClass="review-workspace-tree-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="not started" styleClass="review-workspace-tree-status-text"/>
                                </HBox>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Case 2026-043" styleClass="review-workspace-tree-case"/>

                                <HBox alignment="CENTER_LEFT" styleClass="review-workspace-tree-row">
                                    <Label text="OK" styleClass="review-workspace-tree-status-complete"/>
                                    <Label text="Document 1" styleClass="review-workspace-tree-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="complete" styleClass="review-workspace-tree-status-text"/>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" styleClass="review-workspace-tree-row">
                                    <Label text="X" styleClass="review-workspace-tree-status-danger"/>
                                    <Label text="Document 2" styleClass="review-workspace-tree-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="invalid" styleClass="review-workspace-tree-status-text"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </VBox>

                    <VBox spacing="0"
                          minWidth="0"
                          maxWidth="Infinity"
                          HBox.hgrow="ALWAYS"
                          styleClass="review-workspace-viewer-panel">

                        <HBox alignment="CENTER_LEFT"
                              styleClass="review-workspace-viewer-toolbar">

                            <Label text="Page Viewer" styleClass="review-workspace-panel-title"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label text="Page 3 of 12" styleClass="review-workspace-viewer-page-label"/>

                            <Button text="-" focusTraversable="false" styleClass="review-workspace-tool-button"/>
                            <Button text="+" focusTraversable="false" styleClass="review-workspace-tool-button"/>
                            <Button text="Fit" focusTraversable="false" styleClass="review-workspace-tool-button"/>
                            <Button text="&lt;" focusTraversable="false" styleClass="review-workspace-tool-button"/>
                            <Button text="&gt;" focusTraversable="false" styleClass="review-workspace-tool-button"/>
                            <Button text="Barcode" focusTraversable="false" styleClass="review-workspace-tool-button"/>
                        </HBox>

                        <StackPane minHeight="540"
                                   maxWidth="Infinity"
                                   styleClass="review-workspace-viewer-area">

                            <StackPane styleClass="review-workspace-paper-preview">
                                <Label text="Document Page 3"
                                       styleClass="review-workspace-paper-placeholder"/>
                            </StackPane>
                        </StackPane>

                        <ScrollPane fitToHeight="true"
                                    fitToWidth="false"
                                    hbarPolicy="AS_NEEDED"
                                    vbarPolicy="NEVER"
                                    styleClass="review-workspace-thumbnail-scroll">

                            <content>
                                <HBox spacing="9"
                                      styleClass="review-workspace-thumbnail-strip">

                                    <StackPane styleClass="review-workspace-thumbnail"><Label text="1" styleClass="review-workspace-thumbnail-label"/></StackPane>
                                    <StackPane styleClass="review-workspace-thumbnail"><Label text="2" styleClass="review-workspace-thumbnail-label"/></StackPane>
                                    <StackPane styleClass="review-workspace-thumbnail-active"><Label text="3" styleClass="review-workspace-thumbnail-label-active"/></StackPane>
                                    <StackPane styleClass="review-workspace-thumbnail"><Label text="4" styleClass="review-workspace-thumbnail-label"/></StackPane>
                                    <StackPane styleClass="review-workspace-thumbnail"><Label text="5" styleClass="review-workspace-thumbnail-label"/></StackPane>
                                    <StackPane styleClass="review-workspace-thumbnail"><Label text="6" styleClass="review-workspace-thumbnail-label"/></StackPane>
                                    <StackPane styleClass="review-workspace-thumbnail"><Label text="7" styleClass="review-workspace-thumbnail-label"/></StackPane>
                                    <StackPane styleClass="review-workspace-thumbnail"><Label text="8" styleClass="review-workspace-thumbnail-label"/></StackPane>
                                    <StackPane styleClass="review-workspace-thumbnail"><Label text="9" styleClass="review-workspace-thumbnail-label"/></StackPane>
                                    <StackPane styleClass="review-workspace-thumbnail"><Label text="10" styleClass="review-workspace-thumbnail-label"/></StackPane>

                                    <StackPane styleClass="review-workspace-thumbnail-barcode">
                                        <VBox spacing="3" alignment="CENTER">
                                            <Label text="11" styleClass="review-workspace-thumbnail-label"/>
                                            <Label text="barcode" styleClass="review-workspace-thumbnail-note"/>
                                        </VBox>
                                    </StackPane>

                                    <StackPane styleClass="review-workspace-thumbnail"><Label text="12" styleClass="review-workspace-thumbnail-label"/></StackPane>
                                </HBox>
                            </content>
                        </ScrollPane>
                    </VBox>

                    <VBox spacing="15"
                          prefWidth="330"
                          minWidth="318"
                          maxWidth="360"
                          styleClass="review-workspace-right-panel">

                        <VBox spacing="3">
                            <Label text="Review Details" styleClass="review-workspace-panel-title"/>
                            <Label text="Complete document details and QA checks"
                                   styleClass="review-workspace-panel-subtitle"/>
                        </VBox>

                        <HBox spacing="6" styleClass="review-workspace-tabs">
                            <Button fx:id="boxTabButton" text="Box" onAction="#showBoxTab" focusTraversable="false" styleClass="review-workspace-tab-button"/>
                            <Button fx:id="caseTabButton" text="Case" onAction="#showCaseTab" focusTraversable="false" styleClass="review-workspace-tab-button"/>
                            <Button fx:id="documentTabButton" text="Document" onAction="#showDocumentTab" focusTraversable="false" styleClass="review-workspace-tab-active"/>
                            <Button fx:id="pageTabButton" text="Page" onAction="#showPageTab" focusTraversable="false" styleClass="review-workspace-tab-button"/>
                        </HBox>

                        <VBox spacing="3" styleClass="review-workspace-validation-summary">
                            <Label text="Document Details" styleClass="review-workspace-validation-title"/>
                            <Label text="2 required fields missing" styleClass="review-workspace-validation-copy"/>
                        </VBox>

                        <VBox spacing="12" styleClass="review-workspace-form">

                            <VBox spacing="6">
                                <Label text="Document Type *" styleClass="review-workspace-field-label"/>
                                <ComboBox fx:id="documentTypeComboBox"
                                          maxWidth="Infinity"
                                          promptText="Select document type"
                                          styleClass="review-workspace-input-error"/>
                                <Label text="Document Type is required."
                                       styleClass="review-workspace-field-error"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Case Number *" styleClass="review-workspace-field-label"/>
                                <TextField fx:id="caseNumberField"
                                           text="2026-042"
                                           styleClass="review-workspace-input"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Registration Date" styleClass="review-workspace-field-label"/>
                                <TextField fx:id="registrationDateField"
                                           text="Invalid date"
                                           styleClass="review-workspace-input-error"/>
                                <Label text="Enter a valid date."
                                       styleClass="review-workspace-field-error"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Building Address *" styleClass="review-workspace-field-label"/>
                                <TextField fx:id="buildingAddressField"
                                           text="Skagerrakvej 16"
                                           styleClass="review-workspace-input"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Department" styleClass="review-workspace-field-label"/>
                                <ComboBox fx:id="departmentComboBox"
                                          maxWidth="Infinity"
                                          styleClass="review-workspace-input"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Notes" styleClass="review-workspace-field-label"/>
                                <TextArea fx:id="notesTextArea"
                                          promptText="Optional notes..."
                                          prefRowCount="3"
                                          wrapText="true"
                                          styleClass="review-workspace-textarea"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Tags" styleClass="review-workspace-field-label"/>

                                <HBox spacing="6">
                                    <Label text="Archive" styleClass="review-workspace-tag"/>
                                    <Label text="Building Permit" styleClass="review-workspace-tag"/>
                                    <Label text="Needs Review" styleClass="review-workspace-tag-warning"/>
                                </HBox>
                            </VBox>

                            <Region styleClass="review-workspace-divider"/>

                            <VBox spacing="6">
                                <Label text="Completion Status" styleClass="review-workspace-field-label"/>

                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <Label text="OK" styleClass="review-workspace-check-complete"/>
                                    <Label text="Box details: Complete" styleClass="review-workspace-check-text"/>
                                </HBox>

                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <Label text="OK" styleClass="review-workspace-check-complete"/>
                                    <Label text="Case details: Complete" styleClass="review-workspace-check-text"/>
                                </HBox>

                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <Label text="!" styleClass="review-workspace-check-warning"/>
                                    <Label text="Document details: Missing 2 required fields" styleClass="review-workspace-check-text"/>
                                </HBox>

                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <Label text="-" styleClass="review-workspace-check-neutral"/>
                                    <Label text="Page details: Optional" styleClass="review-workspace-check-text"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <VBox spacing="9" styleClass="review-workspace-side-actions">
                            <Button text="Save Review"
                                    onAction="#saveReviewDetails"
                                    focusTraversable="false"
                                    maxWidth="Infinity"
                                    styleClass="header-secondary-button"/>

                            <Button text="Mark Details Complete"
                                    onAction="#markComplete"
                                    focusTraversable="false"
                                    maxWidth="Infinity"
                                    styleClass="create-user-button"/>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
