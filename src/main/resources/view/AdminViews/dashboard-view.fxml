<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="easv.gui.controller.admin.DashboardController"
            fitToWidth="true"
            fitToHeight="false"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            minWidth="0"
            minHeight="0"
            maxWidth="Infinity"
            maxHeight="Infinity"
            styleClass="admin-page-scroll">

    <content>
        <VBox spacing="18"
              fillWidth="true"
              minWidth="0"
              minHeight="0"
              maxWidth="Infinity"
              styleClass="admin-page">

            <styleClass>
                <String fx:value="admin-page"/>
                <String fx:value="main-content"/>
                <String fx:value="dashboard-page"/>
            </styleClass>

            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <VBox spacing="3" styleClass="page-heading-copy">
                <Label text="Dashboard" styleClass="page-title"/>
                <Label text="Monitor users, profiles, scans, and system activity."
                       styleClass="page-subtitle"/>
            </VBox>

            <GridPane hgap="18"
                      vgap="18"
                      maxWidth="Infinity"
                      styleClass="dashboard-summary-grid">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                </columnConstraints>

                <VBox spacing="18"
                      maxWidth="Infinity"
                      styleClass="dashboard-summary-card"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="0">

                    <HBox alignment="TOP_LEFT">
                        <StackPane styleClass="dashboard-summary-icon-teal">
                            <SVGPath content="M8 7.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zm8 0a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM8 9.5c-3.04 0-5.5 1.79-5.5 4V15h11v-1.5c0-2.21-2.46-4-5.5-4zm8 0c-.52 0-1.03.05-1.5.15 1.23.89 2 2.11 2 3.55V15h5v-1.5c0-2.21-2.46-4-5.5-4z"
                                     styleClass="dashboard-summary-icon-teal-path"/>
                        </StackPane>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label fx:id="totalUsersValueLabel"
                               text="24"
                               styleClass="dashboard-summary-value"/>
                    </HBox>

                    <VBox spacing="3">
                        <Label text="Total Users" styleClass="dashboard-summary-title"/>
                        <Label text="All registered admin and operator accounts"
                               wrapText="true"
                               styleClass="dashboard-summary-subtitle"/>
                    </VBox>
                </VBox>

                <VBox spacing="18"
                      maxWidth="Infinity"
                      styleClass="dashboard-summary-card"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="0">

                    <HBox alignment="TOP_LEFT">
                        <StackPane styleClass="dashboard-summary-icon-blue">
                            <SVGPath content="M4 4h8.8L20 11.2V20H4V4zm2 2v12h12v-5.8L11.8 6H6zm3 3h3v2H9V9zm0 4h6v2H9v-2z"
                                     styleClass="dashboard-summary-icon-blue-path"/>
                        </StackPane>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label fx:id="activeProfilesValueLabel"
                               text="3"
                               styleClass="dashboard-summary-value"/>
                    </HBox>

                    <VBox spacing="3">
                        <Label text="Active Profiles" styleClass="dashboard-summary-title"/>
                        <Label text="Profiles currently available for scanning"
                               wrapText="true"
                               styleClass="dashboard-summary-subtitle"/>
                    </VBox>
                </VBox>

                <VBox spacing="18"
                      maxWidth="Infinity"
                      styleClass="dashboard-summary-card"
                      GridPane.columnIndex="2"
                      GridPane.rowIndex="0">

                    <HBox alignment="TOP_LEFT">
                        <StackPane styleClass="dashboard-summary-icon-green">
                            <SVGPath content="M3 17.5 9.2 11.3l3.3 3.3L20 7.1V12h2V3.5h-8.5v2H18l-5.5 5.5-3.3-3.3L1.5 15.4 3 17.5z"
                                     styleClass="dashboard-summary-icon-green-path"/>
                        </StackPane>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label fx:id="scansTodayValueLabel"
                               text="12"
                               styleClass="dashboard-summary-value"/>
                    </HBox>

                    <VBox spacing="3">
                        <Label text="Scans Today" styleClass="dashboard-summary-title"/>
                        <Label text="Completed scans processed in the last 24 hours"
                               wrapText="true"
                               styleClass="dashboard-summary-subtitle"/>
                    </VBox>
                </VBox>

                <VBox spacing="18"
                      maxWidth="Infinity"
                      styleClass="dashboard-summary-card"
                      GridPane.columnIndex="3"
                      GridPane.rowIndex="0">

                    <HBox alignment="TOP_LEFT">
                        <StackPane styleClass="dashboard-summary-icon-amber">
                            <SVGPath content="M12 2 1 21h22L12 2zm0 6 1 7h-2l1-7zm-1 9h2v2h-2v-2z"
                                     styleClass="dashboard-summary-icon-amber-path"/>
                        </StackPane>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label fx:id="waitingForQaValueLabel"
                               text="8"
                               styleClass="dashboard-summary-value"/>
                    </HBox>

                    <VBox spacing="3">
                        <Label text="Waiting for QA" styleClass="dashboard-summary-title"/>
                        <Label text="Documents currently pending review"
                               wrapText="true"
                               styleClass="dashboard-summary-subtitle"/>
                    </VBox>
                </VBox>
            </GridPane>

            <HBox spacing="18"
                  alignment="TOP_LEFT"
                  maxWidth="Infinity"
                  styleClass="dashboard-main-layout">

                <VBox spacing="18"
                      maxWidth="Infinity"
                      HBox.hgrow="ALWAYS">

                    <VBox spacing="0"
                          maxWidth="Infinity"
                          styleClass="dashboard-section-card">

                        <HBox alignment="CENTER_LEFT"
                              styleClass="dashboard-section-header">

                            <VBox spacing="3">
                                <Label text="Recent Activity" styleClass="dashboard-section-title"/>
                                <Label text="Latest important system events"
                                       styleClass="dashboard-section-subtitle"/>
                            </VBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button text="View All"
                                    onAction="#viewActivity"
                                    focusTraversable="false"
                                    styleClass="metadata-action-button"/>
                        </HBox>

                        <VBox spacing="0" styleClass="dashboard-activity-list">

                            <HBox alignment="CENTER_LEFT" styleClass="dashboard-activity-row">
                                <StackPane styleClass="dashboard-activity-icon-scan-box">
                                    <SVGPath content="M3 17.5 9.2 11.3l3.3 3.3L20 7.1V12h2V3.5h-8.5v2H18l-5.5 5.5-3.3-3.3L1.5 15.4 3 17.5z"
                                             styleClass="dashboard-activity-icon-scan-path"/>
                                </StackPane>

                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Sarah Smith completed scan"
                                           styleClass="dashboard-activity-title"/>
                                    <Label text="BOX-2026-004 · Building Archive · 42 pages"
                                           wrapText="true"
                                           styleClass="dashboard-activity-detail"/>
                                </VBox>

                                <Label text="10:42"
                                       styleClass="dashboard-activity-time"/>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" styleClass="dashboard-activity-row">
                                <StackPane styleClass="dashboard-activity-icon-profile-box">
                                    <SVGPath content="M5 3.5h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-13a2 2 0 0 1 2-2zm0 2v13h14v-13H5zm2.5 3h4.2a2.4 2.4 0 0 1 4.6 0h1.2v2h-1.2a2.4 2.4 0 0 1-4.6 0H7.5v-2zm6.5 1.3a.8.8 0 1 0 0-1.6.8.8 0 0 0 0 1.6z"
                                             styleClass="dashboard-activity-icon-profile-path"/>
                                </StackPane>

                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Admin created profile"
                                           styleClass="dashboard-activity-title"/>
                                    <Label text="Technical Drawings scan profile was created"
                                           wrapText="true"
                                           styleClass="dashboard-activity-detail"/>
                                </VBox>

                                <Label text="09:58"
                                       styleClass="dashboard-activity-time"/>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" styleClass="dashboard-activity-row">
                                <StackPane styleClass="dashboard-activity-icon-qa-box">
                                    <SVGPath content="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"
                                             styleClass="dashboard-activity-icon-qa-path"/>
                                </StackPane>

                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="John Doe completed QA"
                                           styleClass="dashboard-activity-title"/>
                                    <Label text="BOX-2026-003 was approved for export"
                                           wrapText="true"
                                           styleClass="dashboard-activity-detail"/>
                                </VBox>

                                <Label text="Yesterday"
                                       styleClass="dashboard-activity-time"/>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" styleClass="dashboard-activity-row">
                                <StackPane styleClass="dashboard-activity-icon-warning-box">
                                    <SVGPath content="M12 2 1 21h22L12 2zm0 6 1 7h-2l1-7zm-1 9h2v2h-2v-2z"
                                             styleClass="dashboard-activity-icon-warning-path"/>
                                </StackPane>

                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="System detected missing metadata"
                                           styleClass="dashboard-activity-title"/>
                                    <Label text="CourtRecords_BOX-2026-011 is blocked from export"
                                           wrapText="true"
                                           styleClass="dashboard-activity-detail"/>
                                </VBox>

                                <Label text="Yesterday"
                                       styleClass="dashboard-activity-time"/>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" styleClass="dashboard-activity-row">
                                <StackPane styleClass="dashboard-activity-icon-access-box">
                                    <SVGPath content="M8 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 2c-3.31 0-6 1.79-6 4v2h8.1a6.48 6.48 0 0 1-.1-1.1c0-1.9.82-3.61 2.13-4.8A10.6 10.6 0 0 0 8 13zm8.5 0a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9zm-.5 6.7-2.1-2.1 1.06-1.06L16 17.59l2.54-2.55 1.06 1.06-3.6 3.6z"
                                             styleClass="dashboard-activity-icon-access-path"/>
                                </StackPane>

                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Access updated for Building Archive"
                                           styleClass="dashboard-activity-title"/>
                                    <Label text="3 users were assigned scanning access"
                                           wrapText="true"
                                           styleClass="dashboard-activity-detail"/>
                                </VBox>

                                <Label text="2 days ago"
                                       styleClass="dashboard-activity-time"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <VBox spacing="0"
                          maxWidth="Infinity"
                          styleClass="dashboard-section-card">

                        <HBox alignment="CENTER_LEFT"
                              styleClass="dashboard-section-header">
                            <VBox spacing="3">
                                <Label text="Scan Workflow Status" styleClass="dashboard-section-title"/>
                                <Label text="Current processing overview"
                                       styleClass="dashboard-section-subtitle"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="18"
                              styleClass="dashboard-workflow-body">

                            <VBox spacing="8">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="In Progress" styleClass="dashboard-workflow-label"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="inProgressValueLabel" text="18" styleClass="dashboard-workflow-value"/>
                                </HBox>
                                <StackPane alignment="CENTER_LEFT" styleClass="dashboard-progress-track">
                                    <Region fx:id="inProgressBar"
                                            prefWidth="180"
                                            styleClass="dashboard-progress-fill-blue"/>
                                </StackPane>
                            </VBox>

                            <VBox spacing="8">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Waiting for QA" styleClass="dashboard-workflow-label"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="workflowWaitingQaValueLabel" text="8" styleClass="dashboard-workflow-value"/>
                                </HBox>
                                <StackPane alignment="CENTER_LEFT" styleClass="dashboard-progress-track">
                                    <Region fx:id="waitingQaBar"
                                            prefWidth="110"
                                            styleClass="dashboard-progress-fill-amber"/>
                                </StackPane>
                            </VBox>

                            <VBox spacing="8">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Exported" styleClass="dashboard-workflow-label"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="exportedValueLabel" text="31" styleClass="dashboard-workflow-value"/>
                                </HBox>
                                <StackPane alignment="CENTER_LEFT" styleClass="dashboard-progress-track">
                                    <Region fx:id="exportedBar"
                                            prefWidth="240"
                                            styleClass="dashboard-progress-fill-green"/>
                                </StackPane>
                            </VBox>
                        </VBox>
                    </VBox>
                </VBox>

                <VBox spacing="18"
                      prefWidth="430"
                      minWidth="360"
                      maxWidth="430">

                    <VBox spacing="0"
                          maxWidth="Infinity"
                          styleClass="dashboard-section-card">

                        <VBox spacing="15" maxWidth="Infinity">
                            <padding>
                                <Insets top="18" right="18" bottom="18" left="18"/>
                            </padding>

                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <StackPane styleClass="dashboard-summary-icon-red">
                                    <SVGPath content="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 5v6h-2V7h2zm-2 8h2v2h-2v-2z"
                                             styleClass="dashboard-summary-icon-red-path"/>
                                </StackPane>

                                <VBox spacing="3">
                                    <Label text="Needs Attention" styleClass="dashboard-section-title"/>
                                    <Label text="Items requiring follow-up"
                                           styleClass="dashboard-section-subtitle"/>
                                </VBox>

                                <Region HBox.hgrow="ALWAYS"/>

                                <VBox spacing="3" alignment="CENTER_RIGHT">
                                    <Label fx:id="needsAttentionValueLabel"
                                           text="6"
                                           styleClass="dashboard-summary-value"/>
                                    <Label text="Open items"
                                           styleClass="dashboard-summary-subtitle"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <Region styleClass="profile-card-divider"/>

                        <VBox spacing="0" styleClass="dashboard-simple-list">

                            <HBox alignment="CENTER_LEFT" styleClass="dashboard-simple-row">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label fx:id="usersNoProfilesCountLabel"
                                           text="3 users have no profiles"
                                           styleClass="dashboard-simple-title"/>
                                    <Label text="Assign access before scanning"
                                           styleClass="dashboard-simple-detail"/>
                                </VBox>
                                <Button text="Review"
                                        onAction="#manageAccess"
                                        focusTraversable="false"
                                        styleClass="metadata-action-button"/>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" styleClass="dashboard-simple-row">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label fx:id="failedExportsCountLabel"
                                           text="2 failed exports"
                                           styleClass="dashboard-simple-title"/>
                                    <Label text="Missing metadata fields"
                                           styleClass="dashboard-simple-detail"/>
                                </VBox>
                                <Button text="Review"
                                        onAction="#reviewFailedExports"
                                        focusTraversable="false"
                                        styleClass="metadata-action-button"/>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" styleClass="dashboard-simple-row">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label fx:id="draftProfilesCountLabel"
                                           text="1 draft profile"
                                           styleClass="dashboard-simple-title"/>
                                    <Label text="Court Records is not active yet"
                                           styleClass="dashboard-simple-detail"/>
                                </VBox>
                                <Button text="Open"
                                        onAction="#createProfile"
                                        focusTraversable="false"
                                        styleClass="metadata-action-button"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <VBox spacing="0"
                          maxWidth="Infinity"
                          styleClass="dashboard-section-card">

                        <HBox alignment="CENTER_LEFT"
                              styleClass="dashboard-section-header">
                            <VBox spacing="3">
                                <Label text="Quick Actions" styleClass="dashboard-section-title"/>
                                <Label text="Common admin actions"
                                       styleClass="dashboard-section-subtitle"/>
                            </VBox>
                        </HBox>

                        <GridPane hgap="12"
                                  vgap="12"
                                  styleClass="dashboard-actions-grid">

                            <columnConstraints>
                                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Button text="Create User"
                                    onAction="#createUser"
                                    focusTraversable="false"
                                    maxWidth="Infinity"
                                    styleClass="create-user-button"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>

                            <Button text="Create Profile"
                                    onAction="#createProfile"
                                    focusTraversable="false"
                                    maxWidth="Infinity"
                                    styleClass="create-user-button"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>

                            <Button text="Create Metadata Template"
                                    onAction="#createMetadataTemplate"
                                    focusTraversable="false"
                                    maxWidth="Infinity"
                                    styleClass="metadata-secondary-header-button"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"/>

                            <Button text="Manage Access"
                                    onAction="#manageAccess"
                                    focusTraversable="false"
                                    maxWidth="Infinity"
                                    styleClass="metadata-secondary-header-button"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"/>
                        </GridPane>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>