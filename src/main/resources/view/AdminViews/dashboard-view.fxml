<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="easv.gui.controller.admin.DashboardController"
            fitToWidth="true"
            fitToHeight="false"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            minWidth="0"
            minHeight="0"
            maxWidth="Infinity"
            maxHeight="Infinity"
            styleClass="admin-page-scroll">

    <content>
        <VBox spacing="18"
              fillWidth="true"
              minWidth="0"
              minHeight="0"
              maxWidth="Infinity">

            <styleClass>
                <String fx:value="admin-page"/>
                <String fx:value="main-content"/>
                <String fx:value="dashboard-page"/>
            </styleClass>

            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <VBox spacing="3" styleClass="page-heading-copy">
                <Label text="Dashboard" styleClass="page-title"/>
                <Label text="Monitor users, profiles, scans, and system activity."
                       styleClass="page-subtitle"/>
            </VBox>

            <GridPane hgap="18"
                      vgap="18"
                      maxWidth="Infinity"
                      styleClass="dashboard-summary-grid">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                </columnConstraints>

                <HBox spacing="12"
                      alignment="CENTER_LEFT"
                      minWidth="0"
                      maxWidth="Infinity"
                      styleClass="dashboard-stat-card"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="0">

                    <VBox spacing="6"
                          minWidth="0"
                          maxWidth="Infinity"
                          HBox.hgrow="ALWAYS">
                        <Label text="Total Users" styleClass="dashboard-stat-title"/>
                        <Label fx:id="totalUsersValueLabel"
                               text="0"
                               styleClass="dashboard-stat-value"/>
                        <Label text="vs last 7 days" styleClass="dashboard-stat-subtitle"/>
                    </VBox>

                    <VBox spacing="9"
                          alignment="CENTER_RIGHT"
                          styleClass="dashboard-stat-visual">
                        <Label fx:id="totalUsersTrendLabel"
                               text="- 0%"
                               styleClass="dashboard-trend-neutral"/>
                        <SVGPath fx:id="totalUsersSparkline"
                                 content="M0 22 L12 20 L24 21 L36 12 L48 18 L60 8 L72 20 L84 10 L96 13"
                                 styleClass="dashboard-sparkline-teal"/>
                    </VBox>
                </HBox>

                <HBox spacing="12"
                      alignment="CENTER_LEFT"
                      minWidth="0"
                      maxWidth="Infinity"
                      styleClass="dashboard-stat-card"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="0">

                    <VBox spacing="6"
                          minWidth="0"
                          maxWidth="Infinity"
                          HBox.hgrow="ALWAYS">
                        <Label text="Active Profiles" styleClass="dashboard-stat-title"/>
                        <Label fx:id="activeProfilesValueLabel"
                               text="0"
                               styleClass="dashboard-stat-value"/>
                        <Label text="vs last 7 days" styleClass="dashboard-stat-subtitle"/>
                    </VBox>

                    <VBox spacing="9"
                          alignment="CENTER_RIGHT"
                          styleClass="dashboard-stat-visual">
                        <Label fx:id="activeProfilesTrendLabel"
                               text="- 0%"
                               styleClass="dashboard-trend-neutral"/>
                        <SVGPath fx:id="activeProfilesSparkline"
                                 content="M0 23 L12 21 L24 22 L36 15 L48 21 L60 8 L72 20 L84 12 L96 17"
                                 styleClass="dashboard-sparkline-blue"/>
                    </VBox>
                </HBox>

                <HBox spacing="12"
                      alignment="CENTER_LEFT"
                      minWidth="0"
                      maxWidth="Infinity"
                      styleClass="dashboard-stat-card"
                      GridPane.columnIndex="2"
                      GridPane.rowIndex="0">

                    <VBox spacing="6"
                          minWidth="0"
                          maxWidth="Infinity"
                          HBox.hgrow="ALWAYS">
                        <Label text="Scans Today" styleClass="dashboard-stat-title"/>
                        <Label fx:id="scansTodayValueLabel"
                               text="0"
                               styleClass="dashboard-stat-value"/>
                        <Label text="vs yesterday" styleClass="dashboard-stat-subtitle"/>
                    </VBox>

                    <VBox spacing="9"
                          alignment="CENTER_RIGHT"
                          styleClass="dashboard-stat-visual">
                        <Label fx:id="scansTodayTrendLabel"
                               text="- 0%"
                               styleClass="dashboard-trend-neutral"/>
                        <SVGPath fx:id="scansTodaySparkline"
                                 content="M0 23 L12 20 L24 22 L36 18 L48 9 L60 22 L72 18 L84 10 L96 17"
                                 styleClass="dashboard-sparkline-purple"/>
                    </VBox>
                </HBox>

                <HBox spacing="12"
                      alignment="CENTER_LEFT"
                      minWidth="0"
                      maxWidth="Infinity"
                      styleClass="dashboard-stat-card"
                      GridPane.columnIndex="3"
                      GridPane.rowIndex="0">

                    <VBox spacing="6"
                          minWidth="0"
                          maxWidth="Infinity"
                          HBox.hgrow="ALWAYS">
                        <Label text="Waiting for QA" styleClass="dashboard-stat-title"/>
                        <Label fx:id="waitingForQaValueLabel"
                               text="0"
                               styleClass="dashboard-stat-value"/>
                        <Label text="vs yesterday" styleClass="dashboard-stat-subtitle"/>
                    </VBox>

                    <VBox spacing="9"
                          alignment="CENTER_RIGHT"
                          styleClass="dashboard-stat-visual">
                        <Label fx:id="waitingForQaTrendLabel"
                               text="- 0%"
                               styleClass="dashboard-trend-neutral"/>
                        <SVGPath fx:id="waitingForQaSparkline"
                                 content="M0 23 L12 21 L24 22 L36 15 L48 20 L60 9 L72 21 L84 13 L96 18"
                                 styleClass="dashboard-sparkline-orange"/>
                    </VBox>
                </HBox>
            </GridPane>

            <GridPane hgap="18"
                      vgap="18"
                      maxWidth="Infinity"
                      styleClass="dashboard-history-attention-layout">

                <columnConstraints>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                </columnConstraints>

                <VBox spacing="18"
                      minWidth="0"
                      maxWidth="Infinity"
                      styleClass="dashboard-left-stack"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="0">

                    <VBox fx:id="needsAttentionCard"
                          spacing="0"
                          minWidth="0"
                          maxWidth="Infinity">
                        <styleClass>
                            <String fx:value="dashboard-section-card"/>
                            <String fx:value="dashboard-needs-attention-card"/>
                        </styleClass>

                        <VBox spacing="15" maxWidth="Infinity">
                            <padding>
                                <Insets top="18" right="18" bottom="18" left="18"/>
                            </padding>

                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <StackPane styleClass="dashboard-summary-icon-red">
                                    <SVGPath content="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 5v6h-2V7h2zm-2 8h2v2h-2v-2z"
                                             styleClass="dashboard-summary-icon-red-path"/>
                                </StackPane>

                                <VBox spacing="3">
                                    <Label text="Needs Attention" styleClass="dashboard-section-title"/>
                                    <Label text="Items requiring follow-up"
                                           styleClass="dashboard-section-subtitle"/>
                                </VBox>

                                <Region HBox.hgrow="ALWAYS"/>

                                <VBox spacing="3" alignment="CENTER_RIGHT">
                                    <Label fx:id="needsAttentionValueLabel"
                                           text="0"
                                           styleClass="dashboard-summary-value"/>
                                    <Label text="Open items"
                                           styleClass="dashboard-summary-subtitle"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <Region styleClass="profile-card-divider"/>

                        <VBox spacing="0" styleClass="dashboard-simple-list">

                            <HBox fx:id="usersNoProfilesRow"
                                  alignment="CENTER_LEFT"
                                  styleClass="dashboard-simple-row">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label fx:id="usersNoProfilesCountLabel"
                                           text="0 users have no profiles"
                                           styleClass="dashboard-simple-title"/>
                                    <Label text="Assign access before scanning"
                                           styleClass="dashboard-simple-detail"/>
                                </VBox>

                                <Button text="Review"
                                        onAction="#manageAccess"
                                        focusTraversable="false"
                                        styleClass="metadata-action-button"/>
                            </HBox>

                            <HBox fx:id="failedEventsRow"
                                  alignment="CENTER_LEFT"
                                  styleClass="dashboard-simple-row">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label fx:id="failedExportsCountLabel"
                                           text="0 failed events"
                                           styleClass="dashboard-simple-title"/>
                                    <Label text="Check failed system activity"
                                           styleClass="dashboard-simple-detail"/>
                                </VBox>

                                <Button text="Open"
                                        onAction="#viewActivity"
                                        focusTraversable="false"
                                        styleClass="metadata-action-button"/>
                            </HBox>

                            <HBox fx:id="draftProfilesRow"
                                  alignment="CENTER_LEFT"
                                  styleClass="dashboard-simple-row">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label fx:id="draftProfilesCountLabel"
                                           text="0 draft profiles"
                                           styleClass="dashboard-simple-title"/>
                                    <Label text="Court Records is not active yet"
                                           styleClass="dashboard-simple-detail"/>
                                </VBox>

                                <Button text="Open"
                                        onAction="#createProfile"
                                        focusTraversable="false"
                                        styleClass="metadata-action-button"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <VBox spacing="0"
                          minWidth="0"
                          maxWidth="Infinity">
                        <styleClass>
                            <String fx:value="dashboard-section-card"/>
                            <String fx:value="dashboard-workflow-overview-card"/>
                        </styleClass>

                        <HBox alignment="CENTER_LEFT">
                            <styleClass>
                                <String fx:value="dashboard-section-header"/>
                                <String fx:value="dashboard-workflow-header"/>
                            </styleClass>

                            <VBox spacing="3">
                                <Label text="Scan Workflow Status" styleClass="dashboard-section-title"/>
                                <Label text="Current processing overview"
                                       styleClass="dashboard-section-subtitle"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="18"
                              alignment="CENTER_LEFT"
                              maxWidth="Infinity"
                              styleClass="dashboard-workflow-status-body">

                            <StackPane fx:id="workflowDonutChart"
                                       styleClass="dashboard-donut-chart"/>

                            <VBox spacing="6"
                                  minWidth="0"
                                  maxWidth="Infinity"
                                  HBox.hgrow="ALWAYS"
                                  styleClass="dashboard-workflow-legend">

                                <HBox alignment="CENTER_LEFT"
                                      spacing="9"
                                      styleClass="dashboard-workflow-legend-row">
                                    <Region styleClass="dashboard-workflow-marker-blue"/>
                                    <Label text="In Progress" styleClass="dashboard-workflow-label"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="inProgressValueLabel"
                                           text="0"
                                           styleClass="dashboard-workflow-value"/>
                                    <Label fx:id="inProgressPercentLabel"
                                           text="0%"
                                           styleClass="dashboard-workflow-percent"/>
                                </HBox>

                                <HBox alignment="CENTER_LEFT"
                                      spacing="9"
                                      styleClass="dashboard-workflow-legend-row">
                                    <Region styleClass="dashboard-workflow-marker-amber"/>
                                    <Label text="Waiting for QA" styleClass="dashboard-workflow-label"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="workflowWaitingQaValueLabel"
                                           text="0"
                                           styleClass="dashboard-workflow-value"/>
                                    <Label fx:id="waitingQaPercentLabel"
                                           text="0%"
                                           styleClass="dashboard-workflow-percent"/>
                                </HBox>

                                <HBox alignment="CENTER_LEFT"
                                      spacing="9"
                                      styleClass="dashboard-workflow-legend-row">
                                    <Region styleClass="dashboard-workflow-marker-green"/>
                                    <Label text="Exported" styleClass="dashboard-workflow-label"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="exportedValueLabel"
                                           text="0"
                                           styleClass="dashboard-workflow-value"/>
                                    <Label fx:id="exportedPercentLabel"
                                           text="0%"
                                           styleClass="dashboard-workflow-percent"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

                <VBox spacing="0"
                      minWidth="0"
                      maxWidth="Infinity"
                      styleClass="dashboard-recent-activity-card"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="0">
                    <styleClass>
                        <String fx:value="dashboard-section-card"/>
                        <String fx:value="dashboard-recent-activity-card"/>
                    </styleClass>

                    <HBox alignment="CENTER_LEFT"
                          styleClass="dashboard-section-header">

                        <VBox spacing="3">
                            <Label text="Recent Activity" styleClass="dashboard-section-title"/>
                            <Label text="Latest important system events"
                                   styleClass="dashboard-section-subtitle"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="View All"
                                onAction="#viewActivity"
                                focusTraversable="false"
                                styleClass="metadata-action-button"/>
                    </HBox>

                    <VBox fx:id="recentActivityList"
                          spacing="0"
                          styleClass="dashboard-activity-list"/>
                </VBox>
            </GridPane>
        </VBox>
    </content>
</ScrollPane>
