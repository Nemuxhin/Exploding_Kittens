<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="easv.gui.controller.admin.DashboardController"
            fitToWidth="true"
            fitToHeight="false"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            minWidth="0"
            minHeight="0"
            maxWidth="Infinity"
            maxHeight="Infinity"
            styleClass="admin-page-scroll">

    <content>
        <VBox spacing="18"
              fillWidth="true"
              minWidth="0"
              minHeight="0"
              maxWidth="Infinity">

            <styleClass>
                <String fx:value="admin-page"/>
                <String fx:value="main-content"/>
                <String fx:value="dashboard-page"/>
            </styleClass>

            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3" styleClass="page-heading-copy" HBox.hgrow="ALWAYS">
                    <Label text="Dashboard" styleClass="page-title"/>
                    <Label text="Monitor system health and operational activity."
                           styleClass="page-subtitle"/>
                </VBox>

                <HBox alignment="CENTER_RIGHT"
                      spacing="6"
                      styleClass="dashboard-last-updated">
                    <Label text="&#xe938;" styleClass="prime-icon dashboard-last-updated-icon"/>
                    <Label fx:id="lastUpdatedLabel"
                           text="Last updated: --:--"
                           styleClass="dashboard-last-updated-text"/>
                </HBox>
            </HBox>

            <VBox fx:id="needsAttentionCard"
                  spacing="0"
                  minWidth="0"
                  maxWidth="Infinity">
                <styleClass>
                    <String fx:value="dashboard-section-card"/>
                    <String fx:value="dashboard-needs-attention-card"/>
                </styleClass>

                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="dashboard-needs-attention-header">
                    <StackPane styleClass="dashboard-summary-icon-red">
                        <Label text="&#xe922;" styleClass="prime-icon dashboard-summary-icon-red-path"/>
                    </StackPane>

                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Needs attention" styleClass="dashboard-section-title"/>
                        <Label text="Items that require your action"
                               styleClass="dashboard-section-subtitle"/>
                    </VBox>

                    <Button text="View all  &#x203A;"
                            onAction="#viewAllAttention"
                            focusTraversable="false"
                            styleClass="dashboard-view-all-link"/>
                </HBox>

                <VBox spacing="0" styleClass="dashboard-attention-list">

                    <HBox fx:id="usersNoProfilesRow"
                          alignment="CENTER_LEFT"
                          spacing="15"
                          styleClass="dashboard-attention-row">
                        <Region styleClass="dashboard-attention-dot-red"/>

                        <Label fx:id="usersNoProfilesCountLabel"
                               text="0 users have no profiles"
                               styleClass="dashboard-attention-title"
                               minWidth="220"
                               prefWidth="240"/>

                        <Label text="Assign access before scanning"
                               styleClass="dashboard-attention-detail"
                               HBox.hgrow="ALWAYS"
                               maxWidth="Infinity"/>

                        <Button text="Review  &#x203A;"
                                onAction="#manageAccess"
                                focusTraversable="false"
                                styleClass="dashboard-row-action-link"/>
                    </HBox>

                    <HBox fx:id="failedEventsRow"
                          alignment="CENTER_LEFT"
                          spacing="15"
                          styleClass="dashboard-attention-row">
                        <Region styleClass="dashboard-attention-dot-red"/>

                        <Label fx:id="failedExportsCountLabel"
                               text="0 failed events"
                               styleClass="dashboard-attention-title"
                               minWidth="220"
                               prefWidth="240"/>

                        <Label text="Check failed system activity"
                               styleClass="dashboard-attention-detail"
                               HBox.hgrow="ALWAYS"
                               maxWidth="Infinity"/>

                        <Button text="Review  &#x203A;"
                                onAction="#reviewFailedExports"
                                focusTraversable="false"
                                styleClass="dashboard-row-action-link"/>
                    </HBox>

                    <HBox fx:id="draftProfilesRow"
                          alignment="CENTER_LEFT"
                          spacing="15"
                          styleClass="dashboard-attention-row">
                        <Region styleClass="dashboard-attention-dot-amber"/>

                        <Label fx:id="draftProfilesCountLabel"
                               text="0 draft profiles"
                               styleClass="dashboard-attention-title"
                               minWidth="220"
                               prefWidth="240"/>

                        <Label text="Profiles not active"
                               styleClass="dashboard-attention-detail"
                               HBox.hgrow="ALWAYS"
                               maxWidth="Infinity"/>

                        <Button text="Open  &#x203A;"
                                onAction="#createProfile"
                                focusTraversable="false"
                                styleClass="dashboard-row-action-link"/>
                    </HBox>
                </VBox>
            </VBox>

            <GridPane hgap="18"
                      vgap="18"
                      maxWidth="Infinity"
                      styleClass="dashboard-history-attention-layout">

                <columnConstraints>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                </columnConstraints>

                <VBox spacing="0"
                      minWidth="0"
                      maxWidth="Infinity"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="0">
                    <styleClass>
                        <String fx:value="dashboard-section-card"/>
                        <String fx:value="dashboard-system-overview-card"/>
                    </styleClass>

                    <VBox spacing="3" styleClass="dashboard-overview-header">
                        <Label text="System overview" styleClass="dashboard-section-title"/>
                    </VBox>

                    <Region styleClass="dashboard-card-divider"/>

                    <HBox spacing="6"
                          alignment="TOP_LEFT"
                          maxWidth="Infinity"
                          styleClass="dashboard-overview-body">

                        <VBox spacing="4"
                              alignment="TOP_LEFT"
                              HBox.hgrow="ALWAYS"
                              styleClass="dashboard-overview-stat">
                            <Label text="&#xe941;" styleClass="prime-icon dashboard-overview-stat-icon"/>
                            <Label text="Users" styleClass="dashboard-overview-stat-label"/>
                            <Label fx:id="totalUsersValueLabel"
                                   text="0"
                                   styleClass="dashboard-overview-stat-value"/>
                            <Label fx:id="totalUsersTrendLabel"
                                   text="- vs last 7 days"
                                   styleClass="dashboard-overview-stat-trend dashboard-trend-neutral"/>
                        </VBox>

                        <VBox spacing="4"
                              alignment="TOP_LEFT"
                              HBox.hgrow="ALWAYS"
                              styleClass="dashboard-overview-stat">
                            <Label text="&#xe958;" styleClass="prime-icon dashboard-overview-stat-icon"/>
                            <Label text="Profiles" styleClass="dashboard-overview-stat-label"/>
                            <Label fx:id="activeProfilesValueLabel"
                                   text="0"
                                   styleClass="dashboard-overview-stat-value"/>
                            <Label fx:id="activeProfilesTrendLabel"
                                   text="- vs last 7 days"
                                   styleClass="dashboard-overview-stat-trend dashboard-trend-neutral"/>
                        </VBox>

                        <VBox spacing="4"
                              alignment="TOP_LEFT"
                              HBox.hgrow="ALWAYS"
                              styleClass="dashboard-overview-stat">
                            <Label text="&#xe9e4;" styleClass="prime-icon dashboard-overview-stat-icon"/>
                            <Label text="Scans today" styleClass="dashboard-overview-stat-label"/>
                            <Label fx:id="scansTodayValueLabel"
                                   text="0"
                                   styleClass="dashboard-overview-stat-value"/>
                            <Label fx:id="scansTodayTrendLabel"
                                   text="- vs yesterday"
                                   styleClass="dashboard-overview-stat-trend dashboard-trend-neutral"/>
                        </VBox>

                        <VBox spacing="4"
                              alignment="TOP_LEFT"
                              HBox.hgrow="ALWAYS"
                              styleClass="dashboard-overview-stat">
                            <Label text="&#xe981;" styleClass="prime-icon dashboard-overview-stat-icon"/>
                            <Label text="QA waiting" styleClass="dashboard-overview-stat-label"/>
                            <Label fx:id="waitingForQaValueLabel"
                                   text="0"
                                   styleClass="dashboard-overview-stat-value"/>
                            <Label fx:id="waitingForQaTrendLabel"
                                   text="- vs yesterday"
                                   styleClass="dashboard-overview-stat-trend dashboard-trend-neutral"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox spacing="0"
                      minWidth="0"
                      maxWidth="Infinity"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="0">
                    <styleClass>
                        <String fx:value="dashboard-section-card"/>
                        <String fx:value="dashboard-recent-activity-card"/>
                    </styleClass>

                    <HBox alignment="CENTER_LEFT" styleClass="dashboard-section-header">
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Recent important activity" styleClass="dashboard-section-title"/>
                        </VBox>

                        <Button text="View all  &#x203A;"
                                onAction="#viewActivity"
                                focusTraversable="false"
                                styleClass="dashboard-view-all-link"/>
                    </HBox>

                    <VBox fx:id="recentActivityList"
                          spacing="0"
                          styleClass="dashboard-activity-list"/>
                </VBox>
            </GridPane>
        </VBox>
    </content>
</ScrollPane>
