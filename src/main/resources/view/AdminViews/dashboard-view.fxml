<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="easv.gui.controller.admin.DashboardController"
            fitToWidth="true"
            fitToHeight="false"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            minWidth="0"
            minHeight="0"
            maxWidth="Infinity"
            maxHeight="Infinity"
            styleClass="admin-page-scroll">

    <content>
        <VBox spacing="18"
              fillWidth="true"
              minWidth="0"
              minHeight="0"
              maxWidth="Infinity">

            <styleClass>
                <String fx:value="admin-page"/>
                <String fx:value="main-content"/>
                <String fx:value="dashboard-page"/>
            </styleClass>

            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <VBox spacing="3" styleClass="page-heading-copy">
                <Label text="Dashboard" styleClass="page-title"/>
                <Label text="Monitor users, profiles, scans, and system activity."
                       styleClass="page-subtitle"/>
            </VBox>

            <GridPane hgap="18"
                      vgap="18"
                      maxWidth="Infinity"
                      styleClass="dashboard-summary-grid">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                </columnConstraints>

                <HBox spacing="15"
                      alignment="CENTER_LEFT"
                      minWidth="0"
                      maxWidth="Infinity"
                      styleClass="dashboard-stat-card"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="0">

                    <StackPane styleClass="dashboard-summary-icon-purple">
                        <Label text="&#xe939;" styleClass="prime-icon dashboard-summary-icon-purple-path"/>
                    </StackPane>

                    <VBox spacing="3"
                          minWidth="0"
                          maxWidth="Infinity"
                          HBox.hgrow="ALWAYS">
                        <Label text="Total users" styleClass="dashboard-stat-title"/>
                        <Label fx:id="totalUsersValueLabel"
                               text="0"
                               styleClass="dashboard-stat-value"/>
                        <Label fx:id="totalUsersTrendLabel"
                               text="vs last 7 days"
                               styleClass="dashboard-trend-neutral"/>
                    </VBox>
                </HBox>

                <HBox spacing="15"
                      alignment="CENTER_LEFT"
                      minWidth="0"
                      maxWidth="Infinity"
                      styleClass="dashboard-stat-card"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="0">

                    <StackPane styleClass="dashboard-summary-icon-indigo">
                        <Label text="&#xe941;" styleClass="prime-icon dashboard-summary-icon-indigo-path"/>
                    </StackPane>

                    <VBox spacing="3"
                          minWidth="0"
                          maxWidth="Infinity"
                          HBox.hgrow="ALWAYS">
                        <Label text="Active profiles" styleClass="dashboard-stat-title"/>
                        <Label fx:id="activeProfilesValueLabel"
                               text="0"
                               styleClass="dashboard-stat-value"/>
                        <Label fx:id="activeProfilesTrendLabel"
                               text="vs last 7 days"
                               styleClass="dashboard-trend-neutral"/>
                    </VBox>
                </HBox>

                <HBox spacing="15"
                      alignment="CENTER_LEFT"
                      minWidth="0"
                      maxWidth="Infinity"
                      styleClass="dashboard-stat-card"
                      GridPane.columnIndex="2"
                      GridPane.rowIndex="0">

                    <StackPane styleClass="dashboard-summary-icon-green">
                        <Label text="&#xe958;" styleClass="prime-icon dashboard-summary-icon-green-path"/>
                    </StackPane>

                    <VBox spacing="3"
                          minWidth="0"
                          maxWidth="Infinity"
                          HBox.hgrow="ALWAYS">
                        <Label text="Scans today" styleClass="dashboard-stat-title"/>
                        <Label fx:id="scansTodayValueLabel"
                               text="0"
                               styleClass="dashboard-stat-value"/>
                        <Label fx:id="scansTodayTrendLabel"
                               text="vs yesterday"
                               styleClass="dashboard-trend-neutral"/>
                    </VBox>
                </HBox>

                <HBox spacing="15"
                      alignment="CENTER_LEFT"
                      minWidth="0"
                      maxWidth="Infinity"
                      styleClass="dashboard-stat-card"
                      GridPane.columnIndex="3"
                      GridPane.rowIndex="0">

                    <StackPane styleClass="dashboard-summary-icon-amber">
                        <Label text="&#xe90a;" styleClass="prime-icon dashboard-summary-icon-amber-path"/>
                    </StackPane>

                    <VBox spacing="3"
                          minWidth="0"
                          maxWidth="Infinity"
                          HBox.hgrow="ALWAYS">
                        <Label text="Waiting for QA" styleClass="dashboard-stat-title"/>
                        <Label fx:id="waitingForQaValueLabel"
                               text="0"
                               styleClass="dashboard-stat-value"/>
                        <Label fx:id="waitingForQaTrendLabel"
                               text="vs yesterday"
                               styleClass="dashboard-trend-neutral"/>
                    </VBox>
                </HBox>
            </GridPane>

            <GridPane hgap="18"
                      vgap="18"
                      maxWidth="Infinity"
                      styleClass="dashboard-history-attention-layout">

                <columnConstraints>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                </columnConstraints>

                <VBox spacing="18"
                      minWidth="0"
                      maxWidth="Infinity"
                      styleClass="dashboard-left-stack"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="0">

                    <VBox fx:id="needsAttentionCard"
                          spacing="0"
                          minWidth="0"
                          maxWidth="Infinity">
                        <styleClass>
                            <String fx:value="dashboard-section-card"/>
                            <String fx:value="dashboard-needs-attention-card"/>
                        </styleClass>

                        <VBox spacing="15" maxWidth="Infinity">
                            <padding>
                                <Insets top="18" right="18" bottom="18" left="18"/>
                            </padding>

                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <StackPane styleClass="dashboard-summary-icon-red">
                                    <Label text="&#xe922;" styleClass="prime-icon dashboard-summary-icon-red-path"/>
                                </StackPane>

                                <VBox spacing="3">
                                    <Label text="Needs Attention" styleClass="dashboard-section-title"/>
                                    <Label text="Items requiring follow-up"
                                           styleClass="dashboard-section-subtitle"/>
                                </VBox>

                                <Region HBox.hgrow="ALWAYS"/>

                                <VBox spacing="3" alignment="CENTER_RIGHT">
                                    <Label fx:id="needsAttentionValueLabel"
                                           text="0"
                                           styleClass="dashboard-summary-value"/>
                                    <Label text="Open items"
                                           styleClass="dashboard-summary-subtitle"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <Region styleClass="profile-card-divider"/>

                        <VBox spacing="0" styleClass="dashboard-simple-list">

                            <HBox fx:id="usersNoProfilesRow"
                                  alignment="CENTER_LEFT"
                                  styleClass="dashboard-simple-row">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label fx:id="usersNoProfilesCountLabel"
                                           text="0 users have no profiles"
                                           styleClass="dashboard-simple-title"/>
                                    <Label text="Assign access before scanning"
                                           styleClass="dashboard-simple-detail"/>
                                </VBox>

                                <Button text="Review"
                                        onAction="#manageAccess"
                                        focusTraversable="false"
                                        styleClass="inline-action-button"/>
                            </HBox>

                            <HBox fx:id="failedEventsRow"
                                  alignment="CENTER_LEFT"
                                  styleClass="dashboard-simple-row">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label fx:id="failedExportsCountLabel"
                                           text="0 failed events"
                                           styleClass="dashboard-simple-title"/>
                                    <Label text="Check failed system activity"
                                           styleClass="dashboard-simple-detail"/>
                                </VBox>

                                <Button text="Review"
                                        onAction="#reviewFailedExports"
                                        focusTraversable="false"
                                        styleClass="inline-action-button"/>
                            </HBox>

                            <HBox fx:id="draftProfilesRow"
                                  alignment="CENTER_LEFT"
                                  styleClass="dashboard-simple-row">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label fx:id="draftProfilesCountLabel"
                                           text="0 draft profiles"
                                           styleClass="dashboard-simple-title"/>
                                    <Label text="Court Records is not active yet"
                                           styleClass="dashboard-simple-detail"/>
                                </VBox>

                                <Button text="Open"
                                        onAction="#createProfile"
                                        focusTraversable="false"
                                        styleClass="inline-action-button"/>
                            </HBox>
                        </VBox>
                    </VBox>

                </VBox>

                <VBox spacing="0"
                      minWidth="0"
                      maxWidth="Infinity"
                      styleClass="dashboard-recent-activity-card"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="0">
                    <styleClass>
                        <String fx:value="dashboard-section-card"/>
                        <String fx:value="dashboard-recent-activity-card"/>
                    </styleClass>

                    <HBox alignment="CENTER_LEFT"
                          styleClass="dashboard-section-header">

                        <VBox spacing="3">
                            <Label text="Recent Activity" styleClass="dashboard-section-title"/>
                            <Label text="Latest important system events"
                                   styleClass="dashboard-section-subtitle"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <ComboBox fx:id="recentActivityFilterComboBox"
                                  styleClass="role-filter"/>

                        <Button text="View All"
                                onAction="#viewActivity"
                                focusTraversable="false"
                                styleClass="inline-action-button"/>
                    </HBox>

                    <VBox fx:id="recentActivityList"
                          spacing="0"
                          styleClass="dashboard-activity-list"/>
                </VBox>
            </GridPane>
        </VBox>
    </content>
</ScrollPane>
