<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="easv.gui.controller.admin.ActivityController"
            fitToWidth="true"
            fitToHeight="false"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            minWidth="0"
            minHeight="0"
            maxWidth="Infinity"
            maxHeight="Infinity"
            styleClass="admin-page-scroll">

    <content>
        <VBox spacing="18"
              fillWidth="true"
              minWidth="0"
              minHeight="0"
              maxWidth="Infinity"
              maxHeight="Infinity"
              styleClass="admin-page main-content activity-log-page">

            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <HBox alignment="CENTER_LEFT"
                  maxWidth="Infinity"
                  styleClass="page-header">

                <VBox spacing="3" styleClass="page-heading-copy">
                    <Label text="Activity Log" styleClass="page-title"/>
                    <Label text="Track user actions, profile changes, scans, QA, and exports."
                           styleClass="page-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Export Log"
                        onAction="#exportActivityLog"
                        styleClass="secondary-outline-button"
                        focusTraversable="false"/>
            </HBox>

            <GridPane hgap="15"
                      vgap="15"
                      maxWidth="Infinity"
                      styleClass="activity-log-summary-grid">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                </columnConstraints>

                <HBox alignment="CENTER_LEFT"
                      maxWidth="Infinity"
                      onMouseClicked="#showTodayActivity"
                      styleClass="activity-log-summary-card"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="0">

                    <StackPane styleClass="activity-log-summary-icon-shell activity-log-icon-system">
                        <SVGPath content="M4 4h16v16H4V4zm2 2v12h12V6H6zm2 2h8v2H8V8zm0 4h5v2H8v-2z"
                                 styleClass="activity-log-summary-icon"/>
                    </StackPane>

                    <VBox spacing="3">
                        <Label text="Today’s Activity" styleClass="activity-log-summary-title"/>
                        <Label fx:id="todayEventsValueLabel"
                               text="0 events"
                               styleClass="activity-log-summary-value"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT"
                      maxWidth="Infinity"
                      onMouseClicked="#showScansOnly"
                      styleClass="activity-log-summary-card"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="0">

                    <StackPane styleClass="activity-log-summary-icon-shell activity-log-icon-scan">
                        <SVGPath content="M5 3h14v18H5V3zm2 2v14h10V5H7zm2 3h6v2H9V8zm0 4h6v2H9v-2z"
                                 styleClass="activity-log-summary-icon"/>
                    </StackPane>

                    <VBox spacing="3">
                        <Label text="Scans Completed" styleClass="activity-log-summary-title"/>
                        <Label fx:id="scansCompletedValueLabel"
                               text="0"
                               styleClass="activity-log-summary-value"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT"
                      maxWidth="Infinity"
                      onMouseClicked="#showQaCompleted"
                      styleClass="activity-log-summary-card"
                      GridPane.columnIndex="2"
                      GridPane.rowIndex="0">

                    <StackPane styleClass="activity-log-summary-icon-shell activity-log-icon-qa">
                        <SVGPath content="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3zm-1 14-4-4 1.4-1.4L11 13.2l5.6-5.6L18 9l-7 7z"
                                 styleClass="activity-log-summary-icon"/>
                    </StackPane>

                    <VBox spacing="3">
                        <Label text="QA Completed" styleClass="activity-log-summary-title"/>
                        <Label fx:id="qaCompletedValueLabel"
                               text="0"
                               styleClass="activity-log-summary-value"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT"
                      maxWidth="Infinity"
                      onMouseClicked="#showFailedEvents"
                      styleClass="activity-log-summary-card"
                      GridPane.columnIndex="3"
                      GridPane.rowIndex="0">

                    <StackPane styleClass="activity-log-summary-icon-shell activity-log-icon-failed">
                        <SVGPath content="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 15h-2v-2h2v2zm0-4h-2V6h2v7z"
                                 styleClass="activity-log-summary-icon"/>
                    </StackPane>

                    <VBox spacing="3">
                        <Label text="Failed Events" styleClass="activity-log-summary-title"/>
                        <Label fx:id="failedEventsValueLabel"
                               text="0"
                               styleClass="activity-log-summary-value"/>
                    </VBox>
                </HBox>
            </GridPane>

            <HBox spacing="12"
                  alignment="CENTER_LEFT"
                  maxWidth="Infinity"
                  styleClass="activity-log-toolbar">

                <HBox styleClass="search-field-shell"
                      maxWidth="Infinity"
                      HBox.hgrow="ALWAYS">

                    <StackPane styleClass="field-icon-shell">
                        <SVGPath content="M15.78 14.36h-.75l-.26-.25a6.64 6.64 0 1 0-.66.66l.25.26v.75l4.72 4.71 1.41-1.41-4.71-4.72zM9.5 14A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14z"
                                 styleClass="field-icon-path"/>
                    </StackPane>

                    <TextField fx:id="searchField"
                               promptText="Search activity..."
                               styleClass="search-field-input"
                               maxWidth="Infinity"
                               HBox.hgrow="ALWAYS"/>
                </HBox>

                <ComboBox fx:id="typeFilterComboBox"
                          styleClass="activity-log-filter"/>

                <ComboBox fx:id="userFilterComboBox"
                          styleClass="activity-log-filter"/>

                <ComboBox fx:id="statusFilterComboBox"
                          styleClass="activity-log-filter"/>

                <ComboBox fx:id="dateRangeFilterComboBox"
                          styleClass="activity-log-filter"/>
            </HBox>

            <VBox spacing="0"
                  maxWidth="Infinity"
                  styleClass="activity-log-timeline-card">

                <VBox fx:id="timelineContainer"
                      spacing="0"
                      fillWidth="true"
                      maxWidth="Infinity"
                      styleClass="activity-log-timeline"/>

                <VBox fx:id="emptyStateBox"
                      spacing="9"
                      visible="false"
                      managed="false"
                      maxWidth="Infinity"
                      styleClass="activity-log-empty-state">

                    <Label text="No activity found" styleClass="empty-state-title"/>
                    <Label text="Try changing filters or searching for a different user, box, profile, or action."
                           styleClass="empty-state-copy"/>

                    <Button text="Clear Filters"
                            onAction="#clearFilters"
                            styleClass="create-user-button"
                            focusTraversable="false"/>
                </VBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>