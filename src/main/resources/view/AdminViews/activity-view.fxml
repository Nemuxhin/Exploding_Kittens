<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CustomMenuItem?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="easv.gui.controller.admin.ActivityController"
            fitToWidth="true"
            fitToHeight="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            minWidth="0"
            minHeight="0"
            maxWidth="Infinity"
            maxHeight="Infinity"
            styleClass="admin-page-scroll">

    <content>
        <VBox fx:id="logsPageRoot"
              spacing="18"
              fillWidth="true"
              minWidth="0"
              minHeight="0"
              maxWidth="Infinity"
              maxHeight="Infinity">

            <styleClass>
                <String fx:value="admin-page"/>
                <String fx:value="main-content"/>
                <String fx:value="activity-log-page"/>
                <String fx:value="logs-page"/>
            </styleClass>

            <padding>
                <Insets top="30" right="24" bottom="24" left="24"/>
            </padding>

            <VBox spacing="3" styleClass="page-heading-copy">
                <Label text="Logs" styleClass="logs-title"/>
                <Label text="TIFF activity, QA, users, imports, exports, and system events"
                       styleClass="logs-subtitle"/>
            </VBox>

            <HBox spacing="12"
                  alignment="CENTER_LEFT"
                  maxWidth="Infinity"
                  styleClass="logs-toolbar">

                <HBox fx:id="searchBox"
                      prefWidth="315"
                      minWidth="255"
                      maxWidth="315"
                      styleClass="logs-search">

                    <StackPane styleClass="field-icon-shell">
                        <Label text="&#xe908;" styleClass="prime-icon field-icon-path"/>
                    </StackPane>

                    <TextField fx:id="searchField"
                               promptText="Search logs, users, actions..."
                               styleClass="search-field-input"
                               maxWidth="Infinity"
                               HBox.hgrow="ALWAYS"/>
                </HBox>

                <MenuButton fx:id="dateFilterMenuButton"
                            text="Date &amp; Time"
                            prefWidth="153"
                            minWidth="153"
                            maxWidth="153"
                            styleClass="logs-date-filter">

                    <items>
                        <CustomMenuItem hideOnClick="false">
                            <content>
                                <VBox spacing="12" styleClass="logs-date-popover">

                                    <GridPane hgap="9" vgap="6">
                                        <Label text="From date"
                                               GridPane.rowIndex="0"
                                               GridPane.columnIndex="0"
                                               styleClass="logs-date-label"/>

                                        <Label text="To date"
                                               GridPane.rowIndex="0"
                                               GridPane.columnIndex="1"
                                               styleClass="logs-date-label"/>

                                        <DatePicker fx:id="rangeStartDatePicker"
                                                    editable="false"
                                                    prefWidth="102"
                                                    GridPane.rowIndex="1"
                                                    GridPane.columnIndex="0"
                                                    styleClass="logs-popover-date-picker"/>

                                        <DatePicker fx:id="rangeEndDatePicker"
                                                    editable="false"
                                                    prefWidth="102"
                                                    GridPane.rowIndex="1"
                                                    GridPane.columnIndex="1"
                                                    styleClass="logs-popover-date-picker"/>

                                        <Label text="From time"
                                               GridPane.rowIndex="2"
                                               GridPane.columnIndex="0"
                                               styleClass="logs-date-label"/>

                                        <Label text="To time"
                                               GridPane.rowIndex="2"
                                               GridPane.columnIndex="1"
                                               styleClass="logs-date-label"/>

                                        <TextField fx:id="rangeStartTimeField"
                                                   promptText="HH:mm:ss"
                                                   prefWidth="102"
                                                   GridPane.rowIndex="3"
                                                   GridPane.columnIndex="0"
                                                   styleClass="logs-popover-time-field"/>

                                        <TextField fx:id="rangeEndTimeField"
                                                   promptText="HH:mm:ss"
                                                   prefWidth="102"
                                                   GridPane.rowIndex="3"
                                                   GridPane.columnIndex="1"
                                                   styleClass="logs-popover-time-field"/>
                                    </GridPane>

                                    <VBox spacing="9" styleClass="logs-calendar-panel">
                                        <HBox alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="logs-calendar-header">
                                            <Button text="&lt;"
                                                    onAction="#showPreviousCalendarMonth"
                                                    focusTraversable="false"
                                                    styleClass="logs-calendar-nav-button"/>

                                            <Region HBox.hgrow="ALWAYS"/>

                                            <Label fx:id="dateCalendarMonthLabel"
                                                   text="July 2025"
                                                   styleClass="logs-calendar-month-label"/>

                                            <Region HBox.hgrow="ALWAYS"/>

                                            <Button text="&gt;"
                                                    onAction="#showNextCalendarMonth"
                                                    focusTraversable="false"
                                                    styleClass="logs-calendar-nav-button"/>
                                        </HBox>

                                        <GridPane fx:id="dateCalendarGrid"
                                                  hgap="0"
                                                  vgap="0"
                                                  maxWidth="Infinity"
                                                  styleClass="logs-calendar-grid"/>
                                    </VBox>

                                    <HBox spacing="9" alignment="CENTER_RIGHT">
                                        <Button text="Clear"
                                                onAction="#clearDateFilter"
                                                styleClass="logs-date-clear-button"
                                                focusTraversable="false"/>

                                        <Button text="Apply"
                                                onAction="#applyDateFilter"
                                                styleClass="logs-date-apply-button"
                                                focusTraversable="false"/>
                                    </HBox>
                                </VBox>
                            </content>
                        </CustomMenuItem>
                    </items>
                </MenuButton>

                <MenuButton fx:id="statusMenuButton"
                            prefWidth="132"
                            minWidth="132"
                            maxWidth="132"
                            styleClass="logs-filter"/>

                <MenuButton fx:id="filtersMenuButton"
                            prefWidth="120"
                            minWidth="120"
                            maxWidth="120"
                            styleClass="logs-filter"/>

                <MenuButton fx:id="sortMenuButton"
                            prefWidth="159"
                            minWidth="159"
                            maxWidth="159"
                            styleClass="logs-filter"/>

                <Button text="Clear"
                        onAction="#clearFilters"
                        minWidth="54"
                        prefWidth="54"
                        maxWidth="54"
                        styleClass="logs-clear-button"
                        focusTraversable="false"/>

                <Button text="Export"
                        onAction="#exportLogs"
                        minWidth="120"
                        prefWidth="120"
                        maxWidth="120"
                        styleClass="logs-export-button"
                        focusTraversable="false">
                    <graphic>
                        <Label text="&#xe956;" styleClass="prime-icon logs-export-icon"/>
                    </graphic>
                </Button>
            </HBox>

            <HBox alignment="CENTER_LEFT"
                  maxWidth="Infinity"
                  styleClass="logs-count-row">
                <Label fx:id="logsShowingLabel"
                       text="Showing 0 events"
                       styleClass="logs-showing-label"/>
            </HBox>

            <VBox spacing="0"
                  fillWidth="true"
                  maxWidth="Infinity"
                  VBox.vgrow="ALWAYS"
                  styleClass="logs-content">

                <VBox fx:id="timelineContainer"
                      spacing="0"
                      fillWidth="true"
                      maxWidth="Infinity"
                      styleClass="logs-event-stream"
                      VBox.vgrow="ALWAYS"/>
            </VBox>

            <VBox fx:id="emptyStateBox"
                  spacing="9"
                  visible="false"
                  managed="false"
                  maxWidth="Infinity"
                  styleClass="activity-log-empty-state">

                <Label text="No logs found" styleClass="empty-state-title"/>
                <Label text="Try changing filters or searching for a different user, box, profile, or action."
                       styleClass="empty-state-copy"/>

                <Button text="Clear filters"
                        onAction="#clearFilters"
                        styleClass="create-user-button"
                        focusTraversable="false"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
