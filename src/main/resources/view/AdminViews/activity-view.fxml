<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.CustomMenuItem?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="easv.gui.controller.admin.ActivityController"
            fitToWidth="true"
            fitToHeight="false"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            minWidth="0"
            minHeight="0"
            maxWidth="Infinity"
            maxHeight="Infinity"
            styleClass="admin-page-scroll">

    <content>
        <VBox fx:id="logsPageRoot"
              spacing="18"
              fillWidth="true"
              minWidth="0"
              minHeight="0"
              maxWidth="Infinity"
              maxHeight="Infinity">

            <styleClass>
                <String fx:value="admin-page"/>
                <String fx:value="main-content"/>
                <String fx:value="activity-log-page"/>
                <String fx:value="logs-page"/>
            </styleClass>

            <padding>
                <Insets top="30" right="24" bottom="24" left="24"/>
            </padding>

            <VBox spacing="3" styleClass="page-heading-copy">
                <Label text="Logs" styleClass="logs-title"/>
                <Label text="TIFF activity, QA, users, imports, exports, and system events"
                       styleClass="logs-subtitle"/>
            </VBox>

            <HBox spacing="12"
                  alignment="CENTER_LEFT"
                  maxWidth="Infinity"
                  styleClass="logs-toolbar">

                <HBox prefWidth="315"
                      minWidth="315"
                      maxWidth="315"
                      styleClass="logs-search">

                    <StackPane styleClass="field-icon-shell">
                        <Label text="&#xe908;" styleClass="prime-icon field-icon-path"/>
                    </StackPane>

                    <TextField fx:id="searchField"
                               promptText="Search logs..."
                               styleClass="search-field-input"
                               maxWidth="Infinity"
                               HBox.hgrow="ALWAYS"/>
                </HBox>

                <ComboBox fx:id="typeFilterComboBox"
                          prefWidth="234"
                          minWidth="234"
                          maxWidth="234"
                          styleClass="logs-filter"/>

                <ComboBox fx:id="statusFilterComboBox"
                          prefWidth="234"
                          minWidth="234"
                          maxWidth="234"
                          styleClass="logs-filter"/>

                <MenuButton fx:id="dateFilterMenuButton"
                            text="All dates"
                            prefWidth="193"
                            minWidth="193"
                            maxWidth="193"
                            styleClass="logs-date-filter">

                    <items>
                        <CustomMenuItem hideOnClick="false">
                            <content>
                                <VBox spacing="12" styleClass="logs-date-popover">

                                    <HBox spacing="6" styleClass="logs-date-mode-switch">
                                        <Button fx:id="specificDateModeButton"
                                                text="Specific date"
                                                onAction="#showSpecificDateMode"
                                                styleClass="logs-date-mode-button"
                                                focusTraversable="false"/>

                                        <Button fx:id="rangeDateModeButton"
                                                text="Date range"
                                                onAction="#showRangeDateMode"
                                                styleClass="logs-date-mode-button"
                                                focusTraversable="false"/>
                                    </HBox>

                                    <VBox fx:id="specificDateBox"
                                          spacing="6"
                                          visible="false"
                                          managed="false"
                                          styleClass="logs-date-section">

                                        <Label text="Date" styleClass="logs-date-label"/>

                                        <DatePicker fx:id="specificDatePicker"
                                                    editable="false"
                                                    maxWidth="Infinity"
                                                    styleClass="logs-popover-date-picker"/>
                                    </VBox>

                                    <VBox fx:id="dateRangeBox"
                                          spacing="9"
                                          visible="false"
                                          managed="false"
                                          styleClass="logs-date-section">

                                        <GridPane hgap="9" vgap="6">
                                            <Label text="From"
                                                   GridPane.rowIndex="0"
                                                   GridPane.columnIndex="0"
                                                   styleClass="logs-date-label"/>

                                            <Label text="To"
                                                   GridPane.rowIndex="0"
                                                   GridPane.columnIndex="1"
                                                   styleClass="logs-date-label"/>

                                            <DatePicker fx:id="rangeStartDatePicker"
                                                        editable="false"
                                                        prefWidth="150"
                                                        GridPane.rowIndex="1"
                                                        GridPane.columnIndex="0"
                                                        styleClass="logs-popover-date-picker"/>

                                            <DatePicker fx:id="rangeEndDatePicker"
                                                        editable="false"
                                                        prefWidth="150"
                                                        GridPane.rowIndex="1"
                                                        GridPane.columnIndex="1"
                                                        styleClass="logs-popover-date-picker"/>
                                        </GridPane>
                                    </VBox>

                                    <HBox spacing="9" alignment="CENTER_RIGHT">
                                        <Button text="Clear"
                                                onAction="#clearDateFilter"
                                                styleClass="logs-date-clear-button"
                                                focusTraversable="false"/>

                                        <Button text="Apply"
                                                onAction="#applyDateFilter"
                                                styleClass="logs-date-apply-button"
                                                focusTraversable="false"/>
                                    </HBox>
                                </VBox>
                            </content>
                        </CustomMenuItem>
                    </items>
                </MenuButton>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Reset"
                        onAction="#clearFilters"
                        minWidth="99"
                        prefWidth="99"
                        maxWidth="99"
                        styleClass="logs-reset-button"
                        focusTraversable="false"/>
            </HBox>

            <VBox spacing="0"
                  fillWidth="true"
                  maxWidth="Infinity"
                  styleClass="logs-content">

                <VBox fx:id="timelineContainer"
                      spacing="0"
                      fillWidth="true"
                      maxWidth="Infinity"
                      styleClass="logs-event-stream"
                      VBox.vgrow="ALWAYS"/>
            </VBox>

            <VBox fx:id="emptyStateBox"
                  spacing="9"
                  visible="false"
                  managed="false"
                  maxWidth="Infinity"
                  styleClass="activity-log-empty-state">

                <Label text="No logs found" styleClass="empty-state-title"/>
                <Label text="Try changing filters or searching for a different user, box, profile, or action."
                       styleClass="empty-state-copy"/>

                <Button text="Clear filters"
                        onAction="#clearFilters"
                        styleClass="create-user-button"
                        focusTraversable="false"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
