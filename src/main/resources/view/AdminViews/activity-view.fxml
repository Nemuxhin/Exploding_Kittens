<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CustomMenuItem?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="easv.gui.controller.admin.ActivityController"
            fitToWidth="true"
            fitToHeight="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            minWidth="0"
            minHeight="0"
            maxWidth="Infinity"
            maxHeight="Infinity"
            styleClass="admin-page-scroll">

    <content>
        <VBox fx:id="logsPageRoot"
              spacing="18"
              fillWidth="true"
              minWidth="0"
              minHeight="0"
              maxWidth="Infinity"
              maxHeight="Infinity">

            <styleClass>
                <String fx:value="admin-page"/>
                <String fx:value="main-content"/>
                <String fx:value="activity-log-page"/>
                <String fx:value="logs-page"/>
            </styleClass>

            <padding>
                <Insets top="30" right="24" bottom="24" left="24"/>
            </padding>

            <VBox spacing="3" styleClass="page-heading-copy">
                <Label text="Logs">
                    <styleClass>
                        <String fx:value="page-title"/>
                        <String fx:value="logs-title"/>
                    </styleClass>
                </Label>

                <Label text="TIFF activity, QA, users, imports, exports, and system events">
                    <styleClass>
                        <String fx:value="page-subtitle"/>
                        <String fx:value="logs-subtitle"/>
                    </styleClass>
                </Label>
            </VBox>

            <HBox spacing="12"
                  alignment="CENTER_LEFT"
                  maxWidth="Infinity"
                  styleClass="logs-toolbar">

                <HBox fx:id="searchBox"
                      prefWidth="315"
                      minWidth="255"
                      maxWidth="315"
                      styleClass="logs-search">

                    <StackPane styleClass="field-icon-shell">
                        <Label text="&#xe908;" styleClass="prime-icon field-icon-path"/>
                    </StackPane>

                    <TextField fx:id="searchField"
                               promptText="Search logs, users, actions..."
                               styleClass="search-field-input"
                               maxWidth="Infinity"
                               HBox.hgrow="ALWAYS"/>
                </HBox>
                <HBox fx:id="dateFilterBox"
                      prefWidth="240"
                      minWidth="240"
                      maxWidth="240"
                      alignment="CENTER_LEFT"
                      styleClass="logs-date-filter-box">

                    <StackPane styleClass="logs-date-filter-icon-shell">
                        <Label text="&#xe927;" styleClass="prime-icon logs-date-filter-icon"/>
                    </StackPane>

                    <TextField fx:id="dateFilterField"
                               promptText="MM/DD/YYYY"
                               maxWidth="Infinity"
                               HBox.hgrow="ALWAYS"
                               styleClass="logs-date-filter-input"/>

                    <Button fx:id="dateFilterMenuButton"
                            text="&#xe930;"
                            focusTraversable="false"
                            styleClass="prime-icon logs-date-filter-menu"/>
                </HBox>
                <HBox fx:id="timeFilterBox"
                      prefWidth="135"
                      minWidth="135"
                      maxWidth="135"
                      alignment="CENTER_LEFT"
                      styleClass="logs-time-filter-box">

                    <StackPane styleClass="logs-time-filter-icon-shell">
                        <Label text="&#xe940;" styleClass="prime-icon logs-time-filter-icon"/>
                    </StackPane>

                    <Label fx:id="timeFilterValueLabel"
                           text="All times"
                           maxWidth="Infinity"
                           HBox.hgrow="ALWAYS"
                           styleClass="logs-time-filter-value"/>

                    <Button fx:id="timeFilterMenuButton"
                            text="&#xe930;"
                            focusTraversable="false"
                            styleClass="prime-icon logs-time-filter-menu"/>
                </HBox>

                <MenuButton fx:id="statusMenuButton"
                            prefWidth="150"
                            minWidth="150"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            styleClass="logs-filter"/>

                <MenuButton fx:id="filtersMenuButton"
                            prefWidth="150"
                            minWidth="150"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            styleClass="logs-filter"/>

                <MenuButton fx:id="sortMenuButton"
                            prefWidth="195"
                            minWidth="195"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            styleClass="logs-filter"/>

                <Button text="Clear"
                        onAction="#clearFilters"
                        minWidth="54"
                        prefWidth="54"
                        maxWidth="54"
                        styleClass="logs-clear-button"
                        focusTraversable="false"/>
            </HBox>

            <HBox alignment="CENTER_LEFT"
                  maxWidth="Infinity"
                  styleClass="logs-count-row">
                <Label fx:id="logsShowingLabel"
                       text="Showing 0 events"
                       styleClass="logs-showing-label"/>
            </HBox>

            <VBox spacing="0"
                  fillWidth="true"
                  maxWidth="Infinity"
                  VBox.vgrow="ALWAYS"
                  styleClass="logs-content">

                <VBox fx:id="timelineContainer"
                      spacing="0"
                      fillWidth="true"
                      maxWidth="Infinity"
                      styleClass="logs-event-stream"
                      VBox.vgrow="ALWAYS"/>
            </VBox>

            <VBox fx:id="emptyStateBox"
                  spacing="9"
                  visible="false"
                  managed="false"
                  maxWidth="Infinity"
                  styleClass="activity-log-empty-state">

                <Label text="No logs found" styleClass="empty-state-title"/>
                <Label text="Try changing filters or searching for a different user, box, profile, or action."
                       styleClass="empty-state-copy"/>

                <Button text="Clear filters"
                        onAction="#clearFilters"
                        styleClass="create-user-button"
                        focusTraversable="false"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
