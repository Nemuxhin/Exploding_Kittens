<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="easv.gui.controller.admin.MetadataReviewController"
            fitToWidth="true"
            fitToHeight="false"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            minWidth="0"
            minHeight="0"
            maxWidth="Infinity"
            maxHeight="Infinity"
            styleClass="admin-page-scroll">

    <content>
        <StackPane minWidth="0"
                   maxWidth="Infinity"
                   styleClass="metadata-review-page-host">

            <!-- =====================================================
                 OVERVIEW / WORK QUEUE
                 ===================================================== -->

            <VBox fx:id="overviewPane"
                  spacing="18"
                  fillWidth="true"
                  minWidth="0"
                  maxWidth="Infinity">

                <styleClass>
                    <String fx:value="admin-page"/>
                    <String fx:value="main-content"/>
                    <String fx:value="metadata-review-page"/>
                </styleClass>

                <padding>
                    <Insets top="24" right="24" bottom="24" left="24"/>
                </padding>

                <HBox alignment="CENTER_LEFT"
                      maxWidth="Infinity"
                      styleClass="page-header">

                    <VBox spacing="3" styleClass="page-heading-copy">
                        <Label text="Metadata Review" styleClass="page-title"/>
                        <Label text="Review, complete, and correct metadata for scanned boxes, cases, documents, and pages"
                               styleClass="page-subtitle"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="Export Report"
                            onAction="#exportReport"
                            styleClass="secondary-outline-button"
                            focusTraversable="false"/>
                </HBox>

                <HBox styleClass="metadata-review-search-shell"
                      maxWidth="Infinity">

                    <StackPane styleClass="field-icon-shell">
                        <SVGPath content="M15.78 14.36h-.75l-.26-.25a6.64 6.64 0 1 0-.66.66l.25.26v.75l4.72 4.71 1.41-1.41-4.71-4.72zM9.5 14A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14z"
                                 styleClass="field-icon-path"/>
                    </StackPane>

                    <TextField fx:id="searchField"
                               promptText="Search by Box ID, case number, client, document title, barcode, or profile..."
                               styleClass="search-field-input"
                               maxWidth="Infinity"
                               HBox.hgrow="ALWAYS"/>
                </HBox>

                <GridPane hgap="15"
                          vgap="15"
                          maxWidth="Infinity"
                          styleClass="metadata-review-queue-grid">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <VBox maxWidth="Infinity"
                          minHeight="111"
                          prefHeight="111"
                          spacing="15"
                          onMouseClicked="#showMissingRequiredQueue"
                          onKeyPressed="#showMissingRequiredQueueFromKeyboard"
                          focusTraversable="true"
                          accessibleRole="BUTTON"
                          accessibleText="Show missing required metadata queue"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="0">

                        <styleClass>
                            <String fx:value="metadata-review-queue-card"/>
                            <String fx:value="metadata-review-queue-warning"/>
                        </styleClass>

                        <HBox alignment="CENTER_LEFT">
                            <StackPane>
                                <styleClass>
                                    <String fx:value="metadata-review-card-icon-box"/>
                                    <String fx:value="metadata-review-card-icon-warning-box"/>
                                </styleClass>

                                <SVGPath content="M12 2 1 21h22L12 2zm0 6 1 7h-2l1-7zm-1 9h2v2h-2v-2z"
                                         styleClass="metadata-review-card-icon-warning"/>
                            </StackPane>

                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="142" styleClass="metadata-review-card-count"/>
                        </HBox>

                        <Label text="Missing Required Metadata"
                               styleClass="metadata-review-card-title"/>
                    </VBox>

                    <VBox maxWidth="Infinity"
                          minHeight="111"
                          prefHeight="111"
                          spacing="15"
                          onMouseClicked="#showExportBlockedQueue"
                          onKeyPressed="#showExportBlockedQueueFromKeyboard"
                          focusTraversable="true"
                          accessibleRole="BUTTON"
                          accessibleText="Show export blocked queue"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0">

                        <styleClass>
                            <String fx:value="metadata-review-queue-card"/>
                            <String fx:value="metadata-review-queue-danger"/>
                        </styleClass>

                        <HBox alignment="CENTER_LEFT">
                            <StackPane>
                                <styleClass>
                                    <String fx:value="metadata-review-card-icon-box"/>
                                    <String fx:value="metadata-review-card-icon-danger-box"/>
                                </styleClass>

                                <SVGPath content="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm3.5 12.1-1.4 1.4L12 13.4l-2.1 2.1-1.4-1.4 2.1-2.1-2.1-2.1 1.4-1.4 2.1 2.1 2.1-2.1 1.4 1.4-2.1 2.1 2.1 2.1z"
                                         styleClass="metadata-review-card-icon-danger"/>
                            </StackPane>

                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="9" styleClass="metadata-review-card-count"/>
                        </HBox>

                        <Label text="Export Blocked"
                               styleClass="metadata-review-card-title"/>
                    </VBox>

                    <VBox maxWidth="Infinity"
                          minHeight="111"
                          prefHeight="111"
                          spacing="15"
                          onMouseClicked="#showFailedValidationQueue"
                          onKeyPressed="#showFailedValidationQueueFromKeyboard"
                          focusTraversable="true"
                          accessibleRole="BUTTON"
                          accessibleText="Show failed validation queue"
                          GridPane.columnIndex="2"
                          GridPane.rowIndex="0">

                        <styleClass>
                            <String fx:value="metadata-review-queue-card"/>
                            <String fx:value="metadata-review-queue-danger"/>
                        </styleClass>

                        <HBox alignment="CENTER_LEFT">
                            <StackPane>
                                <styleClass>
                                    <String fx:value="metadata-review-card-icon-box"/>
                                    <String fx:value="metadata-review-card-icon-danger-box"/>
                                </styleClass>

                                <SVGPath content="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm3.5 12.1-1.4 1.4L12 13.4l-2.1 2.1-1.4-1.4 2.1-2.1-2.1-2.1 1.4-1.4 2.1 2.1 2.1-2.1 1.4 1.4-2.1 2.1 2.1 2.1z"
                                         styleClass="metadata-review-card-icon-danger"/>
                            </StackPane>

                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="6" styleClass="metadata-review-card-count"/>
                        </HBox>

                        <Label text="Failed Validation"
                               styleClass="metadata-review-card-title"/>
                    </VBox>

                    <VBox maxWidth="Infinity"
                          minHeight="111"
                          prefHeight="111"
                          spacing="15"
                          onMouseClicked="#showReadyForQaQueue"
                          onKeyPressed="#showReadyForQaQueueFromKeyboard"
                          focusTraversable="true"
                          accessibleRole="BUTTON"
                          accessibleText="Show ready for QA queue"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="1">

                        <styleClass>
                            <String fx:value="metadata-review-queue-card"/>
                            <String fx:value="metadata-review-queue-success"/>
                        </styleClass>

                        <HBox alignment="CENTER_LEFT">
                            <StackPane>
                                <styleClass>
                                    <String fx:value="metadata-review-card-icon-box"/>
                                    <String fx:value="metadata-review-card-icon-success-box"/>
                                </styleClass>

                                <SVGPath content="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"
                                         styleClass="metadata-review-card-icon-success"/>
                            </StackPane>

                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="58" styleClass="metadata-review-card-count"/>
                        </HBox>

                        <Label text="Ready for QA"
                               styleClass="metadata-review-card-title"/>
                    </VBox>

                    <VBox maxWidth="Infinity"
                          minHeight="111"
                          prefHeight="111"
                          spacing="15"
                          onMouseClicked="#showQaRejectedQueue"
                          onKeyPressed="#showQaRejectedQueueFromKeyboard"
                          focusTraversable="true"
                          accessibleRole="BUTTON"
                          accessibleText="Show QA rejected queue"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1">

                        <styleClass>
                            <String fx:value="metadata-review-queue-card"/>
                            <String fx:value="metadata-review-queue-warning"/>
                        </styleClass>

                        <HBox alignment="CENTER_LEFT">
                            <StackPane>
                                <styleClass>
                                    <String fx:value="metadata-review-card-icon-box"/>
                                    <String fx:value="metadata-review-card-icon-warning-box"/>
                                </styleClass>

                                <SVGPath content="M12 2 1 21h22L12 2zm0 6 1 7h-2l1-7zm-1 9h2v2h-2v-2z"
                                         styleClass="metadata-review-card-icon-warning"/>
                            </StackPane>

                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="12" styleClass="metadata-review-card-count"/>
                        </HBox>

                        <Label text="QA Rejected"
                               styleClass="metadata-review-card-title"/>
                    </VBox>

                    <VBox maxWidth="Infinity"
                          minHeight="111"
                          prefHeight="111"
                          spacing="15"
                          onMouseClicked="#showRecentlyScannedQueue"
                          onKeyPressed="#showRecentlyScannedQueueFromKeyboard"
                          focusTraversable="true"
                          accessibleRole="BUTTON"
                          accessibleText="Show recently scanned queue"
                          GridPane.columnIndex="2"
                          GridPane.rowIndex="1">

                        <styleClass>
                            <String fx:value="metadata-review-queue-card"/>
                            <String fx:value="metadata-review-queue-neutral"/>
                        </styleClass>

                        <HBox alignment="CENTER_LEFT">
                            <StackPane>
                                <styleClass>
                                    <String fx:value="metadata-review-card-icon-box"/>
                                    <String fx:value="metadata-review-card-icon-neutral-box"/>
                                </styleClass>

                                <SVGPath content="M12 2a10 10 0 1 0 10 10A10.01 10.01 0 0 0 12 2zm1 11h5v-2h-4V6h-2v7z"
                                         styleClass="metadata-review-card-icon-neutral"/>
                            </StackPane>

                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="241" styleClass="metadata-review-card-count"/>
                        </HBox>

                        <Label text="Recently Scanned"
                               styleClass="metadata-review-card-title"/>
                    </VBox>
                </GridPane>

                <VBox spacing="15"
                      maxWidth="Infinity"
                      styleClass="metadata-review-filter-card">

                    <GridPane hgap="15"
                              vgap="15"
                              maxWidth="Infinity">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <ComboBox fx:id="clientFilterComboBox" maxWidth="Infinity" styleClass="metadata-review-filter" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="archiveFilterComboBox" maxWidth="Infinity" styleClass="metadata-review-filter" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="profileFilterComboBox" maxWidth="Infinity" styleClass="metadata-review-filter" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="metadataStatusFilterComboBox" maxWidth="Infinity" styleClass="metadata-review-filter" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="qaStatusFilterComboBox" maxWidth="Infinity" styleClass="metadata-review-filter" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="dateRangeFilterComboBox" maxWidth="Infinity" styleClass="metadata-review-filter" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="scannedByFilterComboBox" maxWidth="Infinity" styleClass="metadata-review-filter" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    </GridPane>
                </VBox>

                <HBox fx:id="batchActionBar"
                      spacing="12"
                      alignment="CENTER_LEFT"
                      visible="false"
                      managed="false"
                      maxWidth="Infinity"
                      styleClass="metadata-review-batch-bar">

                    <Label fx:id="batchSelectionLabel"
                           text="0 selected"
                           styleClass="metadata-review-batch-label"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="Assign QA" onAction="#assignSelectedToQa" styleClass="profile-secondary-button" focusTraversable="false"/>
                    <Button text="Apply Tag" disable="true" styleClass="profile-secondary-button" focusTraversable="false"/>
                    <Button text="Mark Ready for QA" onAction="#markSelectedReadyForQa" styleClass="profile-secondary-button" focusTraversable="false"/>
                    <Button text="Export Selected" onAction="#exportSelected" styleClass="profile-secondary-button" focusTraversable="false"/>
                    <Button text="Clear Selection" onAction="#clearSelection" styleClass="profile-secondary-button" focusTraversable="false"/>
                </HBox>

                <VBox spacing="0"
                      fillWidth="true"
                      maxWidth="Infinity"
                      styleClass="metadata-review-results-card">

                    <GridPane maxWidth="Infinity"
                              styleClass="metadata-review-table-header">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="4" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="17" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="12" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="10" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="12" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="11" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="10" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="4" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="8" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="7" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                            <ColumnConstraints percentWidth="5" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                        </columnConstraints>

                        <Region GridPane.columnIndex="0"/>

                        <Label text="Box / Case / Document" wrapText="true" maxWidth="Infinity" styleClass="metadata-review-header-label" GridPane.columnIndex="1"/>
                        <Label text="Client" wrapText="true" maxWidth="Infinity" styleClass="metadata-review-header-label" GridPane.columnIndex="2"/>
                        <Label text="Profile" wrapText="true" maxWidth="Infinity" styleClass="metadata-review-header-label" GridPane.columnIndex="3"/>
                        <Label text="Metadata Template" wrapText="true" maxWidth="Infinity" styleClass="metadata-review-header-label" GridPane.columnIndex="4"/>
                        <Label text="Metadata Status" wrapText="true" maxWidth="Infinity" styleClass="metadata-review-header-label" GridPane.columnIndex="5"/>
                        <Label text="QA Status" wrapText="true" maxWidth="Infinity" styleClass="metadata-review-header-label" GridPane.columnIndex="6"/>
                        <Label text="Pages" wrapText="true" maxWidth="Infinity" styleClass="metadata-review-header-label" GridPane.columnIndex="7"/>
                        <Label text="Last Updated" wrapText="true" maxWidth="Infinity" styleClass="metadata-review-header-label" GridPane.columnIndex="8"/>
                        <Label text="Assigned To" wrapText="true" maxWidth="Infinity" styleClass="metadata-review-header-label" GridPane.columnIndex="9"/>
                        <Label text="Actions" wrapText="true" maxWidth="Infinity" styleClass="metadata-review-header-label" GridPane.columnIndex="10"/>
                    </GridPane>

                    <VBox fx:id="resultsRowsContainer"
                          spacing="0"
                          fillWidth="true"
                          maxWidth="Infinity"
                          styleClass="metadata-review-table-body"/>

                    <VBox fx:id="emptyStateBox"
                          spacing="9"
                          visible="false"
                          managed="false"
                          maxWidth="Infinity"
                          styleClass="metadata-review-empty-state">

                        <Label text="No matching metadata records" styleClass="empty-state-title"/>

                        <Label text="Try changing filters or searching for a different box, case, client, or profile."
                               styleClass="empty-state-copy"/>

                        <Button text="Clear Filters"
                                onAction="#clearFilters"
                                styleClass="create-user-button"
                                focusTraversable="false"/>
                    </VBox>

                    <HBox fx:id="paginationBar"
                          alignment="CENTER"
                          spacing="12"
                          visible="false"
                          managed="false"
                          maxWidth="Infinity"
                          styleClass="pagination-bar">

                        <Label fx:id="paginationSummaryLabel"
                               text="Showing 0 records"
                               styleClass="pagination-summary-label"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <HBox fx:id="paginationButtonsBox"
                              alignment="CENTER"
                              spacing="6"
                              styleClass="pagination-buttons-box"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <HBox alignment="CENTER_RIGHT"
                              spacing="9"
                              styleClass="rows-per-page-box">

                            <Label text="Rows per page"
                                   styleClass="rows-per-page-label"/>

                            <ComboBox fx:id="rowsPerPageComboBox"
                                      styleClass="rows-per-page-filter"/>
                        </HBox>
                    </HBox>
                </VBox>
            </VBox>

            <!-- =====================================================
                 REVIEW WORKSPACE
                 ===================================================== -->

            <VBox fx:id="workspacePane"
                  spacing="18"
                  fillWidth="true"
                  minWidth="0"
                  maxWidth="Infinity"
                  visible="false"
                  managed="false">

                <styleClass>
                    <String fx:value="admin-page"/>
                    <String fx:value="main-content"/>
                    <String fx:value="metadata-workspace-page"/>
                </styleClass>

                <padding>
                    <Insets top="24" right="24" bottom="24" left="24"/>
                </padding>

                <VBox spacing="15" maxWidth="Infinity">
                    <HBox alignment="CENTER_LEFT" maxWidth="Infinity">
                        <Button text="← Back"
                                onAction="#showOverview"
                                focusTraversable="false"
                                styleClass="metadata-back-button"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT"
                          maxWidth="Infinity"
                          styleClass="metadata-workspace-header">

                        <VBox spacing="3"
                              minWidth="0"
                              maxWidth="Infinity"
                              HBox.hgrow="ALWAYS">

                            <styleClass>
                                <String fx:value="page-heading-copy"/>
                                <String fx:value="metadata-workspace-title-area"/>
                            </styleClass>

                            <Label fx:id="workspaceTitleLabel"
                                   text="BOX-2026-004 / Case 2026-042 / Document 3"
                                   minWidth="0"
                                   maxWidth="Infinity"
                                   textOverrun="ELLIPSIS"
                                   styleClass="page-title"/>

                            <Label fx:id="workspaceSubtitleLabel"
                                   text="Building Archive · Aalborg Municipality · 12 pages · Missing Required Fields"
                                   minWidth="0"
                                   maxWidth="Infinity"
                                   textOverrun="ELLIPSIS"
                                   styleClass="page-subtitle"/>
                        </VBox>

                        <HBox alignment="CENTER_RIGHT"
                              spacing="12"
                              styleClass="metadata-header-actions">

                            <Button text="Save Metadata"
                                    onAction="#saveMetadata"
                                    focusTraversable="false">
                                <styleClass>
                                    <String fx:value="metadata-secondary-header-button"/>
                                    <String fx:value="metadata-save-button"/>
                                </styleClass>
                            </Button>

                            <Button text="Mark Complete"
                                    onAction="#markComplete"
                                    focusTraversable="false">
                                <styleClass>
                                    <String fx:value="metadata-secondary-header-button"/>
                                    <String fx:value="metadata-complete-button"/>
                                </styleClass>
                            </Button>

                            <Button text="Send to QA"
                                    onAction="#sendToQa"
                                    focusTraversable="false">
                                <styleClass>
                                    <String fx:value="metadata-primary-header-button"/>
                                    <String fx:value="metadata-send-review-button"/>
                                </styleClass>
                            </Button>

                            <Button text="Approve"
                                    onAction="#approveReview"
                                    focusTraversable="false">
                                <styleClass>
                                    <String fx:value="metadata-primary-header-button"/>
                                    <String fx:value="metadata-approve-button"/>
                                </styleClass>
                            </Button>

                            <Button text="Reject"
                                    onAction="#rejectReview"
                                    focusTraversable="false">
                                <styleClass>
                                    <String fx:value="metadata-destructive-header-button"/>
                                    <String fx:value="metadata-reject-button"/>
                                </styleClass>
                            </Button>
                        </HBox>
                    </HBox>
                </VBox>

                <HBox spacing="12"
                      alignment="CENTER_LEFT"
                      maxWidth="Infinity"
                      styleClass="metadata-workspace-warning-banner">

                    <SVGPath content="M12 2 1 21h22L12 2zm0 6 1 7h-2l1-7zm-1 9h2v2h-2v-2z"
                             styleClass="metadata-workspace-warning-icon"/>

                    <Label fx:id="workspaceWarningLabel"
                           text="Export blocked: 2 required metadata fields are missing."
                           styleClass="metadata-workspace-warning-text"/>
                </HBox>

                <HBox spacing="0"
                      alignment="TOP_LEFT"
                      maxWidth="Infinity"
                      styleClass="metadata-workspace-shell">

                    <VBox spacing="15"
                          prefWidth="300"
                          minWidth="270"
                          maxWidth="330"
                          styleClass="metadata-workspace-left-panel">

                        <VBox spacing="3">
                            <Label text="Scan Structure" styleClass="metadata-workspace-panel-title"/>
                            <Label text="Box, case, and document hierarchy"
                                   styleClass="metadata-workspace-panel-subtitle"/>
                        </VBox>

                        <HBox styleClass="search-field-shell"
                              maxWidth="Infinity">

                            <StackPane styleClass="field-icon-shell">
                                <SVGPath content="M15.78 14.36h-.75l-.26-.25a6.64 6.64 0 1 0-.66.66l.25.26v.75l4.72 4.71 1.41-1.41-4.71-4.72zM9.5 14A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14z"
                                         styleClass="field-icon-path"/>
                            </StackPane>

                            <TextField promptText="Search documents..."
                                       styleClass="search-field-input"
                                       maxWidth="Infinity"
                                       HBox.hgrow="ALWAYS"/>
                        </HBox>

                        <VBox spacing="12"
                              maxWidth="Infinity"
                              styleClass="metadata-workspace-tree">

                            <Label text="BOX-2026-004" styleClass="metadata-workspace-tree-root"/>

                            <VBox spacing="6">
                                <Label text="Case 2026-042" styleClass="metadata-workspace-tree-case"/>

                                <HBox alignment="CENTER_LEFT" styleClass="metadata-workspace-tree-row">
                                    <Label text="✓" styleClass="metadata-workspace-tree-status-complete"/>
                                    <Label text="Document 1" styleClass="metadata-workspace-tree-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="complete" styleClass="metadata-workspace-tree-status-text"/>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" styleClass="metadata-workspace-tree-row">
                                    <Label text="!" styleClass="metadata-workspace-tree-status-warning"/>
                                    <Label text="Document 2" styleClass="metadata-workspace-tree-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="missing" styleClass="metadata-workspace-tree-status-text"/>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" styleClass="metadata-workspace-tree-row-active">
                                    <Label text="!" styleClass="metadata-workspace-tree-status-warning"/>
                                    <Label text="Document 3" styleClass="metadata-workspace-tree-title-active"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="missing required" styleClass="metadata-workspace-tree-status-text"/>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" styleClass="metadata-workspace-tree-row">
                                    <Label text="○" styleClass="metadata-workspace-tree-status-neutral"/>
                                    <Label text="Document 4" styleClass="metadata-workspace-tree-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="not started" styleClass="metadata-workspace-tree-status-text"/>
                                </HBox>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Case 2026-043" styleClass="metadata-workspace-tree-case"/>

                                <HBox alignment="CENTER_LEFT" styleClass="metadata-workspace-tree-row">
                                    <Label text="✓" styleClass="metadata-workspace-tree-status-complete"/>
                                    <Label text="Document 1" styleClass="metadata-workspace-tree-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="complete" styleClass="metadata-workspace-tree-status-text"/>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" styleClass="metadata-workspace-tree-row">
                                    <Label text="×" styleClass="metadata-workspace-tree-status-danger"/>
                                    <Label text="Document 2" styleClass="metadata-workspace-tree-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="invalid" styleClass="metadata-workspace-tree-status-text"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </VBox>

                    <VBox spacing="0"
                          minWidth="0"
                          maxWidth="Infinity"
                          HBox.hgrow="ALWAYS"
                          styleClass="metadata-workspace-viewer-panel">

                        <HBox alignment="CENTER_LEFT"
                              styleClass="metadata-workspace-viewer-toolbar">

                            <Label text="Page Viewer" styleClass="metadata-workspace-panel-title"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label text="Page 3 of 12" styleClass="metadata-workspace-viewer-page-label"/>

                            <Button text="−" focusTraversable="false" styleClass="metadata-workspace-tool-button"/>
                            <Button text="+" focusTraversable="false" styleClass="metadata-workspace-tool-button"/>
                            <Button text="Fit" focusTraversable="false" styleClass="metadata-workspace-tool-button"/>
                            <Button text="↶" focusTraversable="false" styleClass="metadata-workspace-tool-button"/>
                            <Button text="↷" focusTraversable="false" styleClass="metadata-workspace-tool-button"/>
                            <Button text="Barcode" focusTraversable="false" styleClass="metadata-workspace-tool-button"/>
                        </HBox>

                        <StackPane minHeight="540"
                                   maxWidth="Infinity"
                                   styleClass="metadata-workspace-viewer-area">

                            <StackPane styleClass="metadata-workspace-paper-preview">
                                <Label text="Document Page 3"
                                       styleClass="metadata-workspace-paper-placeholder"/>
                            </StackPane>
                        </StackPane>

                        <ScrollPane fitToHeight="true"
                                    fitToWidth="false"
                                    hbarPolicy="AS_NEEDED"
                                    vbarPolicy="NEVER"
                                    styleClass="metadata-workspace-thumbnail-scroll">

                            <content>
                                <HBox spacing="9"
                                      styleClass="metadata-workspace-thumbnail-strip">

                                    <StackPane styleClass="metadata-workspace-thumbnail"><Label text="1" styleClass="metadata-workspace-thumbnail-label"/></StackPane>
                                    <StackPane styleClass="metadata-workspace-thumbnail"><Label text="2" styleClass="metadata-workspace-thumbnail-label"/></StackPane>
                                    <StackPane styleClass="metadata-workspace-thumbnail-active"><Label text="3" styleClass="metadata-workspace-thumbnail-label-active"/></StackPane>
                                    <StackPane styleClass="metadata-workspace-thumbnail"><Label text="4" styleClass="metadata-workspace-thumbnail-label"/></StackPane>
                                    <StackPane styleClass="metadata-workspace-thumbnail"><Label text="5" styleClass="metadata-workspace-thumbnail-label"/></StackPane>
                                    <StackPane styleClass="metadata-workspace-thumbnail"><Label text="6" styleClass="metadata-workspace-thumbnail-label"/></StackPane>
                                    <StackPane styleClass="metadata-workspace-thumbnail"><Label text="7" styleClass="metadata-workspace-thumbnail-label"/></StackPane>
                                    <StackPane styleClass="metadata-workspace-thumbnail"><Label text="8" styleClass="metadata-workspace-thumbnail-label"/></StackPane>
                                    <StackPane styleClass="metadata-workspace-thumbnail"><Label text="9" styleClass="metadata-workspace-thumbnail-label"/></StackPane>
                                    <StackPane styleClass="metadata-workspace-thumbnail"><Label text="10" styleClass="metadata-workspace-thumbnail-label"/></StackPane>

                                    <StackPane styleClass="metadata-workspace-thumbnail-barcode">
                                        <VBox spacing="3" alignment="CENTER">
                                            <Label text="11" styleClass="metadata-workspace-thumbnail-label"/>
                                            <Label text="barcode" styleClass="metadata-workspace-thumbnail-note"/>
                                        </VBox>
                                    </StackPane>

                                    <StackPane styleClass="metadata-workspace-thumbnail"><Label text="12" styleClass="metadata-workspace-thumbnail-label"/></StackPane>
                                </HBox>
                            </content>
                        </ScrollPane>
                    </VBox>

                    <VBox spacing="15"
                          prefWidth="330"
                          minWidth="318"
                          maxWidth="360"
                          styleClass="metadata-workspace-right-panel">

                        <VBox spacing="3">
                            <Label text="Metadata" styleClass="metadata-workspace-panel-title"/>
                            <Label text="Review and complete required values"
                                   styleClass="metadata-workspace-panel-subtitle"/>
                        </VBox>

                        <HBox spacing="6" styleClass="metadata-workspace-tabs">
                            <Button fx:id="boxTabButton" text="Box" onAction="#showBoxTab" focusTraversable="false" styleClass="metadata-workspace-tab-button"/>
                            <Button fx:id="caseTabButton" text="Case" onAction="#showCaseTab" focusTraversable="false" styleClass="metadata-workspace-tab-button"/>
                            <Button fx:id="documentTabButton" text="Document" onAction="#showDocumentTab" focusTraversable="false" styleClass="metadata-workspace-tab-active"/>
                            <Button fx:id="pageTabButton" text="Page" onAction="#showPageTab" focusTraversable="false" styleClass="metadata-workspace-tab-button"/>
                        </HBox>

                        <VBox spacing="3" styleClass="metadata-workspace-validation-summary">
                            <Label text="Document Metadata" styleClass="metadata-workspace-validation-title"/>
                            <Label text="2 required fields missing" styleClass="metadata-workspace-validation-copy"/>
                        </VBox>

                        <VBox spacing="12" styleClass="metadata-workspace-form">

                            <VBox spacing="5">
                                <Label text="Document Type *" styleClass="metadata-workspace-field-label"/>
                                <ComboBox fx:id="documentTypeComboBox"
                                          maxWidth="Infinity"
                                          promptText="Select document type"
                                          styleClass="metadata-workspace-input-error"/>
                                <Label text="Document Type is required."
                                       styleClass="metadata-workspace-field-error"/>
                            </VBox>

                            <VBox spacing="5">
                                <Label text="Case Number *" styleClass="metadata-workspace-field-label"/>
                                <TextField fx:id="caseNumberField"
                                           text="2026-042"
                                           styleClass="metadata-workspace-input"/>
                            </VBox>

                            <VBox spacing="5">
                                <Label text="Registration Date" styleClass="metadata-workspace-field-label"/>
                                <TextField fx:id="registrationDateField"
                                           text="Invalid date"
                                           styleClass="metadata-workspace-input-error"/>
                                <Label text="Enter a valid date."
                                       styleClass="metadata-workspace-field-error"/>
                            </VBox>

                            <VBox spacing="5">
                                <Label text="Building Address *" styleClass="metadata-workspace-field-label"/>
                                <TextField fx:id="buildingAddressField"
                                           text="Skagerrakvej 16"
                                           styleClass="metadata-workspace-input"/>
                            </VBox>

                            <VBox spacing="5">
                                <Label text="Department" styleClass="metadata-workspace-field-label"/>
                                <ComboBox fx:id="departmentComboBox"
                                          maxWidth="Infinity"
                                          styleClass="metadata-workspace-input"/>
                            </VBox>

                            <VBox spacing="5">
                                <Label text="Notes" styleClass="metadata-workspace-field-label"/>
                                <TextArea fx:id="notesTextArea"
                                          promptText="Optional notes..."
                                          prefRowCount="3"
                                          wrapText="true"
                                          styleClass="metadata-workspace-textarea"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Tags" styleClass="metadata-workspace-field-label"/>

                                <HBox spacing="6">
                                    <Label text="Archive" styleClass="metadata-workspace-tag"/>
                                    <Label text="Building Permit" styleClass="metadata-workspace-tag"/>
                                    <Label text="Needs Review" styleClass="metadata-workspace-tag-warning"/>
                                </HBox>
                            </VBox>

                            <Region styleClass="metadata-workspace-divider"/>

                            <VBox spacing="6">
                                <Label text="Completion Status" styleClass="metadata-workspace-field-label"/>

                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <Label text="✓" styleClass="metadata-workspace-check-complete"/>
                                    <Label text="Box metadata: Complete" styleClass="metadata-workspace-check-text"/>
                                </HBox>

                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <Label text="✓" styleClass="metadata-workspace-check-complete"/>
                                    <Label text="Case metadata: Complete" styleClass="metadata-workspace-check-text"/>
                                </HBox>

                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <Label text="!" styleClass="metadata-workspace-check-warning"/>
                                    <Label text="Document metadata: Missing 2 required fields" styleClass="metadata-workspace-check-text"/>
                                </HBox>

                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <Label text="○" styleClass="metadata-workspace-check-neutral"/>
                                    <Label text="Page metadata: Optional" styleClass="metadata-workspace-check-text"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <VBox spacing="9" styleClass="metadata-workspace-side-actions">
                            <Button text="Save Metadata"
                                    onAction="#saveMetadata"
                                    focusTraversable="false"
                                    maxWidth="Infinity"
                                    styleClass="metadata-secondary-header-button"/>

                            <Button text="Mark Document Complete"
                                    onAction="#markComplete"
                                    focusTraversable="false"
                                    maxWidth="Infinity"
                                    styleClass="create-user-button"/>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
