<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="easv.gui.controller.Admin.MetadataReviewController"
            fitToWidth="true"
            fitToHeight="false"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            minWidth="0"
            minHeight="0"
            maxWidth="Infinity"
            maxHeight="Infinity"
            styleClass="admin-page-scroll">

    <content>
        <VBox spacing="18"
              fillWidth="true"
              minWidth="0"
              minHeight="0"
              maxWidth="Infinity"
              maxHeight="Infinity"
              styleClass="admin-page main-content metadata-review-page">

            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <HBox alignment="CENTER_LEFT"
                  maxWidth="Infinity"
                  styleClass="page-header">

                <VBox spacing="3" styleClass="page-heading-copy">
                    <Label text="Metadata Review" styleClass="page-title"/>
                    <Label text="Review, complete, and correct metadata for scanned boxes, cases, documents, and pages"
                           styleClass="page-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Export Report"
                        onAction="#exportReport"
                        styleClass="secondary-outline-button"
                        focusTraversable="false"/>
            </HBox>

            <HBox styleClass="metadata-review-search-shell"
                  maxWidth="Infinity">

                <StackPane styleClass="field-icon-shell">
                    <SVGPath content="M15.78 14.36h-.75l-.26-.25a6.64 6.64 0 1 0-.66.66l.25.26v.75l4.72 4.71 1.41-1.41-4.71-4.72zM9.5 14A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14z"
                             styleClass="field-icon-path"/>
                </StackPane>

                <TextField fx:id="searchField"
                           promptText="Search by Box ID, case number, client, document title, barcode, or profile..."
                           styleClass="search-field-input"
                           maxWidth="Infinity"
                           HBox.hgrow="ALWAYS"/>
            </HBox>

            <GridPane hgap="15"
                      vgap="15"
                      maxWidth="Infinity"
                      styleClass="metadata-review-queue-grid">

                <columnConstraints>
                    <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                </columnConstraints>

                <VBox maxWidth="Infinity"
                      minHeight="111"
                      prefHeight="111"
                      spacing="15"
                      onMouseClicked="#showMissingRequiredQueue"
                      style="-fx-padding: 18 21 18 21; -fx-background-color: -wl-surface; -fx-background-radius: 10; -fx-border-color: #FACC15; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 9, 0, 0, 1); -fx-cursor: hand;"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="0">

                    <HBox alignment="CENTER_LEFT">
                        <StackPane styleClass="metadata-review-card-icon-box metadata-review-card-icon-warning-box">
                            <SVGPath content="M12 2 1 21h22L12 2zm0 6 1 7h-2l1-7zm-1 9h2v2h-2v-2z"
                                     styleClass="metadata-review-card-icon-warning"/>
                        </StackPane>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="142" styleClass="metadata-review-card-count"/>
                    </HBox>

                    <Label text="Missing Required Metadata"
                           styleClass="metadata-review-card-title"/>
                </VBox>

                <VBox maxWidth="Infinity"
                      minHeight="111"
                      prefHeight="111"
                      spacing="15"
                      onMouseClicked="#showExportBlockedQueue"
                      style="-fx-padding: 18 21 18 21; -fx-background-color: -wl-surface; -fx-background-radius: 10; -fx-border-color: #FFB4B4; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 9, 0, 0, 1); -fx-cursor: hand;"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="0">

                    <HBox alignment="CENTER_LEFT">
                        <StackPane styleClass="metadata-review-card-icon-box metadata-review-card-icon-danger-box">
                            <SVGPath content="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm3.5 12.1-1.4 1.4L12 13.4l-2.1 2.1-1.4-1.4 2.1-2.1-2.1-2.1 1.4-1.4 2.1 2.1 2.1-2.1 1.4 1.4-2.1 2.1 2.1 2.1z"
                                     styleClass="metadata-review-card-icon-danger"/>
                        </StackPane>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="9" styleClass="metadata-review-card-count"/>
                    </HBox>

                    <Label text="Export Blocked"
                           styleClass="metadata-review-card-title"/>
                </VBox>

                <VBox maxWidth="Infinity"
                      minHeight="111"
                      prefHeight="111"
                      spacing="15"
                      onMouseClicked="#showFailedValidationQueue"
                      style="-fx-padding: 18 21 18 21; -fx-background-color: -wl-surface; -fx-background-radius: 10; -fx-border-color: #FFB4B4; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 9, 0, 0, 1); -fx-cursor: hand;"
                      GridPane.columnIndex="2"
                      GridPane.rowIndex="0">

                    <HBox alignment="CENTER_LEFT">
                        <StackPane styleClass="metadata-review-card-icon-box metadata-review-card-icon-danger-box">
                            <SVGPath content="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm3.5 12.1-1.4 1.4L12 13.4l-2.1 2.1-1.4-1.4 2.1-2.1-2.1-2.1 1.4-1.4 2.1 2.1 2.1-2.1 1.4 1.4-2.1 2.1 2.1 2.1z"
                                     styleClass="metadata-review-card-icon-danger"/>
                        </StackPane>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="6" styleClass="metadata-review-card-count"/>
                    </HBox>

                    <Label text="Failed Validation"
                           styleClass="metadata-review-card-title"/>
                </VBox>

                <VBox maxWidth="Infinity"
                      minHeight="111"
                      prefHeight="111"
                      spacing="15"
                      onMouseClicked="#showReadyForQaQueue"
                      style="-fx-padding: 18 21 18 21; -fx-background-color: -wl-surface; -fx-background-radius: 10; -fx-border-color: #86EFAC; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 9, 0, 0, 1); -fx-cursor: hand;"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="1">

                    <HBox alignment="CENTER_LEFT">
                        <StackPane styleClass="metadata-review-card-icon-box metadata-review-card-icon-success-box">
                            <SVGPath content="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"
                                     styleClass="metadata-review-card-icon-success"/>
                        </StackPane>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="58" styleClass="metadata-review-card-count"/>
                    </HBox>

                    <Label text="Ready for QA"
                           styleClass="metadata-review-card-title"/>
                </VBox>

                <VBox maxWidth="Infinity"
                      minHeight="111"
                      prefHeight="111"
                      spacing="15"
                      onMouseClicked="#showQaRejectedQueue"
                      style="-fx-padding: 18 21 18 21; -fx-background-color: -wl-surface; -fx-background-radius: 10; -fx-border-color: #FACC15; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 9, 0, 0, 1); -fx-cursor: hand;"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="1">

                    <HBox alignment="CENTER_LEFT">
                        <StackPane styleClass="metadata-review-card-icon-box metadata-review-card-icon-warning-box">
                            <SVGPath content="M12 2 1 21h22L12 2zm0 6 1 7h-2l1-7zm-1 9h2v2h-2v-2z"
                                     styleClass="metadata-review-card-icon-warning"/>
                        </StackPane>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="12" styleClass="metadata-review-card-count"/>
                    </HBox>

                    <Label text="QA Rejected"
                           styleClass="metadata-review-card-title"/>
                </VBox>

                <VBox maxWidth="Infinity"
                      minHeight="111"
                      prefHeight="111"
                      spacing="15"
                      onMouseClicked="#showRecentlyScannedQueue"
                      style="-fx-padding: 18 21 18 21; -fx-background-color: -wl-surface; -fx-background-radius: 10; -fx-border-color: -wl-border; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 9, 0, 0, 1); -fx-cursor: hand;"
                      GridPane.columnIndex="2"
                      GridPane.rowIndex="1">

                    <HBox alignment="CENTER_LEFT">
                        <StackPane styleClass="metadata-review-card-icon-box metadata-review-card-icon-neutral-box">
                            <SVGPath content="M12 2a10 10 0 1 0 10 10A10.01 10.01 0 0 0 12 2zm1 11h5v-2h-4V6h-2v7z"
                                     styleClass="metadata-review-card-icon-neutral"/>
                        </StackPane>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="241" styleClass="metadata-review-card-count"/>
                    </HBox>

                    <Label text="Recently Scanned"
                           styleClass="metadata-review-card-title"/>
                </VBox>
            </GridPane>

            <VBox spacing="15"
                  maxWidth="Infinity"
                  styleClass="metadata-review-filter-card">

                <GridPane hgap="15"
                          vgap="15"
                          maxWidth="Infinity">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <ComboBox fx:id="clientFilterComboBox" maxWidth="Infinity" styleClass="metadata-review-filter" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="archiveFilterComboBox" maxWidth="Infinity" styleClass="metadata-review-filter" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="profileFilterComboBox" maxWidth="Infinity" styleClass="metadata-review-filter" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="metadataStatusFilterComboBox" maxWidth="Infinity" styleClass="metadata-review-filter" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <ComboBox fx:id="qaStatusFilterComboBox" maxWidth="Infinity" styleClass="metadata-review-filter" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="dateRangeFilterComboBox" maxWidth="Infinity" styleClass="metadata-review-filter" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="scannedByFilterComboBox" maxWidth="Infinity" styleClass="metadata-review-filter" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                </GridPane>
            </VBox>

            <HBox fx:id="batchActionBar"
                  spacing="12"
                  alignment="CENTER_LEFT"
                  visible="false"
                  managed="false"
                  maxWidth="Infinity"
                  styleClass="metadata-review-batch-bar">

                <Label fx:id="batchSelectionLabel"
                       text="0 selected"
                       styleClass="metadata-review-batch-label"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Assign QA" styleClass="profile-secondary-button" focusTraversable="false"/>
                <Button text="Apply Tag" styleClass="profile-secondary-button" focusTraversable="false"/>
                <Button text="Mark Ready for QA" styleClass="profile-secondary-button" focusTraversable="false"/>
                <Button text="Export Selected" styleClass="profile-secondary-button" focusTraversable="false"/>
                <Button text="Clear Selection" onAction="#clearSelection" styleClass="profile-secondary-button" focusTraversable="false"/>
            </HBox>

            <VBox spacing="0"
                  fillWidth="true"
                  maxWidth="Infinity"
                  styleClass="metadata-review-results-card">

                <GridPane maxWidth="Infinity"
                          styleClass="metadata-review-table-header">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="4" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                        <ColumnConstraints percentWidth="17" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                        <ColumnConstraints percentWidth="12" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                        <ColumnConstraints percentWidth="10" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                        <ColumnConstraints percentWidth="12" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                        <ColumnConstraints percentWidth="11" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                        <ColumnConstraints percentWidth="10" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                        <ColumnConstraints percentWidth="4" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                        <ColumnConstraints percentWidth="8" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                        <ColumnConstraints percentWidth="7" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                        <ColumnConstraints percentWidth="5" minWidth="0" hgrow="ALWAYS" fillWidth="true"/>
                    </columnConstraints>

                    <Region GridPane.columnIndex="0"/>

                    <Label text="Box / Case / Document" wrapText="true" maxWidth="Infinity" styleClass="metadata-review-header-label" GridPane.columnIndex="1"/>
                    <Label text="Client" wrapText="true" maxWidth="Infinity" styleClass="metadata-review-header-label" GridPane.columnIndex="2"/>
                    <Label text="Profile" wrapText="true" maxWidth="Infinity" styleClass="metadata-review-header-label" GridPane.columnIndex="3"/>
                    <Label text="Metadata Template" wrapText="true" maxWidth="Infinity" styleClass="metadata-review-header-label" GridPane.columnIndex="4"/>
                    <Label text="Metadata Status" wrapText="true" maxWidth="Infinity" styleClass="metadata-review-header-label" GridPane.columnIndex="5"/>
                    <Label text="QA Status" wrapText="true" maxWidth="Infinity" styleClass="metadata-review-header-label" GridPane.columnIndex="6"/>
                    <Label text="Pages" wrapText="true" maxWidth="Infinity" styleClass="metadata-review-header-label" GridPane.columnIndex="7"/>
                    <Label text="Last Updated" wrapText="true" maxWidth="Infinity" styleClass="metadata-review-header-label" GridPane.columnIndex="8"/>
                    <Label text="Assigned To" wrapText="true" maxWidth="Infinity" styleClass="metadata-review-header-label" GridPane.columnIndex="9"/>
                    <Label text="Actions" wrapText="true" maxWidth="Infinity" styleClass="metadata-review-header-label" GridPane.columnIndex="10"/>
                </GridPane>

                <VBox fx:id="resultsRowsContainer"
                      spacing="0"
                      fillWidth="true"
                      maxWidth="Infinity"
                      styleClass="metadata-review-table-body"/>

                <VBox fx:id="emptyStateBox"
                      spacing="9"
                      visible="false"
                      managed="false"
                      maxWidth="Infinity"
                      styleClass="metadata-review-empty-state">

                    <Label text="No matching metadata records" styleClass="empty-state-title"/>

                    <Label text="Try changing filters or searching for a different box, case, client, or profile."
                           styleClass="empty-state-copy"/>

                    <Button text="Clear Filters"
                            onAction="#clearFilters"
                            styleClass="create-user-button"
                            focusTraversable="false"/>
                </VBox>

                <HBox fx:id="paginationBar"
                      alignment="CENTER"
                      spacing="12"
                      visible="false"
                      managed="false"
                      maxWidth="Infinity"
                      styleClass="pagination-bar">

                    <Label fx:id="paginationSummaryLabel"
                           text="Showing 0 records"
                           styleClass="pagination-summary-label"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox fx:id="paginationButtonsBox"
                          alignment="CENTER"
                          spacing="6"
                          styleClass="pagination-buttons-box"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox alignment="CENTER_RIGHT"
                          spacing="9"
                          styleClass="rows-per-page-box">

                        <Label text="Rows per page"
                               styleClass="rows-per-page-label"/>

                        <ComboBox fx:id="rowsPerPageComboBox"
                                  styleClass="rows-per-page-filter"/>
                    </HBox>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>