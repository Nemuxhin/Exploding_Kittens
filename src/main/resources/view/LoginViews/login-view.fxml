<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="easv.gui.controller.LoginController">
    <children>
        <HBox alignment="CENTER" spacing="28.0" styleClass="login-shell">
            <children>
                <VBox alignment="CENTER_LEFT" spacing="14.0" styleClass="brand-panel">
                    <children>
                        <Label styleClass="eyebrow-label" text="WEBLAGER" />
                        <Label styleClass="page-title" text="Simple Login Screen" />
                        <Label styleClass="body-text"
                               text="Use one of the stored accounts to enter the system. The app will remember who is logged in for the next actions." />
                        <Label styleClass="helper-text" text="Default demo accounts are created automatically the first time the app starts." wrapText="true" />
                    </children>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <VBox alignment="CENTER_LEFT" spacing="12.0" styleClass="login-card" maxWidth="320.0">
                    <children>
                        <Label styleClass="card-title" text="Sign In" />
                        <Label styleClass="field-label" text="Username" />
                        <TextField fx:id="usernameField" promptText="Enter username" />
                        <Label styleClass="field-label" text="Password" />
                        <PasswordField fx:id="passwordField" promptText="Enter password" onAction="#handleLogin" />
                        <Button maxWidth="1.7976931348623157E308" onAction="#handleLogin" styleClass="primary-button" text="Log In" />
                        <Label fx:id="messageLabel" styleClass="message-label" text="Use admin / admin123 to test the first login." wrapText="true" />
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
            </padding>
        </HBox>
    </children>
</StackPane>
