<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="easv.gui.controller.user.ScanController"
           minWidth="0"
           minHeight="0"
           maxWidth="Infinity"
           maxHeight="Infinity"
           styleClass="scan-page">
    <!-- =========================================================
         SETUP VIEW
         ========================================================= -->

    <VBox fx:id="scanSetupView"
          alignment="TOP_CENTER"
          fillWidth="true"
          minWidth="0"
          minHeight="0"
          maxWidth="Infinity"
          maxHeight="Infinity"
          styleClass="scan-setup-view">

        <VBox spacing="18"
              alignment="TOP_LEFT"
              fillWidth="true"
              prefWidth="1110"
              maxWidth="1110"
              styleClass="scan-setup-content">

            <!-- Header -->
            <VBox spacing="6"
                  alignment="CENTER_LEFT">
                <Label text="New Scan"
                       styleClass="page-title"/>

                <Label text="Choose a profile and box before scanning."
                       styleClass="page-subtitle"/>
            </VBox>

            <!-- Main layout -->
            <HBox spacing="18"
                  alignment="TOP_LEFT"
                  fillHeight="false"
                  maxWidth="Infinity"
                  styleClass="scan-setup-main-row">

                <!-- Quick helper card -->
                <VBox spacing="18"
                      alignment="TOP_LEFT"
                      minWidth="270"
                      prefWidth="270"
                      maxWidth="270"
                      styleClass="scan-setup-quick-card">

                    <VBox spacing="6">
                        <Label text="Quick start"
                               styleClass="scan-setup-quick-title"/>

                        <Label text="Set the profile, enter the box ID, then start scanning."
                               wrapText="true"
                               styleClass="scan-setup-quick-copy"/>
                    </VBox>

                    <VBox spacing="9">
                        <HBox spacing="12"
                              alignment="TOP_LEFT"
                              styleClass="scan-setup-quick-item">
                            <Label text="1"
                                   styleClass="scan-setup-step-number"/>

                            <VBox spacing="3">
                                <Label text="Select profile"
                                       styleClass="scan-setup-step-title"/>

                                <Label text="Uses your assigned scan rules."
                                       wrapText="true"
                                       styleClass="scan-setup-step-copy"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="12"
                              alignment="TOP_LEFT"
                              styleClass="scan-setup-quick-item">
                            <Label text="2"
                                   styleClass="scan-setup-step-number"/>

                            <VBox spacing="3">
                                <Label text="Enter box ID"
                                       styleClass="scan-setup-step-title"/>

                                <Label text="Use the archive box identifier."
                                       wrapText="true"
                                       styleClass="scan-setup-step-copy"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="12"
                              alignment="TOP_LEFT"
                              styleClass="scan-setup-quick-item">
                            <Label text="3"
                                   styleClass="scan-setup-step-number"/>

                            <VBox spacing="3">
                                <Label text="Start scanning"
                                       styleClass="scan-setup-step-title"/>

                                <Label text="Review, split, reorder, and submit after scan."
                                       wrapText="true"
                                       styleClass="scan-setup-step-copy"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Main scan setup card -->
                <VBox spacing="24"
                      alignment="TOP_LEFT"
                      HBox.hgrow="ALWAYS"
                      maxWidth="Infinity"
                      styleClass="scan-setup-primary-card">

                    <VBox spacing="3">
                        <Label text="Scan setup"
                               styleClass="scan-setup-primary-title"/>

                        <Label text="Complete the required fields below to begin the scanning session."
                               wrapText="true"
                               styleClass="scan-setup-primary-copy"/>
                    </VBox>

                    <VBox spacing="18"
                          maxWidth="Infinity">

                        <!-- Profile -->
                        <VBox spacing="6"
                              maxWidth="Infinity">
                            <HBox alignment="CENTER_LEFT"
                                  maxWidth="Infinity">
                                <Label text="Profile"
                                       styleClass="form-label"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Button fx:id="profileInfoButton"
                                        text="Profile Info"
                                        focusTraversable="false"
                                        styleClass="profile-info-link-button"/>
                            </HBox>

                            <ComboBox fx:id="profileComboBox"
                                      promptText="Select profile"
                                      maxWidth="Infinity"
                                      styleClass="weblager-combo-box"/>

                            <Label text="Only profiles assigned to you are shown."
                                   styleClass="helper-text"/>
                        </VBox>

                        <!-- Profile info panel -->
                        <VBox fx:id="profileInfoPanel"
                              spacing="9"
                              visible="false"
                              managed="false"
                              maxWidth="Infinity"
                              styleClass="profile-info-panel">

                            <Label fx:id="profileInfoTitleLabel"
                                   text="No profile selected"
                                   styleClass="profile-info-title"/>

                            <Label fx:id="profileInfoMetadataLabel"
                                   text="Metadata required: ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â"
                                   styleClass="profile-info-line"/>

                            <Label fx:id="profileInfoQaLabel"
                                   text="QA required: ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â"
                                   styleClass="profile-info-line"/>

                            <Label fx:id="profileInfoSplittingLabel"
                                   text="Splitting method: ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â"
                                   styleClass="profile-info-line"/>
                        </VBox>

                        <!-- Box ID -->
                        <VBox spacing="6"
                              maxWidth="Infinity">
                            <Label text="Box ID"
                                   styleClass="form-label"/>

                            <TextField fx:id="boxIdTextField"
                                       promptText="Enter box ID"
                                       maxWidth="Infinity"
                                       styleClass="weblager-text-field"/>
                        </VBox>

                        <!-- Actions -->
                        <HBox spacing="15"
                              alignment="CENTER_LEFT"
                              maxWidth="Infinity">
                            <Button fx:id="startScanningButton"
                                    text="Start Scanning"
                                    onAction="#onStartScanning"
                                    maxWidth="Infinity"
                                    HBox.hgrow="ALWAYS"
                                    styleClass="primary-button"/>

                            <Button fx:id="viewMyScansButton"
                                    text="View My Scans"
                                    onAction="#onViewMyScans"
                                    minWidth="180"
                                    prefWidth="180"
                                    maxWidth="180"
                                    styleClass="tertiary-button"/>
                        </HBox>

                        <!-- Calm utility line -->
                        <HBox spacing="9"
                              alignment="CENTER_LEFT"
                              maxWidth="Infinity"
                              styleClass="scan-setup-meta-row">
                            <Label text="Assigned profiles only"
                                   styleClass="scan-setup-meta-pill"/>

                            <Label text="Review and submit after scanning"
                                   styleClass="scan-setup-meta-pill"/>
                        </HBox>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </VBox>

    <!-- =========================================================
         SCAN WORKSPACE VIEW
         ========================================================= -->

    <BorderPane fx:id="scanWorkspaceView"
                visible="false"
                managed="false"
                minWidth="0"
                minHeight="0"
                maxWidth="Infinity"
                maxHeight="Infinity"
                styleClass="scan-workspace">

        <!-- Top session header -->
        <top>
            <BorderPane minWidth="0"
                        maxWidth="Infinity"
                        styleClass="scan-session-header">
                <padding>
                    <Insets top="12" right="18" bottom="12" left="18"/>
                </padding>
                <left>
                    <VBox spacing="9"
                          alignment="CENTER_LEFT"
                          minWidth="285"
                          prefWidth="285"
                          maxWidth="285"
                          style="-fx-padding: 0 15 0 15;">
                        <Label fx:id="workspaceSessionTitleLabel"
                               text="Scanning Session"
                               styleClass="workspace-title"/>
                        <Label fx:id="workspaceSessionSubtitleLabel"
                               visible="false"
                               managed="false"
                               text="0 files scanned - 0 documents created - 0 pending pages"
                               styleClass="workspace-subtitle"/>
                        <Button text="Scan Next File"
                                onAction="#onScanNextFile"
                                maxWidth="Infinity"
                                prefHeight="33"
                                styleClass="scan-primary-action-button"/>
                    </VBox>
                </left>
                <center>
                    <HBox spacing="9"
                          alignment="CENTER"
                          BorderPane.alignment="CENTER">
                    <Label fx:id="headerReferenceInfoLabel"
                           text="Ref: -"
                           styleClass="scan-session-info-chip"/>
                    <Label fx:id="headerFilesInfoLabel"
                           text="Scanned Files: 0"
                           styleClass="scan-session-info-chip"/>
                    <Label fx:id="headerDocumentsInfoLabel"
                           text="Documents: 0"
                           styleClass="scan-session-info-chip"/>
                </HBox>
                </center>
                <right>
                    <VBox alignment="TOP_LEFT"
                          spacing="9"
                          minWidth="285"
                          prefWidth="285"
                          maxWidth="285"
                          translateX="18"
                          style="-fx-padding: 0 15 0 15;"
                          BorderPane.alignment="TOP_RIGHT">
                        <Region minHeight="0"
                                prefHeight="0"
                                maxHeight="0"/>
                    </VBox>
                </right>
            </BorderPane>
        </top>

        <!-- Left document structure -->
        <left>
            <VBox spacing="15"
                  minWidth="320"
                  prefWidth="320"
                  maxWidth="320"
                  minHeight="0"
                  maxHeight="Infinity"
                  styleClass="scan-left-panel">

                <VBox spacing="3">
                    <HBox alignment="CENTER_LEFT"
                          spacing="9"
                          maxWidth="Infinity">
                        <Label text="Box Structure"
                               styleClass="scan-panel-title"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button fx:id="documentTreeGridViewButton"
                                text="⧉"
                                onAction="#onShowDocumentTreeGridView"
                                focusTraversable="false"
                                styleClass="document-tree-view-toggle-button"/>

                        <Button fx:id="documentTreeListViewButton"
                                text="☰"
                                onAction="#onShowDocumentTreeListView"
                                focusTraversable="false"
                                styleClass="document-tree-view-toggle-button"/>
                    </HBox>

                    <Label fx:id="boxStructureSubtitleLabel"
                           text="No profile &#183; No box ID"
                           styleClass="scan-panel-subtitle"/>
                </VBox>

                <ScrollPane fx:id="documentTreeScrollPane"
                            fitToWidth="true"
                            fitToHeight="false"
                            hbarPolicy="NEVER"
                            vbarPolicy="ALWAYS"
                            pannable="true"
                            minHeight="0"
                            maxHeight="Infinity"
                            VBox.vgrow="ALWAYS"
                            styleClass="document-tree-scroll">
                    <VBox fx:id="documentTreeContainer"
                          spacing="9"
                          minWidth="0"
                          maxWidth="Infinity"
                          styleClass="document-tree-container"/>
                </ScrollPane>
            </VBox>
        </left>

        <!-- Center scan workspace -->
        <center>
            <BorderPane minWidth="0"
                        minHeight="0"
                        maxWidth="Infinity"
                        maxHeight="Infinity"
                        styleClass="scan-center-panel">

                <!-- Selected file header -->
                <top>
                    <VBox minWidth="0"
                          maxWidth="Infinity">

                        <Pane visible="false"
                              managed="false"
                              minHeight="0"
                              prefHeight="0"
                              maxHeight="0">
                            <children>
                                <Label fx:id="selectedFileTitleLabel"
                                       text="No file selected"
                                       styleClass="selected-file-title"/>
                                <Label fx:id="selectedFileRefLabel"
                                       text="Scan a file to begin."
                                       styleClass="selected-file-subtitle"/>
                            </children>
                        </Pane>

                        <!-- View toolbar -->
                        <HBox spacing="12"
                              alignment="CENTER_LEFT"
                              minHeight="51"
                              prefHeight="51"
                              maxHeight="51"
                              styleClass="scan-view-toolbar">
                            <padding>
                                <Insets top="0" right="18" bottom="0" left="18"/>
                            </padding>

                            <Label text="View"
                                   styleClass="view-toolbar-label"/>

                            <Button text="&#8722;"
                                    onAction="#onZoomOut"
                                    styleClass="view-tool-button"/>

                            <Label fx:id="previewZoomLabel"
                                   text="100%"
                                   minWidth="54"
                                   alignment="CENTER"
                                   styleClass="view-zoom-label"/>

                            <Button text="+"
                                    onAction="#onZoomIn"
                                    styleClass="view-tool-button"/>

                            <Region styleClass="view-toolbar-divider"/>

                            <Button text="&#8593;"
                                    onAction="#onNudgePreviewUp"
                                    styleClass="view-tool-button"/>

                            <Button text="&#8592;"
                                    onAction="#onNudgePreviewLeft"
                                    styleClass="view-tool-button"/>

                            <Label text="Move"
                                   styleClass="view-toolbar-muted-label"/>

                            <Button text="&#8594;"
                                    onAction="#onNudgePreviewRight"
                                    styleClass="view-tool-button"/>

                            <Button text="&#8595;"
                                    onAction="#onNudgePreviewDown"
                                    styleClass="view-tool-button"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button text="Reset View"
                                    onAction="#onResetPreviewView"
                                    styleClass="view-reset-button"/>
                        </HBox>
                    </VBox>
                </top>

                <!-- Preview stage -->
                <center>
                    <StackPane minWidth="0"
                               minHeight="0"
                               maxWidth="Infinity"
                               maxHeight="Infinity"
                               styleClass="scan-preview-stage">

                        <HBox spacing="18"
                              alignment="CENTER"
                              minWidth="0"
                              minHeight="0"
                              maxWidth="Infinity"
                              maxHeight="Infinity">

                            <Button text="&#8249;"
                                    onAction="#onPreviousFile"
                                    styleClass="preview-arrow-button"/>

                            <StackPane fx:id="previewHost"
                                       minWidth="0"
                                       minHeight="0"
                                       maxWidth="Infinity"
                                       maxHeight="Infinity"
                                       HBox.hgrow="ALWAYS"
                                       styleClass="preview-host"/>

                            <Button text="&#8250;"
                                    onAction="#onNextFile"
                                    styleClass="preview-arrow-button"/>
                        </HBox>
                    </StackPane>
                </center>

                <!-- Page tray -->
                <bottom>
                    <VBox spacing="0"
                          visible="false"
                          managed="false"
                          minHeight="0"
                          prefHeight="0"
                          maxHeight="0"
                          opacity="0"
                          styleClass="page-tray-shell">

                        <HBox visible="false"
                              managed="false"
                              alignment="CENTER_LEFT"
                              minHeight="0"
                              prefHeight="0"
                              maxHeight="0">
                            <Label fx:id="pageTrayTitleLabel"
                                    text="Scanned Files"
                                    styleClass="page-tray-title"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="totalFilesLabel"
                                   text="0 files"
                                   styleClass="page-tray-count"/>
                        </HBox>

                        <ScrollPane fitToHeight="true"
                                    fitToWidth="false"
                                    hbarPolicy="AS_NEEDED"
                                    vbarPolicy="NEVER"
                                    minHeight="144"
                                    prefHeight="144"
                                    maxHeight="144"
                                    styleClass="page-tray-scroll">
                            <HBox fx:id="pageTrayContainer"
                                  spacing="9"
                                  minHeight="111"
                                  maxHeight="111"
                                  styleClass="page-tray-container"/>
                        </ScrollPane>
                    </VBox>
                </bottom>
            </BorderPane>
        </center>

        <!-- Right tools -->
        <right>
            <VBox spacing="15"
                  minWidth="285"
                  prefWidth="285"
                  maxWidth="285"
                  minHeight="0"
                  maxHeight="Infinity"
                  styleClass="scan-tools-panel">

                <Label text="Tools"
                       styleClass="scan-panel-title"/>

                <VBox spacing="9">
                    <Label text="Page Tools"
                           styleClass="scan-tools-section-label"/>

                    <Label text="Default Box Rotation"
                           styleClass="scan-tools-section-label"/>

                    <ComboBox fx:id="boxRotationComboBox"
                              maxWidth="Infinity"
                              promptText="Select default rotation"
                              styleClass="scan-tool-button"/>

                    <Label text="Automatically applied to all pages/files scanned in this box session."
                           wrapText="true"
                           styleClass="helper-text"/>

                    <Button text="Rotate Left (90°)"
                            fx:id="rotateLeftButton"
                            onAction="#onRotateLeft"
                            maxWidth="Infinity"
                            styleClass="scan-tool-button"/>

                    <Button text="Rotate Right (90°)"
                            fx:id="rotateRightButton"
                            onAction="#onRotateRight"
                            maxWidth="Infinity"
                            styleClass="scan-tool-button"/>

                    <Button text="Delete Page"
                            onAction="#onDeleteSelectedPage"
                            maxWidth="Infinity"
                            styleClass="scan-danger-button"/>

                    <Button text="Mark for Rescan"
                            onAction="#onToggleRescanSelected"
                            maxWidth="Infinity"
                            styleClass="scan-warning-button"/>

                    <Button text="Rescan Marked Pages"
                            onAction="#onRescanMarkedPages"
                            maxWidth="Infinity"
                            styleClass="scan-tool-button"/>
                </VBox>

                <Region styleClass="scan-panel-divider"/>

                <VBox spacing="9">
                    <Label text="Split Documents Manually"
                           styleClass="scan-tools-section-label"/>

                    <Button text="Split Here"
                            onAction="#onSplitHere"
                            maxWidth="Infinity"
                            styleClass="scan-tool-button"/>
                </VBox>

                <VBox spacing="9"
                      styleClass="scan-workflow-box">
                    <Label text="Workflow"
                           styleClass="scan-tools-section-label"/>

                    <Button fx:id="undoLastActionButton"
                            text="Undo Last Action"
                            onAction="#onUndoLastAction"
                            maxWidth="Infinity"
                            styleClass="scan-tool-button"/>

                    <Button text="Finish &amp; Review"
                            onAction="#onFinishReview"
                            maxWidth="Infinity"
                            styleClass="scan-finish-button"/>
                </VBox>
            </VBox>
        </right>
    </BorderPane>

    <!-- =========================================================
         REVIEW WORKSPACE VIEW
         ========================================================= -->

    <BorderPane fx:id="reviewWorkspaceView"
                visible="false"
                managed="false"
                minWidth="0"
                minHeight="0"
                maxWidth="Infinity"
                maxHeight="Infinity"
                styleClass="scan-review-workspace">

        <top>
            <VBox spacing="3"
                  alignment="CENTER_LEFT"
                  minWidth="0"
                  minHeight="72"
                  prefHeight="72"
                  maxHeight="72"
                  maxWidth="Infinity"
                  styleClass="review-summary-bar">
                <padding>
                    <Insets top="6" right="18" bottom="6" left="18"/>
                </padding>

                <Label text="Scan Review"
                       translateY="10"
                       mouseTransparent="true"
                       styleClass="review-summary-title"/>

                <Button text="Back"
                        onAction="#onBackToScanningFromReview"
                        translateY="10"
                        styleClass="scan-back-button"/>

                <HBox spacing="9"
                      alignment="CENTER"
                      translateY="-24"
                      mouseTransparent="true"
                      maxWidth="Infinity">
                    <Label fx:id="reviewReferenceInfoLabel"
                           text="Ref: -"
                           styleClass="scan-session-info-chip"/>

                    <Label fx:id="reviewFilesInfoLabel"
                           text="Scanned Files: 0"
                           styleClass="scan-session-info-chip"/>

                    <Label fx:id="reviewDocumentsInfoLabel"
                           text="Documents: 0"
                           styleClass="scan-session-info-chip"/>
                </HBox>

                <HBox spacing="18"
                      alignment="CENTER_LEFT"
                      visible="false"
                      managed="false">
                    <Label text="Box"
                           styleClass="review-summary-label"/>

                    <Label fx:id="reviewBoxValueLabel"
                           text="ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â"
                           styleClass="review-summary-value"/>

                    <Label text="Profile"
                           styleClass="review-summary-label"/>

                    <Label fx:id="reviewProfileValueLabel"
                           text="ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â"
                           styleClass="review-summary-value"/>

                    <Label text="Documents"
                           styleClass="review-summary-label"/>

                    <Label fx:id="reviewDocumentsValueLabel"
                           text="ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â"
                           styleClass="review-summary-value"/>
                </HBox>
            </VBox>
        </top>

        <left>
            <VBox spacing="15"
                  minWidth="320"
                  prefWidth="320"
                  maxWidth="320"
                  minHeight="0"
                  maxHeight="Infinity"
                  styleClass="review-left-panel">

                <HBox alignment="CENTER_LEFT"
                      spacing="9"
                      maxWidth="Infinity">
                    <Label text="Box Structure"
                           styleClass="review-panel-title"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button fx:id="reviewDocumentGridViewButton"
                            text="⧉"
                            onAction="#onShowReviewDocumentGridView"
                            focusTraversable="false"
                            styleClass="document-tree-view-toggle-button"/>

                    <Button fx:id="reviewDocumentListViewButton"
                            text="☰"
                            onAction="#onShowReviewDocumentListView"
                            focusTraversable="false"
                            styleClass="document-tree-view-toggle-button"/>
                </HBox>

                <Label fx:id="reviewSidebarSubtitleLabel"
                       text="Profile - Box"
