    <!-- =========================================================
         FINISH REVIEW MODAL
         ========================================================= -->

    <StackPane fx:id="finishReviewOverlay"
               visible="false"
               managed="false"
               minWidth="0"
               minHeight="0"
               maxWidth="Infinity"
               maxHeight="Infinity"
               styleClass="finish-review-overlay">

        <VBox spacing="15"
              maxWidth="432"
              prefWidth="432"
              maxHeight="-Infinity"
              styleClass="finish-review-modal">

            <HBox spacing="12"
                  alignment="CENTER_LEFT">
                <StackPane styleClass="finish-review-success-icon">
                    <Region styleClass="finish-review-success-check"/>
                </StackPane>

                <Label text="Scanning Complete"
                       styleClass="finish-review-title"/>
            </HBox>

            <VBox spacing="9"
                  styleClass="finish-review-summary-card">
                <Label fx:id="finishReviewBoxIdLabel"
                       text="Box ID"
                       styleClass="finish-review-box-id"/>

                <Label fx:id="finishReviewProfileLabel"
                       text="Profile"
                       styleClass="finish-review-summary-muted"/>

                <HBox spacing="24"
                      alignment="CENTER_LEFT">
                    <Label fx:id="finishReviewDocumentsLabel"
                           text="0 documents created"
                           styleClass="finish-review-summary-muted"/>

                    <Label fx:id="finishReviewPagesLabel"
                           text="0 pages scanned"
                           styleClass="finish-review-summary-muted"/>
