                        <Region styleClass="finish-review-button-icon"/>
                        <Label text="Review Scan"
                               styleClass="finish-review-button-label"/>
                    </HBox>
                </graphic>
            </Button>

            <Button text="Submit for QA"
                    onAction="#onSubmitForQaFromFinishModal"
                    maxWidth="Infinity"
                    styleClass="finish-review-primary-button"/>

            <Button text="Back to Scanning"
                    onAction="#onBackToScanningFromFinishModal"
                    maxWidth="Infinity"
                    styleClass="finish-review-secondary-button"/>

            <Button text="Cancel"
                    onAction="#onBackToScanningFromFinishModal"
                    maxWidth="Infinity"
                    styleClass="finish-review-secondary-button"/>
        </VBox>
    </StackPane>

    <!-- =========================================================
