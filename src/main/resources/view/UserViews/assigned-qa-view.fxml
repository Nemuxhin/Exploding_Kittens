<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="easv.gui.controller.user.AssignedQaController"
           alignment="TOP_LEFT"
           minWidth="0"
           minHeight="0"
           maxWidth="Infinity"
           maxHeight="Infinity"
           styleClass="assigned-qa-page">

    <!-- =========================================================
         ASSIGNED QA LIST VIEW
         ========================================================= -->

    <ScrollPane fx:id="assignedQaListView"
                fitToWidth="true"
                fitToHeight="false"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                pannable="true"
                minWidth="0"
                minHeight="0"
                maxWidth="Infinity"
                maxHeight="Infinity"
                styleClass="assigned-qa-scroll">

        <content>
            <VBox spacing="24"
                  alignment="TOP_LEFT"
                  minWidth="0"
                  maxWidth="Infinity"
                  fillWidth="true"
                  styleClass="assigned-qa-content">

                <padding>
                    <Insets top="30" right="30" bottom="30" left="30"/>
                </padding>

                <!-- =========================================================
                     LIST HEADER
                     ========================================================= -->

                <HBox alignment="TOP_LEFT"
                      spacing="0"
                      maxWidth="Infinity"
                      styleClass="assigned-qa-header-row">

                    <VBox spacing="6"
                          alignment="TOP_LEFT"
                          HBox.hgrow="ALWAYS"
                          maxWidth="Infinity"
                          styleClass="assigned-qa-header">

                        <Label text="QA Review"
                               styleClass="assigned-qa-title"/>

                        <Label text="Review scan sessions assigned to you."
                               styleClass="assigned-qa-subtitle"/>
                    </VBox>
                </HBox>

                <!-- =========================================================
                     LIST FILTERS
                     ========================================================= -->

                <HBox fx:id="assignedQaFilterPanel"
                      spacing="18"
                      alignment="CENTER_LEFT"
                      maxWidth="Infinity"
                      styleClass="exports-filter-panel">

                    <VBox spacing="6"
                          HBox.hgrow="ALWAYS"
                          styleClass="exports-filter-wrap">
                        <Label text="Search"
                               styleClass="exports-filter-label"/>
                        <TextField fx:id="searchField"
                                   promptText="Search by box, profile, or status"
                                   maxWidth="Infinity"
                                   styleClass="exports-filter-input"/>
                    </VBox>

                    <VBox spacing="6"
                          styleClass="exports-filter-wrap">
                        <Label text="Status"
                               styleClass="exports-filter-label"/>
                        <ComboBox fx:id="statusFilterComboBox"
                                  prefWidth="240"
                                  minWidth="240"
                                  maxWidth="240"
                                  styleClass="exports-status-filter"/>
                    </VBox>

                    <VBox spacing="6"
                          minWidth="240"
                          prefWidth="240"
                          maxWidth="240"
                          styleClass="exports-filter-wrap">
                        <Label text="Period"
                               styleClass="exports-filter-label"/>

                        <HBox fx:id="dateRangeBox"
                              minWidth="240"
                              prefWidth="240"
                              maxWidth="240"
                              alignment="CENTER_LEFT"
                              styleClass="assigned-qa-date-filter-box">

                            <StackPane styleClass="assigned-qa-date-filter-icon-shell">
                                <Label text="&#xe927;" styleClass="prime-icon assigned-qa-date-filter-icon"/>
                            </StackPane>

                            <TextField fx:id="dateRangeField"
                                       promptText="MM/DD/YYYY"
                                       maxWidth="Infinity"
                                       HBox.hgrow="ALWAYS"
                                       styleClass="assigned-qa-date-filter-input"/>

                            <Button fx:id="dateRangeMenuButton"
                                    focusTraversable="false"
                                    styleClass="assigned-qa-date-filter-menu"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- =========================================================
                     LIST CARDS
                     ========================================================= -->

                <TilePane fx:id="qaCardListContainer"
                          hgap="16"
                          vgap="16"
                          prefColumns="4"
                          prefTileWidth="280"
                          prefTileHeight="350"
                          maxWidth="Infinity"
                          styleClass="assigned-qa-card-list"/>
            </VBox>
        </content>
    </ScrollPane>

    <!-- =========================================================
         QA REVIEW WORKSPACE VIEW
         ========================================================= -->

    <BorderPane fx:id="qaReviewWorkspaceView"
                visible="false"
                managed="false"
                minWidth="0"
                minHeight="0"
                maxWidth="Infinity"
                maxHeight="Infinity"
                styleClass="qa-review-workspace">

        <!-- =========================================================
             QA REVIEW HEADER
             ========================================================= -->

        <top>
            <BorderPane minWidth="0"
                        maxWidth="Infinity"
                        styleClass="qa-review-header">

                <padding>
                    <Insets top="12" right="18" bottom="12" left="18"/>
                </padding>

                <left>
                    <VBox spacing="6"
                          alignment="CENTER_LEFT"
                          minWidth="285"
                          prefWidth="285"
                          maxWidth="285"
                          style="-fx-padding: 0 15 0 15;">
                        <Label text="QA Review"
                               styleClass="qa-review-title"/>

                        <Button text="Back"
                                onAction="#onBackToAssignedQaList"
                                focusTraversable="false"
                                styleClass="scan-back-button"/>
                    </VBox>
                </left>

                <center>
                    <HBox spacing="9"
                          alignment="CENTER"
                          BorderPane.alignment="CENTER">
                        <Label fx:id="qaBoxIdLabel"
                               text="BOX-2026-007"
                               styleClass="scan-session-info-chip"/>

                        <Label fx:id="qaProfileLabel"
                               text="Building Archive"
                               styleClass="scan-session-info-chip"/>

                        <Label fx:id="qaProgressLabel"
                               text="0 / 0 pages reviewed"
                               styleClass="scan-session-info-chip"/>
                    </HBox>
                </center>

                <right>
                    <HBox alignment="CENTER_RIGHT"
                          minWidth="285"
                          prefWidth="285"
                          maxWidth="285"
                          style="-fx-padding: 0 15 0 15;"
                          BorderPane.alignment="CENTER_RIGHT">
                        <Label fx:id="reviewStatusBadge"
                               text="In Review"
                               styleClass="qa-review-status-badge qa-review-status-review"/>
                    </HBox>
                </right>
            </BorderPane>
        </top>

        <!-- =========================================================
             QA REVIEW BODY
             ========================================================= -->

        <center>
            <HBox spacing="0"
                  minWidth="0"
                  minHeight="0"
                  maxWidth="Infinity"
                  maxHeight="Infinity">

                <!-- =====================================================
                     LEFT DOCUMENTS PANEL
                     ===================================================== -->

                <VBox spacing="9"
                      prefWidth="320"
                      minWidth="320"
                      maxWidth="320"
                      minHeight="0"
                      maxHeight="Infinity"
                      styleClass="qa-review-left-panel">

                    <HBox alignment="CENTER_LEFT"
                          spacing="9"
                          maxWidth="Infinity">
                        <Label text="Box Structure"
                               styleClass="qa-review-panel-title"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button fx:id="qaDocumentGridViewButton"
                                text="⧉"
                                onAction="#onShowQaDocumentGridView"
                                focusTraversable="false"
                                styleClass="document-tree-view-toggle-button"/>

                        <Button fx:id="qaDocumentListViewButton"
                                text="☰"
                                onAction="#onShowQaDocumentListView"
                                focusTraversable="false"
                                styleClass="document-tree-view-toggle-button"/>
                    </HBox>

                    <ScrollPane fitToWidth="true"
                                fitToHeight="false"
                                hbarPolicy="NEVER"
                                vbarPolicy="AS_NEEDED"
                                pannable="true"
                                VBox.vgrow="ALWAYS"
                                minHeight="0"
                                maxHeight="Infinity"
                                styleClass="document-tree-scroll">

                        <content>
                            <VBox fx:id="qaDocumentTreeContainer"
                                  spacing="9"
                                  minWidth="0"
                                  maxWidth="Infinity"
                                  styleClass="document-tree-container"/>
                        </content>
                    </ScrollPane>
                </VBox>

                <!-- =====================================================
                     CENTER PREVIEW AND PAGE TRAY
                     ===================================================== -->

                <VBox minWidth="0"
                      minHeight="0"
                      maxWidth="Infinity"
                      maxHeight="Infinity"
                      HBox.hgrow="ALWAYS"
                      styleClass="qa-review-center-panel">

                    <HBox alignment="CENTER_LEFT"
                          spacing="9"
                          minHeight="66"
                          prefHeight="66"
                          maxHeight="66"
                          styleClass="qa-review-current-file-header">

                        <padding>
                            <Insets top="9" right="18" bottom="9" left="18"/>
                        </padding>

                        <VBox spacing="3"
                              minWidth="0">
                            <Label fx:id="selectedQaPageTitleLabel"
                                   text="No page selected"
                                   styleClass="selected-file-title"/>

                            <Label fx:id="selectedQaPageSubtitleLabel"
                                   text="Select a page to review."
                                   styleClass="selected-file-subtitle"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <HBox alignment="CENTER_RIGHT"
                              spacing="9"
                              styleClass="qa-view-toolbar">

                            <Label text="View"
                                   styleClass="qa-view-label"/>

                            <Button text="-"
                                    onAction="#onZoomOut"
                                    focusTraversable="false"
                                    styleClass="qa-view-icon-button"/>

                            <Label fx:id="zoomPercentLabel"
                                   text="100%"
                                   minWidth="54"
                                   alignment="CENTER"
                                   styleClass="qa-zoom-label"/>

                            <Button text="+"
                                    onAction="#onZoomIn"
                                    focusTraversable="false"
                                    styleClass="qa-view-icon-button"/>

                            <Button text="Reset View"
                                    onAction="#onResetView"
                                    focusTraversable="false"
                                    styleClass="qa-view-reset-button"/>
                        </HBox>
                    </HBox>

                    <StackPane minWidth="0"
                               minHeight="0"
                               maxWidth="Infinity"
                               maxHeight="Infinity"
                               VBox.vgrow="ALWAYS"
                               styleClass="qa-preview-stage">

                        <HBox spacing="18"
                              alignment="CENTER"
                              minWidth="0"
                              minHeight="0"
                              maxWidth="Infinity"
                              maxHeight="Infinity">

                            <Button text="&#x2039;"
                                    onAction="#onPreviousPage"
                                    focusTraversable="false"
                                    styleClass="preview-arrow-button"/>

                            <StackPane fx:id="qaPreviewHost"
                                       alignment="CENTER"
                                       minWidth="0"
                                       minHeight="0"
                                       maxWidth="Infinity"
                                       maxHeight="Infinity"
                                       HBox.hgrow="ALWAYS"
                                       styleClass="preview-host"/>

                            <Button text="&#x203A;"
                                    onAction="#onNextPage"
                                    focusTraversable="false"
                                    styleClass="preview-arrow-button"/>
                        </HBox>
                    </StackPane>

                    <VBox spacing="6"
                          visible="false"
                          managed="false"
                          minHeight="0"
                          prefHeight="0"
                          maxHeight="0"
                          opacity="0"
                          maxWidth="Infinity"
                          styleClass="page-tray-shell">

                        <HBox alignment="CENTER_LEFT">
                            <Label text="Page Tray"
                                   styleClass="page-tray-title"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="qaTrayCountLabel"
                                   text="0 pages"
                                   styleClass="page-tray-count"/>
                        </HBox>

                        <ScrollPane fitToHeight="true"
                                    fitToWidth="false"
                                    hbarPolicy="AS_NEEDED"
                                    vbarPolicy="NEVER"
                                    pannable="true"
                                    minHeight="81"
                                    prefHeight="81"
                                    maxHeight="81"
                                    minWidth="0"
                                    maxWidth="Infinity"
                                    styleClass="page-tray-scroll">

                            <content>
                                <HBox fx:id="qaPageTrayContainer"
                                      spacing="9"
                                      alignment="CENTER_LEFT"
                                      minHeight="75"
                                      minWidth="0"
                                      styleClass="page-tray-container"/>
                            </content>
                        </ScrollPane>
                    </VBox>
                </VBox>

                <!-- =====================================================
      RIGHT QA TOOLS PANEL
      ===================================================== -->

                <VBox spacing="12"
                      prefWidth="240"
                      minWidth="240"
                      maxWidth="240"
                      minHeight="0"
                      maxHeight="Infinity"
                      styleClass="qa-tools-panel">

                    <VBox spacing="9"
                          VBox.vgrow="ALWAYS"
                          minWidth="0"
                          minHeight="0"
                          maxWidth="Infinity"
                          maxHeight="Infinity"
                          fillWidth="true"
                          styleClass="qa-tools-content">

                        <!-- Comment -->
                        <VBox spacing="4"
                              maxWidth="Infinity"
                              styleClass="qa-tools-section-box">

                            <Label text="Comment"
                                   styleClass="qa-tools-section-title"/>

                            <TextArea fx:id="qaCommentTextArea"
                                      promptText="Add QA note for this page..."
                                      wrapText="true"
                                      prefRowCount="6"
                                      VBox.vgrow="ALWAYS"
                                      maxWidth="Infinity"
                                      styleClass="qa-comment-textarea"/>
                        </VBox>

                        <Region styleClass="scan-panel-divider"/>

                        <!-- Decision actions -->
                        <VBox spacing="9"
                              maxWidth="Infinity">

                            <VBox spacing="9"
                                  maxWidth="Infinity"
                                  styleClass="qa-tools-section-box">
                                <Label text="Apply To"
                                       styleClass="qa-tools-section-title"/>

                                <ComboBox fx:id="qaActionScopeComboBox"
                                          maxWidth="Infinity"
                                          styleClass="scan-tool-button"/>
                            </VBox>

                            <Button text="Approve Page"
                                    onAction="#onApprovePage"
                                    maxWidth="Infinity"
                                    focusTraversable="false"
                                    styleClass="qa-approve-button"/>

                            <Button text="Mark Needs Fix"
                                    onAction="#onMarkNeedsFix"
                                    maxWidth="Infinity"
                                    focusTraversable="false"
                                    styleClass="qa-fix-button"/>

                            <Button text="Clear Review Status"
                                    onAction="#onClearReviewStatus"
                                    maxWidth="Infinity"
                                    focusTraversable="false"
                                    styleClass="qa-neutral-button"/>
                        </VBox>

                        <Region styleClass="scan-panel-divider"/>

                        <!-- Fast navigation -->
                        <Button text="Next Unreviewed"
                                onAction="#onNextUnreviewed"
                                maxWidth="Infinity"
                                focusTraversable="false"
                                styleClass="qa-neutral-button"/>

                        <Region styleClass="scan-panel-divider"/>

                        <!-- Page utility actions -->
                        <VBox spacing="9"
                              maxWidth="Infinity">
                            <Label text="Rotation"
                                   styleClass="qa-tools-section-title"/>

                            <ComboBox fx:id="qaRotationComboBox"
                                      maxWidth="Infinity"
                                      promptText="Enter rotation in degrees"
                                      styleClass="scan-tool-button"/>

                            <Button text="Rotate Left (1°)"
                                    fx:id="qaRotateLeftButton"
                                    onAction="#onRotateLeft"
                                    maxWidth="Infinity"
                                    visible="false"
                                    managed="false"
                                    focusTraversable="false"
                                    styleClass="qa-neutral-button"/>

                            <Button text="Rotate Right (1°)"
                                    fx:id="qaRotateRightButton"
                                    onAction="#onRotateRight"
                                    maxWidth="Infinity"
                                    visible="false"
                                    managed="false"
                                    focusTraversable="false"
                                    styleClass="qa-neutral-button"/>
                        </VBox>

                        <Button text="Complete QA"
                                onAction="#onCompleteQa"
                                maxWidth="Infinity"
                                focusTraversable="false"
                                styleClass="qa-complete-button"/>

                        <Button text="Export Type"
                                onAction="#onOpenExportTypeDialog"
                                maxWidth="Infinity"
                                focusTraversable="false"
                                styleClass="qa-export-type-button"/>
                    </VBox>
                </VBox>
            </HBox>
        </center>
    </BorderPane>
</StackPane>
