<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane fx:id="appRoot"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="easv.gui.controller.user.UserController"
            stylesheets="@/css/app.css"
            maxWidth="Infinity"
            maxHeight="Infinity">

    <styleClass>
        <String fx:value="app-shell"/>
        <String fx:value="user-portal-shell"/>
    </styleClass>

    <top>
        <VBox styleClass="admin-shell-head">
            <HBox alignment="CENTER_LEFT"
                  spacing="18"
                  styleClass="admin-top-bar">

                <HBox alignment="CENTER_LEFT"
                      spacing="12"
                      styleClass="admin-brand">
                    <StackPane fx:id="brandMark" styleClass="admin-brand-mark">
                        <SVGPath content="M4 4h8.8L20 11.2V20H4V4zm2 2v12h12v-5.8L11.8 6H6zm3 3h3v2H9V9zm0 4h6v2H9v-2z"
                                 styleClass="admin-brand-icon"/>
                    </StackPane>

                    <VBox spacing="2">
                        <StackPane alignment="CENTER_LEFT">
                            <Label fx:id="brandLogoFallbackLabel"
                                   text="WebLager"
                                   styleClass="admin-brand-title"/>

                            <ImageView fx:id="brandLogoImageView"
                                       fitWidth="150"
                                       fitHeight="30"
                                       preserveRatio="true"
                                       smooth="true"
                                       visible="false"
                                       managed="false"/>
                        </StackPane>

                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER"
                      spacing="8"
                      styleClass="admin-nav-bar">
                    <ToggleButton fx:id="dashboardNavItem"
                                  focusTraversable="false"
                                  contentDisplay="GRAPHIC_ONLY">
                        <styleClass>
                            <String fx:value="admin-top-nav-button"/>
                        </styleClass>
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <SVGPath content="M3 3h8v8H3V3zm2 2v4h4V5H5zm8-2h8v8h-8V3zm2 2v4h4V5h-4zM3 13h8v8H3v-8zm2 2v4h4v-4H5zm8-2h8v8h-8v-8zm2 2v4h4v-4h-4z"
                                         styleClass="admin-top-nav-icon"/>
                                <Label text="Dashboard" styleClass="admin-top-nav-label"/>
                            </HBox>
                        </graphic>
                    </ToggleButton>

                    <ToggleButton fx:id="scanNavItem"
                                  focusTraversable="false"
                                  contentDisplay="GRAPHIC_ONLY">
                        <styleClass>
                            <String fx:value="admin-top-nav-button"/>
                        </styleClass>
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <SVGPath content="M4 4h5v2H6v3H4V4zm11 0h5v5h-2V6h-3V4zM4 15h2v3h3v2H4v-5zm14 0h2v5h-5v-2h3v-3zM11 8h2v3h3v2h-3v3h-2v-3H8v-2h3V8z"
                                         styleClass="admin-top-nav-icon"/>
                                <Label text="New Scan" styleClass="admin-top-nav-label"/>
                            </HBox>
                        </graphic>
                    </ToggleButton>

                    <ToggleButton fx:id="myScansNavItem"
                                  focusTraversable="false"
                                  contentDisplay="GRAPHIC_ONLY">
                        <styleClass>
                            <String fx:value="admin-top-nav-button"/>
                        </styleClass>
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <SVGPath content="M6 2h10l4 4v12H6V2zm2 2v12h10V7h-3V4H8zM4 6h2v14h12v2H4V6zm6 4h6v2h-6v-2zm0 4h5v2h-5v-2z"
                                         styleClass="admin-top-nav-icon"/>
                                <Label text="My Scans" styleClass="admin-top-nav-label"/>
                            </HBox>
                        </graphic>
                    </ToggleButton>

                    <ToggleButton fx:id="assignedQANavItem"
                                  focusTraversable="false"
                                  contentDisplay="GRAPHIC_ONLY">
                        <styleClass>
                            <String fx:value="admin-top-nav-button"/>
                        </styleClass>
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <SVGPath content="M8 3h2.2a2 2 0 0 1 3.6 0H16v3H8V3zM6 5H4v16h16V5h-2v2H6V5zm3.3 10.7-2.1-2.1L5.8 15l3.5 3.5 7-7-1.4-1.4-5.6 5.6z"
                                         styleClass="admin-top-nav-icon"/>
                                <Label text="Assigned QA" styleClass="admin-top-nav-label"/>
                            </HBox>
                        </graphic>
                    </ToggleButton>

                    <ToggleButton fx:id="exportsNavItem"
                                  focusTraversable="false"
                                  contentDisplay="GRAPHIC_ONLY">
                        <styleClass>
                            <String fx:value="admin-top-nav-button"/>
                        </styleClass>
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <SVGPath content="M11 3h2v8h3l-4 4-4-4h3V3zM5 14h2v4h10v-4h2v6H5v-6z"
                                         styleClass="admin-top-nav-icon"/>
                                <Label text="Exports" styleClass="admin-top-nav-label"/>
                            </HBox>
                        </graphic>
                    </ToggleButton>

                    <ToggleButton fx:id="helpNavItem"
                                  focusTraversable="false"
                                  contentDisplay="GRAPHIC_ONLY">
                        <styleClass>
                            <String fx:value="admin-top-nav-button"/>
                        </styleClass>
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <SVGPath content="M10 2a8 8 0 100 16 8 8 0 000-16zm0 12h1v1H9v-1h1zm2.1-6.8c0 1.8-2.1 2.1-2.1 3.8H8.5c0-2.4 1.9-2.5 1.9-3.8 0-.7-.6-1.2-1.4-1.2-.8 0-1.4.4-1.8 1.2L6 6.6C6.6 5.3 7.8 4.5 9.4 4.5c1.7 0 2.7 1 2.7 2.7z"
                                         styleClass="admin-top-nav-icon"/>
                                <Label text="Help" styleClass="admin-top-nav-label"/>
                            </HBox>
                        </graphic>
                    </ToggleButton>

                    <ToggleButton fx:id="settingsNavItem"
                                  focusTraversable="false"
                                  contentDisplay="GRAPHIC_ONLY">
                        <styleClass>
                            <String fx:value="admin-top-nav-button"/>
                        </styleClass>
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <SVGPath content="M9 2h2l.5 2.1 1.9.8 1.8-1 1.4 1.4-1 1.8.8 1.9L18 9v2l-2.1.5-.8 1.9 1 1.8-1.4 1.4-1.8-1-.9 1.9L11 18H9l-.5-2.1-1.9-.8-1.8 1L3.4 14.7l1-1.8L3.6 11 2 10V8l2.1-.5.8-1.9-1-1.8L5.3 2.4l1.8 1 .9-1.9z M10 7a3 3 0 100 6 3 3 0 000-6z"
                                         styleClass="admin-top-nav-icon"/>
                                <Label text="Settings" styleClass="admin-top-nav-label"/>
                            </HBox>
                        </graphic>
                    </ToggleButton>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER_RIGHT"
                      spacing="12"
                      styleClass="admin-account">
                    <ToggleButton fx:id="darkModeToggleButton"
                                  focusTraversable="false"
                                  contentDisplay="GRAPHIC_ONLY">
                        <styleClass>
                            <String fx:value="admin-toolbar-button"/>
                        </styleClass>
                        <graphic>
                            <SVGPath fx:id="darkModeToggleIcon"
                                     content="M12 5.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zm0 2a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9zM11 1h2v3h-2V1zm0 19h2v3h-2v-3zM1 11h3v2H1v-2zm19 0h3v2h-3v-2zM4.22 2.81l2.12 2.12-1.41 1.41L2.81 4.22l1.41-1.41zm14.85 14.85 2.12 2.12-1.41 1.41-2.12-2.12 1.41-1.41zM19.78 2.81l1.41 1.41-2.12 2.12-1.41-1.41 2.12-2.12zM4.93 17.66l1.41 1.41-2.12 2.12-1.41-1.41 2.12-2.12z"
                                     styleClass="admin-toolbar-icon"/>
                        </graphic>
                    </ToggleButton>

                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label fx:id="accountNameLabel"
                               text="John Doe"
                               styleClass="admin-account-name"/>
                        <Label fx:id="accountRoleLabel"
                               text="User Portal"
                               visible="false"
                               managed="false"
                               styleClass="admin-account-role"/>
                    </VBox>

                    <StackPane styleClass="admin-avatar-shell">
                        <Label fx:id="avatarInitialsLabel"
                               text="JD"
                               styleClass="admin-avatar-label"/>
                    </StackPane>
                </HBox>
            </HBox>

        </VBox>
    </top>

    <center>
        <StackPane fx:id="contentHost"
                   minWidth="0"
                   minHeight="0"
                   maxWidth="Infinity"
                   maxHeight="Infinity"
                   styleClass="content-host"/>
    </center>

</BorderPane>
