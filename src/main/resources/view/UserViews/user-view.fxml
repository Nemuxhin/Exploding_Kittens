<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane fx:id="appRoot"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="easv.gui.controller.user.UserController"
            stylesheets="@/css/app.css"
            styleClass="app-shell"
            maxWidth="Infinity"
            maxHeight="Infinity">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="18"
              styleClass="top-nav-bar"
              maxWidth="Infinity">

            <padding>
                <Insets top="9" right="18" bottom="9" left="18"/>
            </padding>

            <StackPane alignment="CENTER_LEFT" styleClass="top-brand-row">
                <Label fx:id="brandLogoFallbackLabel"
                        text="WebLager"
                        styleClass="user-brand-title"/>

                <ImageView fx:id="brandLogoImageView"
                           fitWidth="150"
                           fitHeight="30"
                           preserveRatio="true"
                           smooth="true"
                           visible="false"
                           managed="false"/>
            </StackPane>

            <ToggleButton fx:id="scanNavItem"
                          text="New Scan"
                          focusTraversable="false"
                          styleClass="top-nav-item-active"/>

            <ToggleButton fx:id="myScansNavItem"
                          text="My Scans"
                          focusTraversable="false"
                          styleClass="top-nav-item"/>

            <ToggleButton fx:id="assignedQANavItem"
                          text="Assigned QA"
                          focusTraversable="false"
                          styleClass="top-nav-item"/>

            <ToggleButton fx:id="exportsNavItem"
                          text="Exports"
                          focusTraversable="false"
                          styleClass="top-nav-item"/>

            <ToggleButton fx:id="settingsNavItem"
                          text="Settings"
                          focusTraversable="false"
                          styleClass="top-nav-item"/>

            <Region HBox.hgrow="ALWAYS"/>

            <StackPane styleClass="top-help-icon">
                <Label text="?" styleClass="top-help-label"/>
            </StackPane>

            <ToggleButton fx:id="darkModeToggleButton"
                          focusTraversable="false"
                          contentDisplay="GRAPHIC_ONLY"
                          styleClass="top-icon-toggle">
                <graphic>
                    <StackPane>
                        <SVGPath fx:id="darkModeToggleIcon"
                                 content="M12 5.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zm0 2a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9zM11 1h2v3h-2V1zm0 19h2v3h-2v-3zM1 11h3v2H1v-2zm19 0h3v2h-3v-2zM4.22 2.81l2.12 2.12-1.41 1.41L2.81 4.22l1.41-1.41zm14.85 14.85 2.12 2.12-1.41 1.41-2.12-2.12 1.41-1.41zM19.78 2.81l1.41 1.41-2.12 2.12-1.41-1.41 2.12-2.12zM4.93 17.66l1.41 1.41-2.12 2.12-1.41-1.41 2.12-2.12z"
                                 styleClass="top-icon-toggle-svg"/>
                    </StackPane>
                </graphic>
            </ToggleButton>

            <StackPane styleClass="avatar-initials">
                <Label text="JD" styleClass="avatar-initials-text"/>
            </StackPane>

            <Label text="John Doe" styleClass="top-user-name"/>

            <SVGPath content="M7 10l5 5 5-5z"
                     styleClass="top-user-chevron"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentHost"
                   minWidth="0"
                   minHeight="0"
                   maxWidth="Infinity"
                   maxHeight="Infinity"
                   styleClass="content-host"/>
    </center>

</BorderPane>